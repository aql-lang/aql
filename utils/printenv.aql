# ============================================================================
# printenv — print the environment, or the value of named variables.
#
#   printenv [-0|--null]
#   printenv [-0|--null] NAME…
#
# With no operand, every variable is printed as NAME=value, one per line.
# With operands, only those variables' values are printed, in the order named.
#
# Exit codes:
#   0  no operand, or every named variable was set
#   1  at least one named variable was not set (nothing is printed for it,
#      and the remaining names are still printed) — the coreutils contract
#   2  usage error — unknown flag (from Cli.dispatch)
#
# WHY THIS PROGRAM EXISTS. It is the only witness in the suite for the All()
# half of the environment capability: every other use of the environment in
# this repository reads ONE variable by name (IO.env "COLUMNS", IO.env
# "NO_COLOR"). `env VAR=x cmd` would test subprocess spawning, not this. So
# `printenv` with no operand is the acceptance test for IO.env-all, and it is
# here for that reason as much as for being a coreutils classic.
#
# DIVERGENCE FROM GNU, deliberate: the no-operand listing is sorted by name.
# GNU prints in `environ` order, which is the order the OS happened to hand
# over — not reproducible, and not something a test can assert. AQL's
# IO.env-all returns a Map, whose iteration order is its own business, so
# there is no "original order" to preserve even in principle. Sorting makes
# the output a function of the environment alone, which is what makes the
# suite able to pin it.
#
# Structure, as everywhere here: pure fns take their input as parameters
# (pe-bool / pe-sep / pe-line / pe-listing / pe-lookup / pe-named), and
# pe-main takes ARGV and the ENVIRONMENT as parameters and returns the exit
# code rather than exiting — which is what lets tests/printenv_test.aql drive
# the whole program against a synthetic environment, without the suite's own
# environment leaking into the assertions.
# ============================================================================

import "aql:cli"
import "aql:io"

# ----------------------------------------------------------------------------
# Pure helpers.
# ----------------------------------------------------------------------------

# An absent flag, or one holding something that is not a Boolean, reads false.
def pe-bool fn [[fl:Map k:String] [Boolean] [
  def v (fl get k)
  if (v is Boolean) [v] [false]
]]

# -0 separates records with NUL instead of a newline, so a value containing a
# newline survives the round trip through `xargs -0`.
def pe-sep fn [[nul:Boolean] [String] [ if nul ["\u0000"] ["\n"] ]]

# One NAME=value record, terminator included.
def pe-line fn [[k:String v:String sep:String] [String] [ join "" [k "=" v sep] ]]

# The whole environment as one string, sorted by name (see the header).
def pe-listing-at fn [[ks:List i:Integer env:Map sep:String out:List] [List] [
  if (i gte (size ks)) [out] [
    def k (convert String (ks get i))
    def _p (push (pe-line k (convert String (env get k)) sep) out)
    def r (pe-listing-at ks (i add 1) env sep out)
    r
  ]
]]

def pe-listing fn [[env:Map sep:String] [String] [
  def out (flex [])
  def parts (pe-listing-at (sort (keys env)) 0 env sep out)
  def r (join "" parts)
  r
]]

# One named variable: {found value}. An unset variable is None, which is a
# value here rather than an error — it becomes the exit code, not a raise.
def pe-lookup fn [[env:Map k:String] [Map] [
  def v (env get k)
  if (v is None) [{found:false value:""}] [
    def r ({found:true} set (quote value) (convert String v))
    r
  ]
]]

# The named-variable form: {text code}. Every name is looked up — a missing
# one does not stop the walk, it only sets the code, exactly as GNU does.
def pe-named-at fn [[names:List i:Integer env:Map sep:String out:List acc:Integer] [Map] [
  if (i gte (size names)) [({} set (quote text) (join "" out) set (quote code) acc)] [
    def hit (pe-lookup env (convert String (names get i)))
    def code (if (hit.found) [acc] [1])
    def _p (if (hit.found) [(push (join "" [(hit.value) sep]) out)] [none])
    def r (pe-named-at names (i add 1) env sep out code)
    r
  ]
]]

def pe-named fn [[names:List env:Map sep:String] [Map] [
  def out (flex [])
  def r (pe-named-at names 0 env sep out 0)
  r
]]

# ----------------------------------------------------------------------------
# The spec.
# ----------------------------------------------------------------------------
def spec {
  name:    "printenv"
  version: "0.1.0"
  summary: "print the environment, or the value of named variables"
  flags: [
    {name:"null" short:"0" kind:"bool"
     help:"end each record with NUL rather than a newline"}
  ]
  args: {name:"name" min:0 help:"variables to print; none means the whole environment"}
}

# ----------------------------------------------------------------------------
# The program. The environment comes IN as a parameter — the same decision
# design/CLI-PROGRAMS.1.md §3 records for Cli.usage's width and colour, and
# for the same reason: a fn that reads the environment cannot be tested
# against an environment other than the one it is running in.
# ----------------------------------------------------------------------------
def pe-run fn [[ctx:Map env:Map] [Integer] [
  def sep (pe-sep (pe-bool (ctx.flags) "null"))
  def names (ctx.args)
  if ((size names) eq 0) [
    (IO.write (IO.stdout) (pe-listing env sep)) drop
    0
  ] [
    def res (pe-named names env sep)
    (IO.write (IO.stdout) (res.text)) drop
    def c (res.code)
    c
  ]
]]

def pe-main fn [[argv:List env:Map] [Integer] [
  def d (Cli.dispatch (spec) argv)
  def _out (if ((d.out) neq "") [(IO.write (IO.stdout) (d.out))] [none])
  def _err (if ((d.err) neq "") [(IO.write (IO.stderr) (d.err))] [none])
  def code (if ((d.action) neq "run") [(d.code)] [(pe-run d env)])
  code
]]

export "Printenv" {
  bool:    pe-bool/r
  sep:     pe-sep/r
  line:    pe-line/r
  listing: pe-listing/r
  lookup:  pe-lookup/r
  named:   pe-named/r
  main:    pe-main/r
  spec:    spec
}

# ----------------------------------------------------------------------------
# The standalone guard. See cat.aql for the full argument; the short version
# is that `import "./printenv.aql"` RUNS this file's top level, and the
# IO.exit below would end the importing suite before a case had run.
#
# printenv is the one program in this directory where the guard's own
# discriminator — "is the environment installed?" — is also the thing the
# program reads. That is not circular: under `aql test` the environment is
# structurally {}, so the guard is false and the suite runs; under `aql run`
# and in a built binary it is the process environment, so the guard is true
# and printenv prints it. The argv disjunct covers `printenv NAME` in the
# empty-environment corner.
# ----------------------------------------------------------------------------
def pe-standalone ((((IO.env-all) size) gt 0) or (((IO.args) size) gt 0))

if pe-standalone [
  def pe-rc (pe-main (IO.args) (IO.env-all))
  IO.exit pe-rc;
] []
