# ============================================================================
# wc — BORU unit-test suite (boru:test), over the PURE core of ../wc.boru.
#
# HOW THIS SUITE REACHES THE PROGRAM. `boru test` cannot inject an argument
# vector, and a program is not a module: it has no `export`, so
# `import "./wc.boru"` binds nothing at all — and it would still RUN the
# program's shell at import time, which with an empty argv blocks reading
# stdin forever (verified). So the suite does the one thing that keeps the
# assertions honest: it READS wc.boru, cuts it at the `# :wc-core-end:` marker,
# and evaluates the pure half in a sub-engine (`Vm.run-with`). Every
# expectation below therefore runs the SHIPPED source, not a transcription of
# it — rename a fn in wc.boru and this file goes red.
#
# The sub-engine needs a policy that permits the three imports at the head of
# wc.boru (boru:cli, boru:io, boru:string-util) plus disk reads; `Vm.run-with`
# attenuates against the parent, so this can never grant more than the test
# runner already has.
#
# Run it from utils/ — `boru test tests/wc_test.boru` — because the source is
# read relative to the process working directory.
#
# Every assertion cites the rule it pins (# rule:) or the branch it covers
# (# branch: wc.boru fn-name).
# ============================================================================

import "boru:test"
import "boru:io"
import "boru:vm"
import "boru:string-util"

def wc-policy {
  version: 1
  name:    "wc-core"
  limits: {timeoutMs: 30000 maxStepBudget: 100000000 maxStackDepth: 4096
           maxOutputBytes: 1048576}
  scopes: {
    global:  {words: {default: "allow"}}
    engine:  {words: {default: "allow"}}
    modules: {
      words: {default: "allow"}
      scopes: {
        "boru:io":          {words: {default: "allow"}}
        "boru:cli":         {words: {default: "allow"}}
        "boru:string-util": {words: {default: "allow"}}
      }
    }
    fileops: {words: {default: "allow"}}
    formats: {words: {default: "allow"}}
    env:     {words: {default: "allow"}}
    clock:   {words: {default: "allow"}}
  }
}

def wc-source (IO.read (make Pathon "wc.boru") {fmt: "text" nl: "raw"})
def wc-mark (StringUtil.indexof "# :wc-core-end:" wc-source)
def wc-core (slice 0 wc-mark wc-source)

# Evaluate one expression against the program's pure core. The sub-engine
# returns the last value on its residual stack, which is the expression's
# value. `join ""` (never a one-character separator — see wc.boru) glues the
# core, a newline and the expression together.
def wc-eval fn [[expr:String] [Any] [
  def r ((wc-policy) (join "" [wc-core "\n" expr]) Vm.run-with)
  r
]]

# ----------------------------------------------------------------------------
# The harness itself: if the slice or the sub-engine were broken, every other
# case below would fail for the wrong reason.
# ----------------------------------------------------------------------------
Test.describe "the core loader" [
  Test.test "wc.boru carries the core-end marker" [
    Assert.ok (wc-mark gt 0)
  ]
  Test.test "the sliced core stops before the imperative shell" [
    Assert.equal -1 (StringUtil.indexof "def d (Cli.dispatch" wc-core)   # rule: nothing impure above the marker
  ]
  Test.test "…and carries no IO.exit, which would end this suite file" [
    Assert.equal -1 (StringUtil.indexof "IO.exit" wc-core)
  ]
  Test.test "the sliced core still contains the counting words" [
    Assert.ok ((StringUtil.indexof "def wc-count" wc-core) gt 0)
  ]
  Test.test "the sub-engine evaluates the core" [
    Assert.equal 3 (wc-eval "wc-bytes 'abc'")
  ]
]

# ----------------------------------------------------------------------------
# Lines — wc counts NEWLINE CHARACTERS, not "lines of text".
# ----------------------------------------------------------------------------
Test.describe "wc-lines" [
  Test.test "the empty input has no lines" [
    Assert.equal 0 (wc-eval "wc-lines ''")                           # rule: 0 newlines
  ]
  Test.test "an unterminated last line is NOT counted" [
    Assert.equal 0 (wc-eval "wc-lines 'abc'")                        # rule: wc counts \n, like GNU
  ]
  Test.test "one terminated line counts one" [
    Assert.equal 1 (wc-eval "wc-lines 'abc\\n'")
  ]
  Test.test "two lines, the second unterminated, counts one" [
    Assert.equal 1 (wc-eval "wc-lines 'a\\nb'")
  ]
  Test.test "two terminated lines count two" [
    Assert.equal 2 (wc-eval "wc-lines 'a\\nb\\n'")
  ]
  Test.test "empty lines count" [
    Assert.equal 3 (wc-eval "wc-lines '\\n\\n\\n'")
  ]
  Test.test "a CRLF file counts one line per LF, not two" [
    Assert.equal 2 (wc-eval "wc-lines 'a\\r\\nb\\r\\n'")             # rule: CR is not a line terminator
  ]
]

# ----------------------------------------------------------------------------
# Words — maximal runs of non-whitespace.
# ----------------------------------------------------------------------------
Test.describe "wc-words" [
  Test.test "the empty input has no words" [
    Assert.equal 0 (wc-eval "wc-words ''")
  ]
  Test.test "whitespace alone has no words" [
    Assert.equal 0 (wc-eval "wc-words '  \\t\\n '")                  # rule: separators are not words
  ]
  Test.test "one word" [
    Assert.equal 1 (wc-eval "wc-words 'abc'")
  ]
  Test.test "a run of spaces separates exactly one boundary" [
    Assert.equal 2 (wc-eval "wc-words 'a     b'")                    # branch: split drops empty fields
  ]
  Test.test "leading and trailing whitespace add no words" [
    Assert.equal 2 (wc-eval "wc-words '   a b   '")
  ]
  Test.test "tab, newline, CR, vertical tab and form feed all separate" [
    Assert.equal 6 (wc-eval "wc-words 'a\\tb\\nc\\rd\\ve\\ff'")      # branch: wc-flat-step over wc-spaces
  ]
  Test.test "punctuation does not separate" [
    Assert.equal 1 (wc-eval "wc-words 'a,b;c'")
  ]
  Test.test "a multibyte word is one word" [
    Assert.equal 2 (wc-eval "wc-words 'héllo wörld'")
  ]
]

# ----------------------------------------------------------------------------
# Bytes — the UTF-8 length, not the rune count.
# ----------------------------------------------------------------------------
Test.describe "wc-bytes" [
  Test.test "the empty input has no bytes" [
    Assert.equal 0 (wc-eval "wc-bytes ''")
  ]
  Test.test "ASCII bytes are runes" [
    Assert.equal 3 (wc-eval "wc-bytes 'abc'")
  ]
  Test.test "a newline is a byte" [
    Assert.equal 4 (wc-eval "wc-bytes 'abc\\n'")
  ]
  Test.test "a two-byte rune counts two" [
    Assert.equal 3 (wc-eval "wc-bytes 'hé'")                         # rule: bytes, not runes
  ]
  Test.test "…and `size` on the same String would say 2" [
    Assert.equal 2 (wc-eval "size 'hé'")                             # rule: the trap this fn exists to avoid
  ]
  Test.test "a four-byte rune counts four" [
    Assert.equal 4 (wc-eval "wc-bytes '𐍈'")
  ]
]

# ----------------------------------------------------------------------------
# The count record, and its monoid.
# ----------------------------------------------------------------------------
Test.describe "wc-count and wc-add" [
  Test.test "all three counts, in the canonical key order" [
    Assert.equal {lines: 2 words: 5 bytes: 29}
                 (wc-eval "wc-count 'hello world\\nsecond line here\\n'")   # rule: GNU wc agrees (see the report)
  ]
  Test.test "the empty input counts zero of everything" [
    Assert.equal {lines: 0 words: 0 bytes: 0} (wc-eval "wc-count ''")
  ]
  Test.test "wc-add sums column by column" [
    Assert.equal {lines: 4 words: 6 bytes: 8}
                 (wc-eval "wc-add {lines:1 words:2 bytes:3} {lines:3 words:4 bytes:5}")
  ]
  Test.test "wc-zero is the identity of wc-add" [
    Assert.equal {lines: 1 words: 2 bytes: 3}
                 (wc-eval "wc-add wc-zero {lines:1 words:2 bytes:3}")
  ]
  Test.test "wc-total folds a list of items" [
    Assert.equal {lines: 4 words: 6 bytes: 8}
                 (wc-eval "wc-total [{label:'a' counts:{lines:1 words:2 bytes:3}} {label:'b' counts:{lines:3 words:4 bytes:5}}]")
  ]
  Test.test "wc-total of nothing is wc-zero" [
    Assert.equal {lines: 0 words: 0 bytes: 0} (wc-eval "wc-total []")   # branch: fold over an empty list
  ]
]

# ----------------------------------------------------------------------------
# Column selection — the canonical order, never the flag order.
# ----------------------------------------------------------------------------
Test.describe "wc-columns" [
  Test.test "no flag selects all three" [
    Assert.equal ["lines" "words" "bytes"] (wc-eval "wc-columns {lines:false words:false bytes:false}")
  ]
  Test.test "an empty flags map also selects all three" [
    Assert.equal ["lines" "words" "bytes"] (wc-eval "wc-columns {}")     # branch: wc-flag absent key
  ]
  Test.test "-l alone" [
    Assert.equal ["lines"] (wc-eval "wc-columns {lines:true words:false bytes:false}")
  ]
  Test.test "-w alone" [
    Assert.equal ["words"] (wc-eval "wc-columns {words:true}")
  ]
  Test.test "-c alone" [
    Assert.equal ["bytes"] (wc-eval "wc-columns {bytes:true}")
  ]
  Test.test "-lc keeps lines before bytes" [
    Assert.equal ["lines" "bytes"] (wc-eval "wc-columns {lines:true bytes:true}")
  ]
  Test.test "-wc keeps words before bytes" [
    Assert.equal ["words" "bytes"] (wc-eval "wc-columns {words:true bytes:true}")
  ]
  Test.test "all three flags reproduce the default order" [
    Assert.equal ["lines" "words" "bytes"] (wc-eval "wc-columns {lines:true words:true bytes:true}")
  ]
  Test.test "a non-Boolean flag value is not a selection" [
    Assert.equal ["lines" "words" "bytes"] (wc-eval "wc-columns {lines:'yes'}")   # branch: wc-flag non-Boolean
  ]
  Test.test "wc-flag reads a true flag" [
    Assert.equal true (wc-eval "wc-flag {lines:true} 'lines'")
  ]
  Test.test "wc-flag defaults an absent flag to false" [
    Assert.equal false (wc-eval "wc-flag {} 'lines'")
  ]
  Test.test "wc-flag defaults a none-valued flag to false" [
    Assert.equal false (wc-eval "wc-flag {lines:none} 'lines'")           # rule: boru:cli's string defaults are none
  ]
]

# ----------------------------------------------------------------------------
# Layout. `join " "` would silently eat the padding (voxgigstruct.Join merges
# a one-character separator at element edges), so these rows are the
# regression guard for that trap as much as for the arithmetic.
# ----------------------------------------------------------------------------
Test.describe "wc-lpad" [
  Test.test "a short string is padded on the left" [
    Assert.equal "  7" (wc-eval "wc-lpad '7' 3")
  ]
  Test.test "an exact-width string is untouched" [
    Assert.equal "123" (wc-eval "wc-lpad '123' 3")                       # branch: gte, no recursion
  ]
  Test.test "an over-width string is NOT truncated" [
    Assert.equal "12345" (wc-eval "wc-lpad '12345' 3")                   # rule: counts are never clipped
  ]
  Test.test "width 0 and width 1 leave a single digit alone" [
    Assert.equal "5" (wc-eval "wc-lpad '5' 1")
  ]
]

Test.describe "wc-width" [
  Test.test "single-digit totals give width 1" [
    Assert.equal 1 (wc-eval "wc-width {lines:1 words:2 bytes:3} ['lines' 'words' 'bytes']")
  ]
  Test.test "the widest selected column wins" [
    Assert.equal 3 (wc-eval "wc-width {lines:1 words:2 bytes:300} ['lines' 'words' 'bytes']")
  ]
  Test.test "an unselected wide column does not widen the report" [
    Assert.equal 1 (wc-eval "wc-width {lines:1 words:2 bytes:300} ['lines' 'words']")   # branch: fold over sel only
  ]
  Test.test "a zero total still has width 1" [
    Assert.equal 1 (wc-eval "wc-width wc-zero ['lines']")                 # rule: minimum width 1
  ]
]

Test.describe "wc-row" [
  Test.test "an unlabelled row is just the counts" [
    Assert.equal "1 2 3"
                 (wc-eval "wc-row {lines:1 words:2 bytes:3} ['lines' 'words' 'bytes'] 1 ''")
  ]
  Test.test "a labelled row appends the name after one space" [
    Assert.equal "1 2 3 f.txt"
                 (wc-eval "wc-row {lines:1 words:2 bytes:3} ['lines' 'words' 'bytes'] 1 'f.txt'")
  ]
  Test.test "padding survives the join — the columns really line up" [
    Assert.equal " 2  5 29 f.txt"
                 (wc-eval "wc-row {lines:2 words:5 bytes:29} ['lines' 'words' 'bytes'] 2 'f.txt'")   # rule: NOT ' 2 5 29 f.txt'
  ]
  Test.test "a single selected column renders one cell" [
    Assert.equal "29 f.txt" (wc-eval "wc-row {lines:2 words:5 bytes:29} ['bytes'] 2 'f.txt'")
  ]
  Test.test "the cells follow the selection order, not the map order" [
    Assert.equal "3 1" (wc-eval "wc-row {lines:1 words:2 bytes:3} ['bytes' 'lines'] 1 ''")
  ]
]

# ----------------------------------------------------------------------------
# The whole report.
# ----------------------------------------------------------------------------
Test.describe "wc-report" [
  Test.test "one file, no total row" [
    Assert.equal " 2  5 29 f.txt\n"
                 (wc-eval "wc-report [{label:'f.txt' counts:{lines:2 words:5 bytes:29}}] ['lines' 'words' 'bytes'] false")
  ]
  Test.test "two files and a total, all padded to the total's width" [
    Assert.equal " 2  5 29 f.txt\n 1  2 14 u.txt\n 3  7 43 total\n"
                 (wc-eval "wc-report [{label:'f.txt' counts:{lines:2 words:5 bytes:29}} {label:'u.txt' counts:{lines:1 words:2 bytes:14}}] ['lines' 'words' 'bytes'] true")   # rule: matches GNU wc byte for byte
  ]
  Test.test "an unlabelled item (stdin with no operand) has no trailing name" [
    Assert.equal "1 1 2\n"
                 (wc-eval "wc-report [{label:'' counts:{lines:1 words:1 bytes:2}}] ['lines' 'words' 'bytes'] false")
  ]
  Test.test "a selected subset narrows the report" [
    Assert.equal "2 f.txt\n"
                 (wc-eval "wc-report [{label:'f.txt' counts:{lines:2 words:5 bytes:29}}] ['lines'] false")
  ]
  Test.test "nothing counted prints nothing at all" [
    Assert.equal "" (wc-eval "wc-report [] ['lines' 'words' 'bytes'] false")   # branch: empty rows -> ''
  ]
  Test.test "a total row alone is still rendered when asked for" [
    Assert.equal "0 0 0 total\n" (wc-eval "wc-report [] ['lines' 'words' 'bytes'] true")   # rule: every operand failed
  ]
  Test.test "the width comes from the widest count anywhere in the run" [
    Assert.equal "    2     5    29 f.txt\n20000 20000 40000 big\n20002 20005 40029 total\n"
                 (wc-eval "wc-report [{label:'f.txt' counts:{lines:2 words:5 bytes:29}} {label:'big' counts:{lines:20000 words:20000 bytes:40000}}] ['lines' 'words' 'bytes'] true")
  ]
]

# ----------------------------------------------------------------------------
# Operand handling and the diagnostic line.
# ----------------------------------------------------------------------------
Test.describe "wc-names and wc-diag" [
  Test.test "no operands means stdin" [
    Assert.equal ["-"] (wc-eval "wc-names []")                            # rule: the stdin convention
  ]
  Test.test "operands are passed through unchanged, in order" [
    Assert.equal ["a" "b"] (wc-eval "wc-names ['a' 'b']")
  ]
  Test.test "an explicit - is left as an operand" [
    Assert.equal ["-" "a"] (wc-eval "wc-names ['-' 'a']")
  ]
  Test.test "the diagnostic names the program, the operand and the cause" [
    Assert.equal "wc: nosuch: no such file\n" (wc-eval "wc-diag 'nosuch' 'no such file'")   # rule: diagnostics go to stderr
  ]
]

# ----------------------------------------------------------------------------
# The read path. `IO.read` has two defaults that quietly destroy a wc:
# it picks a DECODER FROM THE EXTENSION (a .md file comes back as a parsed
# document, not text) and it NORMALISES NEWLINES (CRLF collapses to LF, so
# six bytes read as four). wc-raw pins {fmt:"text" nl:"raw"} against both, and
# this block is the regression guard: the fixture is written to a temp file
# with a .md suffix AND CRLF terminators, so dropping either option fails it.
# ----------------------------------------------------------------------------
def wc-crlf-probe
  "def p (IO.temp {prefix:'wctest' suffix:'.md'})\ndef _w (IO.write p 'a\\r\\nb\\r\\n' {nl:'raw'})\ndef s (wc-slurp (convert String p))\ndef _r (IO.remove p)\nwc-count (s dot text)"

Test.describe "wc-slurp" [
  Test.test "a CRLF .md file counts 6 bytes and 2 lines, exactly as wc does" [
    Assert.equal {lines: 2 words: 2 bytes: 6} (wc-eval wc-crlf-probe)   # rule: {fmt:'text' nl:'raw'}
  ]
  Test.test "a readable file succeeds" [
    Assert.equal true (wc-eval "(wc-slurp 'wc.boru') dot ok")
  ]
  Test.test "an unreadable operand is DATA, not a raised error" [
    Assert.equal false (wc-eval "(wc-slurp 'no-such-file-at-all') dot ok")   # rule: one bad operand never ends the run
  ]
  Test.test "…and it carries a non-empty cause for the diagnostic" [
    Assert.equal true (wc-eval "((wc-slurp 'no-such-file-at-all') dot err) neq ''")
  ]
]

# ----------------------------------------------------------------------------
# End-to-end over the pure pipeline: text in, report out. This is the whole
# program bar the reading of the files.
# ----------------------------------------------------------------------------
Test.describe "text to report" [
  Test.test "one file's text renders the row GNU wc renders" [
    Assert.equal " 2  5 29 f.txt\n"
                 (wc-eval "wc-report [({} set (quote label) 'f.txt' set (quote counts) (wc-count 'hello world\\nsecond line here\\n'))] (wc-columns {}) false")
  ]
  Test.test "…and -c alone narrows it to the byte column" [
    Assert.equal "29 f.txt\n"
                 (wc-eval "wc-report [({} set (quote label) 'f.txt' set (quote counts) (wc-count 'hello world\\nsecond line here\\n'))] (wc-columns {bytes:true}) false")
  ]
  Test.test "an empty file renders three zeroes" [
    Assert.equal "0 0 0 empty\n"
                 (wc-eval "wc-report [({} set (quote label) 'empty' set (quote counts) (wc-count ''))] (wc-columns {}) false")
  ]
]
