# ============================================================================
# sort — unit suite (boru:test), shaped like tests/cat_test.boru.
#
#   boru test tests/sort_test.boru          (run from utils/)
#
# sort's whole behaviour is the pure fn Sort.apply — lines in, lines out — so
# almost every case here is a direct call on it, with no filesystem involved.
# That is deliberate: an ordering bug is a bug in the ordering, and a test that
# has to write a file to find one is a test that will not be written.
#
# The cases that DO touch the filesystem are the ones about reading: the
# stdin/file duality, and what a missing input does.
# ============================================================================

import "boru:test"
import "boru:cli"
import "boru:io"
import "boru:string-util"
import "./sort.boru"

def fixture "/tmp/boru-utils-sort-test-fixture.txt"
def missing "/tmp/boru-utils-sort-test-no-such-file.txt"

# ----------------------------------------------------------------------------
# 1. Small readers.
# ----------------------------------------------------------------------------
Test.describe "sort-bool" [
  Test.test "a true flag reads true" [ Assert.equal true (Sort.bool {reverse:true} "reverse") ]
  Test.test "an absent flag reads false" [ Assert.equal false (Sort.bool {} "reverse") ]
  Test.test "a non-Boolean flag value reads false" [
    Assert.equal false (Sort.bool {reverse:"y"} "reverse")
  ]
]

Test.describe "sort-inputs" [
  Test.test "no operand means standard input" [ Assert.equal ["-"] (Sort.inputs []) ]
  Test.test "operands pass through in order" [ Assert.equal ["a" "b"] (Sort.inputs ["a" "b"]) ]
]

Test.describe "sort-worse" [
  Test.test "the higher code wins" [ Assert.equal 1 (Sort.worse 0 1) ]
  Test.test "success stays success" [ Assert.equal 0 (Sort.worse 0 0) ]
]

# ----------------------------------------------------------------------------
# 2. Splitting a blob into lines. The trailing-newline rule is the one people
# get wrong, and it is what stops sort inventing a phantom empty line.
# ----------------------------------------------------------------------------
Test.describe "sort-lines" [
  Test.test "an empty blob has no lines at all" [ Assert.equal [] (Sort.lines "") ]
  Test.test "one terminated line is one line" [ Assert.equal ["a"] (Sort.lines "a\n") ]
  Test.test "the TRAILING newline does not create an empty last line" [
    Assert.equal ["a" "b"] (Sort.lines "a\nb\n")
  ]
  Test.test "a line with no trailing newline is still a line" [
    Assert.equal ["a" "b"] (Sort.lines "a\nb")
  ]
  Test.test "an INTERIOR empty line IS a line, and is kept" [
    Assert.equal ["a" "" "b"] (Sort.lines "a\n\nb\n")
  ]
  Test.test "a blob that is only a newline is one empty line" [
    Assert.equal [""] (Sort.lines "\n")
  ]
  Test.test "leading and trailing spaces are part of the line" [
    Assert.equal ["  a  "] (Sort.lines "  a  \n")
  ]
]

# ----------------------------------------------------------------------------
# 3. The numeric key. Every one of these would pass on single-digit input with
# a stringified key, which is why the multi-digit cases are here.
# ----------------------------------------------------------------------------
Test.describe "sort-key" [
  Test.test "a plain integer" [ Assert.equal 10.0 (Sort.key "10") ]
  Test.test "a bigger one is BIGGER, not lexically later" [
    Assert.equal true ((Sort.key "100") gt (Sort.key "9"))
  ]
  Test.test "a negative number" [ Assert.equal -5.0 (Sort.key "-5") ]
  Test.test "and it sorts below zero" [
    Assert.equal true ((Sort.key "-5") lt (Sort.key "0"))
  ]
  Test.test "a number with trailing text keys on the number" [
    Assert.equal 42.0 (Sort.key "42 apples")
  ]
  Test.test "a line that does not start with a number keys as 0" [
    Assert.equal 0.0 (Sort.key "apples")
  ]
  Test.test "an empty line keys as 0" [ Assert.equal 0.0 (Sort.key "") ]
  Test.test "a bare dash is not a number" [ Assert.equal 0.0 (Sort.key "-") ]
  Test.test "leading zeros do not change the value" [ Assert.equal 7.0 (Sort.key "007") ]
]

Test.describe "sort-fold" [
  Test.test "without -f the line is its own key" [ Assert.equal "AbC" (Sort.fold "AbC" false) ]
  Test.test "with -f the key is lowered" [ Assert.equal "abc" (Sort.fold "AbC" true) ]
  Test.test "an already-lower line is unchanged either way" [
    Assert.equal "abc" (Sort.fold "abc" true)
  ]
]

Test.describe "sort-pair" [
  Test.test "the pair is [key line]" [ Assert.equal ["b" "b"] (Sort.pair "b" false false) ]
  Test.test "under -n the key is a NUMBER, so it compares numerically" [
    Assert.equal [10.0 "10"] (Sort.pair "10" true false)
  ]
  Test.test "under -f the key is folded but the LINE keeps its case" [
    Assert.equal ["abc" "AbC"] (Sort.pair "AbC" false true)
  ]
]

# ----------------------------------------------------------------------------
# 4. The ordering itself.
# ----------------------------------------------------------------------------
Test.describe "sort-apply" [
  Test.test "lines come out in ascending order" [
    Assert.equal ["a" "b" "c"] (Sort.apply ["c" "a" "b"] false false false false)
  ]
  Test.test "an empty input sorts to nothing" [
    Assert.equal [] (Sort.apply [] false false false false)
  ]
  Test.test "one line is already sorted" [
    Assert.equal ["a"] (Sort.apply ["a"] false false false false)
  ]
  Test.test "DUPLICATES are kept by default — sort is not uniq" [
    Assert.equal ["a" "a" "b"] (Sort.apply ["b" "a" "a"] false false false false)
  ]
  Test.test "-u collapses an equal run to its first member" [
    Assert.equal ["a" "b"] (Sort.apply ["b" "a" "a"] false false false true)
  ]
  Test.test "-u on all-distinct input changes nothing" [
    Assert.equal ["a" "b"] (Sort.apply ["b" "a"] false false false true)
  ]
  Test.test "-r reverses the result" [
    Assert.equal ["c" "b" "a"] (Sort.apply ["c" "a" "b"] false false true false)
  ]
  Test.test "-r keeps duplicates too" [
    Assert.equal ["b" "a" "a"] (Sort.apply ["b" "a" "a"] false false true false)
  ]
  Test.test "-ru de-duplicates FIRST and reverses after, so -ru and -ur agree" [
    Assert.equal ["b" "a"] (Sort.apply ["b" "a" "a"] false false true true)
  ]
  # The numeric cases: the default is lexical and -n is not, which is the
  # entire reason -n exists.
  Test.test "the DEFAULT order over numbers is lexical: 10 before 9" [
    Assert.equal ["10" "100" "9"] (Sort.apply ["9" "100" "10"] false false false false)
  ]
  Test.test "-n orders them numerically: 9 before 10 before 100" [
    Assert.equal ["9" "10" "100"] (Sort.apply ["9" "100" "10"] true false false false)
  ]
  Test.test "-n puts negatives first" [
    Assert.equal ["-5" "0" "3"] (Sort.apply ["3" "-5" "0"] true false false false)
  ]
  Test.test "-n on non-numeric lines keys them all at 0 and keeps them" [
    Assert.equal 3 (size (Sort.apply ["pear" "apple" "fig"] true false false false))
  ]
  Test.test "-nr reverses the numeric order" [
    Assert.equal ["100" "10" "9"] (Sort.apply ["9" "100" "10"] true false true false)
  ]
  Test.test "-nu collapses equal NUMBERS, not equal strings" [
    Assert.equal ["1" "3"] (Sort.apply ["3" "1" "3"] true false false true)
  ]
  # Case folding.
  Test.test "the default order is case-sensitive: uppercase sorts first" [
    Assert.equal ["A" "a"] (Sort.apply ["a" "A"] false false false false)
  ]
  Test.test "-f groups the two together" [
    Assert.equal ["A" "a" "B"] (Sort.apply ["B" "a" "A"] false true false false)
  ]
  Test.test "-fu treats A and a as ONE line" [
    Assert.equal ["A" "B"] (Sort.apply ["B" "a" "A"] false true false true)
  ]
  Test.test "an empty line sorts before everything" [
    Assert.equal ["" "a"] (Sort.apply ["a" ""] false false false false)
  ]
  Test.test "multi-byte lines are ordered, not rejected" [
    Assert.equal 2 (size (Sort.apply ["日本" "あ"] false false false false))
  ]
]

Test.describe "sort-render" [
  Test.test "each line gets its terminator back" [ Assert.equal "a\nb\n" (Sort.render ["a" "b"]) ]
  Test.test "no lines render to nothing, not to a blank line" [
    Assert.equal "" (Sort.render [])
  ]
  Test.test "an empty line renders as a bare newline" [ Assert.equal "\n" (Sort.render [""]) ]
]

# ----------------------------------------------------------------------------
# 5. Reading — the stdin/file duality's file half, and the failure arm.
# ----------------------------------------------------------------------------
Test.describe "sort-slurp" [
  Test.test "a readable file is slurped whole" [
    (IO.write (make Pathon fixture) "b\na\n") drop
    Assert.equal [true "b\na\n"] [((Sort.slurp fixture) dot ok) ((Sort.slurp fixture) dot text)]
  ]
  Test.test "an empty file slurps to the empty string, and succeeds" [
    def empty "/tmp/boru-utils-sort-test-empty.txt"
    (IO.write (make Pathon empty) "") drop
    def got (Sort.slurp empty)
    (IO.remove (make Pathon empty)) drop
    Assert.equal [true ""] [(got.ok) (got.text)]
  ]
  Test.test "a MISSING file is reported as data, not raised" [
    Assert.equal false ((Sort.slurp missing) dot ok)
  ]
  Test.test "a directory is a failure too, rather than a panic" [
    Assert.equal false ((Sort.slurp "/tmp") dot ok)
  ]
]

Test.describe "sort-fail" [
  Test.test "a diagnostic always yields the failure code" [
    Assert.equal 1 (Sort.fail "f" "boom")
  ]
]

# ----------------------------------------------------------------------------
# 6. The argv contract.
# ----------------------------------------------------------------------------
Test.describe "argv" [
  Test.test "no argv leaves every flag off" [
    Assert.equal {reverse:false numeric-sort:false unique:false ignore-case:false}
                 ((Cli.parse (Sort.spec) []) dot flags)
  ]
  Test.test "-r sets reverse" [
    Assert.equal true ((Cli.parse (Sort.spec) ["-r"]) dot flags dot reverse)
  ]
  Test.test "-nru clusters into three flags" [
    Assert.equal {reverse:true numeric-sort:true unique:true ignore-case:false}
                 ((Cli.parse (Sort.spec) ["-nru"]) dot flags)
  ]
  Test.test "the long spellings work too" [
    Assert.equal true ((Cli.parse (Sort.spec) ["--numeric-sort"]) dot flags dot numeric-sort)
  ]
  Test.test "operands survive the flags" [
    Assert.equal ["x" "y"] ((Cli.parse (Sort.spec) ["-r" "x" "y"]) dot args)
  ]
  Test.test "an unknown flag is data, and names the offender" [
    Assert.equal "unknown flag: -Z" ((Cli.parse (Sort.spec) ["-Z"]) dot err)
  ]
  Test.test "--version prints the name and version" [
    Assert.equal "sort 0.1.0\n" ((Cli.dispatch (Sort.spec) ["--version"]) dot out)
  ]
  Test.test "--help mentions the numeric flag" [
    Assert.equal true ((StringUtil.indexof "--numeric-sort" ((Cli.dispatch (Sort.spec) ["--help"]) dot out)) gte 0)
  ]
]

# ----------------------------------------------------------------------------
# 7. The program. Sort.main with a file operand never reads standard input, so
# these are safe under the runner.
# ----------------------------------------------------------------------------
Test.describe "exit codes" [
  Test.test "a readable file exits 0" [
    (IO.write (make Pathon fixture) "b\na\n") drop
    Assert.equal 0 (Sort.main [fixture])
  ]
  Test.test "with flags, still 0" [ Assert.equal 0 (Sort.main ["-ru" fixture]) ]
  Test.test "a missing file exits 1" [ Assert.equal 1 (Sort.main [missing]) ]
  Test.test "a directory exits 1 rather than raising" [ Assert.equal 1 (Sort.main ["/tmp"]) ]
  Test.test "one bad operand among good ones exits 1" [
    Assert.equal 1 (Sort.main [fixture missing])
  ]
  Test.test "--help exits 0" [ Assert.equal 0 (Sort.main ["--help"]) ]
  Test.test "--version exits 0" [ Assert.equal 0 (Sort.main ["--version"]) ]
  Test.test "an unknown flag exits 2" [ Assert.equal 2 (Sort.main ["-Z"]) ]
  Test.test "a usage error outranks a missing file" [
    Assert.equal 2 (Sort.main ["-Z" missing])
  ]
  Test.test "-- makes a flag-looking operand a (missing) file, so 1 not 2" [
    Assert.equal 1 (Sort.main ["--" "-Z"])
  ]
]
