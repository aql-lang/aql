# ============================================================================
# tee — unit suite (aql:test), shaped like tests/cat_test.aql.
#
#   aql test tests/tee_test.aql          (run from utils/)
#
# tee is the suite's only WRITER, so this file is the only one whose cases
# leave files behind and then read them back. Every fixture lives under /tmp,
# never inside the repository, and is written fresh by the case that needs it.
#
# What is NOT here: the baked-permissions pair. `aql build tee.aql -perms
# read-only` versus the same build with the write allowed cannot be expressed
# from inside a running program — it is a property of the BUILT binary — so it
# lives in cmd/go/internal/build/utils_e2e_test.go, where a Go test can build
# twice and run both. See tee.aql's header.
#
# The streaming loop is driven through Tee.fan and Tee.openAt rather than
# through the whole program, because tee with no operand reads standard input,
# and under `aql test` standard input is the runner's own — a real, open
# stream, so a case that called Tee.main would block. That is the same
# constraint the standalone guard at the bottom of tee.aql exists for.
# ============================================================================

import "aql:test"
import "aql:cli"
import "aql:io"
import "aql:string-util"
import "./tee.aql"

def out1 "/tmp/aql-utils-tee-test-1.txt"
def out2 "/tmp/aql-utils-tee-test-2.txt"
def nodir "/tmp/aql-utils-tee-test-no-such-dir/f.txt"

# ----------------------------------------------------------------------------
# 1. Pure fns.
# ----------------------------------------------------------------------------
Test.describe "tee-bool" [
  Test.test "a true flag reads true" [ Assert.equal true (Tee.bool {append:true} "append") ]
  Test.test "an absent flag reads false" [ Assert.equal false (Tee.bool {} "append") ]
  Test.test "a non-Boolean flag value reads false" [
    Assert.equal false (Tee.bool {append:1} "append")
  ]
]

Test.describe "tee-count" [
  Test.test "the counter is read back" [ Assert.equal 4 (Tee.count {n:4}) ]
  Test.test "a missing counter reads 0" [ Assert.equal 0 (Tee.count {}) ]
  Test.test "a non-Integer counter reads 0" [ Assert.equal 0 (Tee.count {n:none}) ]
]

Test.describe "tee-worse" [
  Test.test "the higher code wins" [ Assert.equal 1 (Tee.worse 0 1) ]
  Test.test "in either order" [ Assert.equal 1 (Tee.worse 1 0) ]
  Test.test "success stays success" [ Assert.equal 0 (Tee.worse 0 0) ]
]

Test.describe "tee-mode" [
  Test.test "the default TRUNCATES, so a second run replaces the file" [
    Assert.equal {mode:"write" create:true truncate:true} (Tee.mode false)
  ]
  Test.test "-a appends, and does NOT truncate" [
    Assert.equal {mode:"append" create:true} (Tee.mode true)
  ]
  Test.test "both modes create the file — that is what tee is for" [
    Assert.equal [true true] [((Tee.mode false) dot create) ((Tee.mode true) dot create)]
  ]
]

Test.describe "tee-record" [
  Test.test "the terminator IO.read-line removed is put back" [
    Assert.equal "x\n" (Tee.record "x")
  ]
  Test.test "an empty line is still a line" [ Assert.equal "\n" (Tee.record "") ]
  Test.test "the content is byte-transparent — nothing is escaped or trimmed" [
    Assert.equal "  a\tb  \n" (Tee.record "  a\tb  ")
  ]
  Test.test "multi-byte runes pass through untouched" [
    Assert.equal "日本語\n" (Tee.record "日本語")
  ]
]

Test.describe "tee-next-chunk" [
  Test.test "the chunk doubles while under the ceiling" [ Assert.equal 128 (Tee.nextChunk 64) ]
  Test.test "the ceiling is a fixed point" [ Assert.equal 8192 (Tee.nextChunk 8192) ]
]

Test.describe "tee-fail" [
  Test.test "a diagnostic always yields the failure code" [
    Assert.equal 1 (Tee.fail "f" "boom")      # the text itself goes to stderr
  ]
]

# ----------------------------------------------------------------------------
# 2. Opening destinations. A failure is DATA, so one bad file cannot stop the
# others — this is the part of the contract most likely to be got wrong.
# ----------------------------------------------------------------------------
Test.describe "opening" [
  Test.test "no destinations opens nothing and succeeds" [
    def hs (flex [])
    def rc (Tee.openAt [] 0 (Tee.mode false) hs 0)
    Assert.equal [0 0] [rc (size hs)]
  ]
  Test.test "one destination yields one handle and code 0" [
    def hs (flex [])
    def rc (Tee.openAt [out1] 0 (Tee.mode false) hs 0)
    def _c (Tee.closeAt hs 0)
    Assert.equal [0 1] [rc (size hs)]
  ]
  Test.test "two destinations yield two handles" [
    def hs (flex [])
    def rc (Tee.openAt [out1 out2] 0 (Tee.mode false) hs 0)
    def _c (Tee.closeAt hs 0)
    Assert.equal [0 2] [rc (size hs)]
  ]
  Test.test "an UNOPENABLE destination yields 1 rather than raising" [
    def hs (flex [])
    def rc (Tee.openAt [nodir] 0 (Tee.mode false) hs 0)
    Assert.equal 1 rc
  ]
  Test.test "and contributes no handle" [
    def hs (flex [])
    def _r (Tee.openAt [nodir] 0 (Tee.mode false) hs 0)
    Assert.equal 0 (size hs)
  ]
  Test.test "a bad destination does not stop the GOOD ones being opened" [
    def hs (flex [])
    def rc (Tee.openAt [nodir out1] 0 (Tee.mode false) hs 0)
    def _c (Tee.closeAt hs 0)
    Assert.equal [1 1] [rc (size hs)]
  ]
  Test.test "in either order — the walk does not short-circuit" [
    def hs (flex [])
    def rc (Tee.openAt [out1 nodir] 0 (Tee.mode false) hs 0)
    def _c (Tee.closeAt hs 0)
    Assert.equal [1 1] [rc (size hs)]
  ]
  Test.test "closing an empty handle list is a no-op, not an error" [
    Assert.equal 0 (Tee.closeAt (flex []) 0)
  ]
]

# ----------------------------------------------------------------------------
# 3. The fan-out — what actually lands on disk.
# ----------------------------------------------------------------------------
Test.describe "writing" [
  Test.test "a record reaches the destination file" [
    def hs (flex [])
    def _o (Tee.openAt [out1] 0 (Tee.mode false) hs 0)
    def _w (Tee.fan hs (Tee.record "hello"))
    def _c (Tee.closeAt hs 0)
    Assert.equal "hello\n" (convert String (IO.read (make Pathon out1)))
  ]
  Test.test "several records land in order" [
    def hs (flex [])
    def _o (Tee.openAt [out1] 0 (Tee.mode false) hs 0)
    def _1 (Tee.fan hs (Tee.record "a"))
    def _2 (Tee.fan hs (Tee.record "b"))
    def _c (Tee.closeAt hs 0)
    Assert.equal "a\nb\n" (convert String (IO.read (make Pathon out1)))
  ]
  Test.test "EVERY destination gets the same bytes — that is the whole program" [
    def hs (flex [])
    def _o (Tee.openAt [out1 out2] 0 (Tee.mode false) hs 0)
    def _w (Tee.fan hs (Tee.record "both"))
    def _c (Tee.closeAt hs 0)
    Assert.equal ["both\n" "both\n"] [(convert String (IO.read (make Pathon out1)))
                                      (convert String (IO.read (make Pathon out2)))]
  ]
  Test.test "the default mode TRUNCATES what was there before" [
    def h1 (flex [])
    def _a (Tee.openAt [out1] 0 (Tee.mode false) h1 0)
    def _b (Tee.fan h1 (Tee.record "first"))
    def _c (Tee.closeAt h1 0)
    def h2 (flex [])
    def _d (Tee.openAt [out1] 0 (Tee.mode false) h2 0)
    def _e (Tee.fan h2 (Tee.record "second"))
    def _f (Tee.closeAt h2 0)
    Assert.equal "second\n" (convert String (IO.read (make Pathon out1)))
  ]
  Test.test "-a mode APPENDS instead" [
    def h1 (flex [])
    def _a (Tee.openAt [out1] 0 (Tee.mode false) h1 0)
    def _b (Tee.fan h1 (Tee.record "first"))
    def _c (Tee.closeAt h1 0)
    def h2 (flex [])
    def _d (Tee.openAt [out1] 0 (Tee.mode true) h2 0)
    def _e (Tee.fan h2 (Tee.record "second"))
    def _f (Tee.closeAt h2 0)
    Assert.equal "first\nsecond\n" (convert String (IO.read (make Pathon out1)))
  ]
  Test.test "-a on a file that does not exist yet CREATES it" [
    def gone "/tmp/aql-utils-tee-test-fresh.txt"
    # IO.remove RAISES on a missing path, so the tidy-up has to be guarded —
    # this case is specifically about the file not existing beforehand.
    def _rm (do [ (IO.remove (make Pathon gone)) drop  0 ] error [ 0 ])
    def hs (flex [])
    def _o (Tee.openAt [gone] 0 (Tee.mode true) hs 0)
    def _w (Tee.fan hs (Tee.record "new"))
    def _c (Tee.closeAt hs 0)
    def got (convert String (IO.read (make Pathon gone)))
    (IO.remove (make Pathon gone)) drop
    Assert.equal "new\n" got
  ]
  Test.test "with NO destinations the fan still succeeds — stdout is not a file" [
    Assert.equal 0 (Tee.fan (flex []) (Tee.record "to stdout only"))
  ]
  Test.test "an empty record is written, not skipped" [
    def hs (flex [])
    def _o (Tee.openAt [out1] 0 (Tee.mode false) hs 0)
    def _w (Tee.fan hs (Tee.record ""))
    def _c (Tee.closeAt hs 0)
    Assert.equal "\n" (convert String (IO.read (make Pathon out1)))
  ]
  Test.test "multi-byte content survives the round trip byte for byte" [
    def hs (flex [])
    def _o (Tee.openAt [out1] 0 (Tee.mode false) hs 0)
    def _w (Tee.fan hs (Tee.record "日本語 🎉"))
    def _c (Tee.closeAt hs 0)
    Assert.equal "日本語 🎉\n" (convert String (IO.read (make Pathon out1)))
  ]
]

# ----------------------------------------------------------------------------
# 4. The argv contract.
# ----------------------------------------------------------------------------
Test.describe "argv" [
  Test.test "no argv leaves the flag off and takes no destination" [
    Assert.equal {ok:true flags:{append:false} args:[] command:none}
                 (Cli.parse (Tee.spec) [])
  ]
  Test.test "-a sets append" [
    Assert.equal true ((Cli.parse (Tee.spec) ["-a"]) dot flags dot append)
  ]
  Test.test "the long spelling works too" [
    Assert.equal true ((Cli.parse (Tee.spec) ["--append"]) dot flags dot append)
  ]
  Test.test "destinations are operands, in order" [
    Assert.equal ["x" "y"] ((Cli.parse (Tee.spec) ["-a" "x" "y"]) dot args)
  ]
  Test.test "-- lets a destination named like a flag through" [
    Assert.equal ["-a"] ((Cli.parse (Tee.spec) ["--" "-a"]) dot args)
  ]
  Test.test "an unknown flag is data, and names the offender" [
    Assert.equal "unknown flag: -q" ((Cli.parse (Tee.spec) ["-q"]) dot err)
  ]
  Test.test "--version prints the name and version" [
    Assert.equal "tee 0.1.0\n" ((Cli.dispatch (Tee.spec) ["--version"]) dot out)
  ]
  Test.test "--help mentions the append flag" [
    Assert.equal true ((StringUtil.indexof "--append" ((Cli.dispatch (Tee.spec) ["--help"]) dot out)) gte 0)
  ]
  Test.test "a usage error dispatches to code 2 and prints nothing to stdout" [
    Assert.equal [2 ""] [((Cli.dispatch (Tee.spec) ["-q"]) dot code)
                         ((Cli.dispatch (Tee.spec) ["-q"]) dot out)]
  ]
]

# ----------------------------------------------------------------------------
# 5. The program, for the arms that do not read standard input.
# ----------------------------------------------------------------------------
Test.describe "exit codes" [
  Test.test "--help exits 0" [ Assert.equal 0 (Tee.main ["--help"]) ]
  Test.test "--version exits 0" [ Assert.equal 0 (Tee.main ["--version"]) ]
  Test.test "an unknown flag exits 2 WITHOUT touching standard input" [
    Assert.equal 2 (Tee.main ["-q"])
  ]
  Test.test "a missing flag value is also a usage error" [
    Assert.equal 2 (Tee.main ["--no-such-flag=1"])
  ]
]
