# ============================================================================
# head — unit suite (boru:test), shaped like lang/go/modules/cli_test.boru.
#
#   boru test tests/head_test.boru          (run from utils/)
#
# `boru test` cannot inject an argument vector and an IO.exit ends the suite
# file, so head.boru keeps every decision in pure fns and exports them, and its
# one IO.exit sits behind the standalone guard at the bottom of that file.
# This suite therefore covers four tiers:
#
#   1. the pure fns       — the -n parser, headers, padding-free formatting,
#                           flag reading, the chunk sizer
#   2. the argv contract  — Cli.parse / Cli.dispatch against head's own spec
#   3. THE EARLY EXIT     — Head.one is driven over real files and the stream
#                           state's `reads` counter is asserted EXACTLY. This
#                           is the whole point of head being in this suite:
#                           `-n 2` over a 5000-line file must perform two
#                           read-line calls, `-n 0` must perform zero, and a
#                           limit that lands exactly on the last line must not
#                           perform the EOF-detecting read at all.
#   4. the program        — Head.main takes argv as a PARAMETER and returns the
#                           exit code instead of exiting, so the exit-code
#                           contract is pinned end to end
#
# Tiers 3 and 4 write head's normal output to stdout (a stream cannot be
# redirected in-process), so a handful of fixture lines appear in the run. That
# is the program working; the assertions are on the returned values.
#
# Head.main is never called without an operand and Head.one is never called on
# "-": with no file, head reads standard input, which under `boru test` is the
# runner's own — a real, open stream.
# ============================================================================

import "boru:test"
import "boru:cli"
import "boru:io"
import "boru:string-util"
import "./head.boru"

# Scratch files under the OS temp dir — never inside the repository.
def fixture "/tmp/boru-utils-head-test-fixture.txt"
def bigfile "/tmp/boru-utils-head-test-big.txt"
def missing "/tmp/boru-utils-head-test-no-such-file.txt"

# A fresh stream state, the shape head.boru's handler builds. It is spelled OUT
# in every case rather than minted by a helper fn on purpose: a FlexMap RETURNED
# from a fn silently loses its mutable identity under the default (compiled)
# mode — later `set`s do not stick, and every reads-counter assertion below
# reads 0 — while `-no-compile` shares it correctly. See the defect note in the
# report; head.boru itself only ever passes its flex DOWN, which is sound in both
# modes.

# ----------------------------------------------------------------------------
# 1. Pure fns.
# ----------------------------------------------------------------------------
Test.describe "head-parse-n" [
  Test.test "a plain decimal is accepted" [
    Assert.equal {ok: true n: 10} (Head.parseN "10")
  ]
  Test.test "zero is a legitimate limit, not an error" [
    Assert.equal {ok: true n: 0} (Head.parseN "0")
  ]
  Test.test "leading zeros are fine" [
    Assert.equal {ok: true n: 7} (Head.parseN "007")
  ]
  Test.test "an empty value is rejected" [
    Assert.equal {ok: false n: 0} (Head.parseN "")
  ]
  Test.test "a non-numeric value is rejected" [
    Assert.equal {ok: false n: 0} (Head.parseN "x")
  ]
  Test.test "a trailing suffix is rejected — GNU's 1k is NOT supported" [
    Assert.equal {ok: false n: 0} (Head.parseN "1k")
  ]
  Test.test "a negative value is rejected — GNU's all-but-last-N is NOT supported" [
    Assert.equal {ok: false n: 0} (Head.parseN "-5")
  ]
  Test.test "a float is rejected" [
    Assert.equal {ok: false n: 0} (Head.parseN "1.5")
  ]
  Test.test "internal whitespace is rejected" [
    Assert.equal {ok: false n: 0} (Head.parseN "1 2")
  ]
  Test.test "18 digits still converts exactly" [
    Assert.equal {ok: true n: 123456789012345678} (Head.parseN "123456789012345678")
  ]
  Test.test "19+ digits would overflow, so it clamps to every line" [
    Assert.equal {ok: true n: 999999999999999999} (Head.parseN "99999999999999999999")
  ]
]

Test.describe "head-nflag" [
  Test.test "an absent flag is the default of 10" [
    Assert.equal "10" (Head.nflag {})
  ]
  Test.test "a none value is the default of 10" [
    Assert.equal "10" (Head.nflag {lines: none})
  ]
  Test.test "a string value is returned verbatim" [
    Assert.equal "3" (Head.nflag {lines: "3"})
  ]
  Test.test "a repeated flag collects into a List and the LAST one wins" [
    Assert.equal "2" (Head.nflag {lines: ["5" "2"]})
  ]
  Test.test "an empty List falls back to the default" [
    Assert.equal "10" (Head.nflag {lines: []})
  ]
]

Test.describe "head-chunk-size" [
  Test.test "a small remainder is the whole chunk, so no read is wasted" [
    Assert.equal 10 (Head.chunkSize 10)
  ]
  Test.test "the ceiling caps one loop so a huge -n stays bounded" [
    Assert.equal 8192 (Head.chunkSize 8192)
  ]
  Test.test "past the ceiling it is clamped, and head-pump recurses" [
    Assert.equal 8192 (Head.chunkSize 1000000)
  ]
  Test.test "nothing left to read is a non-positive chunk — head-pump stops" [
    Assert.equal 0 (Head.chunkSize 0)
  ]
]

Test.describe "head-line" [
  Test.test "the terminator IO.read-line stripped is written back" [
    Assert.equal "hello\n" (Head.line "hello")
  ]
  Test.test "an empty line stays empty" [ Assert.equal "\n" (Head.line "") ]
  Test.test "the line is copied verbatim, multi-byte runes included" [
    Assert.equal "日本語 🎉\n" (Head.line "日本語 🎉")
  ]
]

Test.describe "head-label / head-header" [
  Test.test "- is spelled out as standard input" [
    Assert.equal "standard input" (Head.label "-")
  ]
  Test.test "any other name is used as written" [
    Assert.equal "a/b.txt" (Head.label "a/b.txt")
  ]
  Test.test "the first header has no leading blank line" [
    Assert.equal "==> f <==\n" (Head.header "f" true)
  ]
  Test.test "every later header is preceded by a blank line" [
    Assert.equal "\n==> f <==\n" (Head.header "f" false)
  ]
  Test.test "the stdin header uses the spelled-out label" [
    Assert.equal "==> standard input <==\n" (Head.header "-" true)
  ]
]

Test.describe "head-show-headers" [
  Test.test "one operand: no header, as GNU does" [
    Assert.equal false (Head.headers 1 false false)
  ]
  Test.test "no operand (stdin): no header" [
    Assert.equal false (Head.headers 0 false false)
  ]
  Test.test "two operands: headers" [
    Assert.equal true (Head.headers 2 false false)
  ]
  Test.test "-v forces a header on for a single operand" [
    Assert.equal true (Head.headers 1 false true)
  ]
  Test.test "-q suppresses them for many operands" [
    Assert.equal false (Head.headers 5 true false)
  ]
  Test.test "-q beats -v when both are given (see the gaps)" [
    Assert.equal false (Head.headers 5 true true)
  ]
]

Test.describe "head-bool" [
  Test.test "a true flag reads true" [ Assert.equal true (Head.bool {quiet: true} "quiet") ]
  Test.test "a false flag reads false" [ Assert.equal false (Head.bool {quiet: false} "quiet") ]
  Test.test "an absent flag reads false — it does not raise" [
    Assert.equal false (Head.bool {} "quiet")
  ]
  Test.test "a non-Boolean flag value reads false" [
    Assert.equal false (Head.bool {quiet: "yes"} "quiet")
  ]
]

Test.describe "stream-state readers" [
  Test.test "the counters are read back" [
    Assert.equal [3 9 2] [(Head.count {n: 3 reads: 9 shown: 2})
                          (Head.reads {n: 3 reads: 9 shown: 2})
                          (Head.shown {n: 3 reads: 9 shown: 2})]
  ]
  Test.test "missing counters read 0" [
    Assert.equal [0 0 0] [(Head.count {}) (Head.reads {}) (Head.shown {})]
  ]
  Test.test "non-Integer counters read 0" [
    Assert.equal [0 0 0] [(Head.count {n: "x"}) (Head.reads {reads: "x"})
                          (Head.shown {shown: "x"})]
  ]
  Test.test "the done flag is read back" [ Assert.equal true (Head.done {done: true}) ]
  Test.test "a missing done flag reads false" [ Assert.equal false (Head.done {}) ]
  Test.test "a non-Boolean done flag reads false" [
    Assert.equal false (Head.done {done: "yes"})
  ]
  Test.test "a flex state map satisfies the same readers" [
    def st (flex {n: 0 done: false reads: 0 shown: 0})
    Assert.equal [0 0 0 false] [(Head.count st) (Head.reads st) (Head.shown st)
                                (Head.done st)]
  ]
]

Test.describe "head-worse" [
  Test.test "the higher code wins" [ Assert.equal 1 (Head.worse 0 1) ]
  Test.test "in either order" [ Assert.equal 1 (Head.worse 1 0) ]
  Test.test "success stays success" [ Assert.equal 0 (Head.worse 0 0) ]
  Test.test "a usage code dominates a read failure" [ Assert.equal 2 (Head.worse 1 2) ]
]

Test.describe "head-inputs" [
  Test.test "no operand means standard input" [ Assert.equal ["-"] (Head.inputs []) ]
  Test.test "operands pass through unchanged, in order" [
    Assert.equal ["a" "b"] (Head.inputs ["a" "b"])
  ]
  Test.test "an explicit - is left alone" [
    Assert.equal ["a" "-" "b"] (Head.inputs ["a" "-" "b"])
  ]
]

Test.describe "diagnostics" [
  Test.test "a read failure always yields the failure code" [
    Assert.equal 1 (Head.fail "f" "boom")       # the text itself goes to stderr
  ]
  Test.test "a bad -n value is a USAGE error, so code 2" [
    Assert.equal 2 (Head.badN "x")             # the text itself goes to stderr
  ]
]

# ----------------------------------------------------------------------------
# 2. The argv contract — head's own spec, read by the pure half of boru:cli.
# ----------------------------------------------------------------------------
Test.describe "argv" [
  Test.test "an empty argv takes the -n default and no operand" [
    Assert.equal {ok: true flags: {lines: "10" quiet: false verbose: false}
                  args: [] command: none}
                 (Cli.parse (Head.spec) [])
  ]
  Test.test "-n takes the next token as its value" [
    Assert.equal "3" ((Cli.parse (Head.spec) ["-n" "3"]) dot flags dot lines)
  ]
  Test.test "-n3 takes the rest of the cluster" [
    Assert.equal "3" ((Cli.parse (Head.spec) ["-n3"]) dot flags dot lines)
  ]
  Test.test "--lines=3 works too" [
    Assert.equal "3" ((Cli.parse (Head.spec) ["--lines=3"]) dot flags dot lines)
  ]
  Test.test "a repeated -n collects, in argv order" [
    Assert.equal ["5" "2"] ((Cli.parse (Head.spec) ["-n" "5" "-n" "2"]) dot flags dot lines)
  ]
  Test.test "the operands survive the flag" [
    Assert.equal ["f" "g"] ((Cli.parse (Head.spec) ["-n" "2" "f" "g"]) dot args)
  ]
  Test.test "-qv clusters two bools" [
    Assert.equal {lines: "10" quiet: true verbose: true}
                 ((Cli.parse (Head.spec) ["-qv"]) dot flags)
  ]
  Test.test "--no-quiet clears the bool flag" [
    Assert.equal false ((Cli.parse (Head.spec) ["-q" "--no-quiet"]) dot flags dot quiet)
  ]
  Test.test "- stays a POSITIONAL (the stdin convention)" [
    Assert.equal ["-"] ((Cli.parse (Head.spec) ["-n" "2" "-"]) dot args)
  ]
  Test.test "-- ends flag processing, so a later -q is a file name" [
    Assert.equal ["-q"] ((Cli.parse (Head.spec) ["--" "-q"]) dot args)
  ]
  Test.test "a dangling -n is a usage error, not a raise" [
    Assert.equal false ((Cli.parse (Head.spec) ["-n"]) dot ok)
  ]
  Test.test "and it says which flag wanted a value" [
    Assert.equal "flag -n needs a value" ((Cli.parse (Head.spec) ["-n"]) dot err)
  ]
  Test.test "an unknown flag is data, not a raise" [
    Assert.equal false ((Cli.parse (Head.spec) ["-Z"]) dot ok)
  ]
  Test.test "and it names the offender" [
    Assert.equal "unknown flag: -Z" ((Cli.parse (Head.spec) ["-Z"]) dot err)
  ]
  Test.test "min is 0, so no operand is not an arity error" [
    Assert.equal true ((Cli.parse (Head.spec) []) dot ok)
  ]
  Test.test "--help dispatches to the help action" [
    Assert.equal "help" ((Cli.dispatch (Head.spec) ["--help"]) dot action)
  ]
  Test.test "--version prints the name and version" [
    Assert.equal "head 0.1.0\n" ((Cli.dispatch (Head.spec) ["--version"]) dot out)
  ]
  Test.test "a usage error dispatches to code 2" [
    Assert.equal 2 ((Cli.dispatch (Head.spec) ["-Z"]) dot code)
  ]
  Test.test "a usage error writes nothing to stdout" [
    Assert.equal "" ((Cli.dispatch (Head.spec) ["-Z"]) dot out)
  ]
]

# ----------------------------------------------------------------------------
# 3. THE EARLY EXIT — the reason head is in this suite.
#
# `reads` is incremented immediately before every IO.read-line call and never
# anywhere else, so it is the exact number of reads the program performed. Each
# case below pins it to the number a correct head MUST issue; a head that
# slurped, or that read to EOF and then truncated, would fail every one of them
# by thousands.
# ----------------------------------------------------------------------------
Test.describe "early exit" [
  Test.test "-n 2 over a 5000-line file performs EXACTLY 2 reads" [
    (IO.write (make Pathon bigfile) (StringUtil.repeat 5000 "x\n")) drop
    def st (flex {n: 0 done: false reads: 0 shown: 0})
    def rc (Head.one bigfile st 2 false)
    Assert.equal [0 2 2] [rc (Head.count st) (Head.reads st)]
  ]
  Test.test "the cost does not grow with the input: 2 reads again at 20000 lines" [
    (IO.write (make Pathon bigfile) (StringUtil.repeat 20000 "y\n")) drop
    def st (flex {n: 0 done: false reads: 0 shown: 0})
    def rc (Head.one bigfile st 2 false)
    Assert.equal [0 2 2] [rc (Head.count st) (Head.reads st)]
  ]
  Test.test "-n 0 opens the file and performs ZERO reads" [
    def st (flex {n: 0 done: false reads: 0 shown: 0})
    def rc (Head.one bigfile st 0 false)
    Assert.equal [0 0 0] [rc (Head.count st) (Head.reads st)]
  ]
  Test.test "-n 1 performs exactly 1 read" [
    def st (flex {n: 0 done: false reads: 0 shown: 0})
    def rc (Head.one bigfile st 1 false)
    (IO.remove (make Pathon bigfile)) drop
    Assert.equal [0 1 1] [rc (Head.count st) (Head.reads st)]
  ]
  Test.test "a limit landing exactly on the last line skips the EOF read too" [
    (IO.write (make Pathon fixture) "a\nb\nc\n") drop
    def st (flex {n: 0 done: false reads: 0 shown: 0})
    def rc (Head.one fixture st 3 false)
    Assert.equal [0 3 3] [rc (Head.count st) (Head.reads st)]
  ]
  Test.test "a limit past the end costs one extra read — the one that saw EOF" [
    def st (flex {n: 0 done: false reads: 0 shown: 0})
    def rc (Head.one fixture st 10 false)
    Assert.equal [0 3 4] [rc (Head.count st) (Head.reads st)]
  ]
  Test.test "an empty input: one read, no lines, still exit 0" [
    def empty "/tmp/boru-utils-head-test-empty.txt"
    (IO.write (make Pathon empty) "") drop
    def st (flex {n: 0 done: false reads: 0 shown: 0})
    def rc (Head.one empty st 10 false)
    (IO.remove (make Pathon empty)) drop
    Assert.equal [0 0 1] [rc (Head.count st) (Head.reads st)]
  ]
  Test.test "a last line with no terminator is still a line" [
    def nonl "/tmp/boru-utils-head-test-nonl.txt"
    (IO.write (make Pathon nonl) "one\ntwo") drop
    def st (flex {n: 0 done: false reads: 0 shown: 0})
    def rc (Head.one nonl st 10 false)
    (IO.remove (make Pathon nonl)) drop
    Assert.equal [0 2 3] [rc (Head.count st) (Head.reads st)]
  ]
  Test.test "reads accumulate across operands; n restarts for each" [
    def st (flex {n: 0 done: false reads: 0 shown: 0})
    def _1 (Head.one fixture st 2 false)
    def _2 (Head.one fixture st 2 false)
    Assert.equal [2 4] [(Head.count st) (Head.reads st)]
  ]
  Test.test "a failed operand costs no reads and yields 1" [
    def st (flex {n: 0 done: false reads: 0 shown: 0})
    def rc (Head.one missing st 2 false)
    Assert.equal [1 0] [rc (Head.reads st)]
  ]
  Test.test "headers off print nothing and leave `shown` at 0" [
    def st (flex {n: 0 done: false reads: 0 shown: 0})
    def _r (Head.one fixture st 1 false)
    Assert.equal 0 (Head.shown st)
  ]
  Test.test "headers on count one per input, so only the first has no blank line" [
    def st (flex {n: 0 done: false reads: 0 shown: 0})
    def _1 (Head.one fixture st 1 true)
    def _2 (Head.one fixture st 1 true)
    Assert.equal 2 (Head.shown st)
  ]
]

# ----------------------------------------------------------------------------
# 4. The program's exit-code contract.
# ----------------------------------------------------------------------------
Test.describe "exit codes" [
  Test.test "a readable file exits 0" [ Assert.equal 0 (Head.main ["-n" "1" fixture]) ]
  Test.test "the default -n needs no flag at all" [ Assert.equal 0 (Head.main [fixture]) ]
  Test.test "two operands (headers on) still exit 0" [
    Assert.equal 0 (Head.main ["-n" "1" fixture fixture])
  ]
  Test.test "a missing file exits 1" [ Assert.equal 1 (Head.main ["-n" "1" missing]) ]
  Test.test "a directory exits 1 rather than raising" [
    Assert.equal 1 (Head.main ["-n" "1" "/tmp"])
  ]
  Test.test "one bad operand among good ones still exits 1" [
    Assert.equal 1 (Head.main ["-n" "1" fixture missing])
  ]
  Test.test "the bad operand first: the good one is still printed, code is 1" [
    Assert.equal 1 (Head.main ["-n" "1" missing fixture])
  ]
  Test.test "--help exits 0" [ Assert.equal 0 (Head.main ["--help"]) ]
  Test.test "--version exits 0" [ Assert.equal 0 (Head.main ["--version"]) ]
  Test.test "an unknown flag exits 2" [ Assert.equal 2 (Head.main ["-Z"]) ]
  Test.test "a dangling -n exits 2" [ Assert.equal 2 (Head.main ["-n"]) ]
  Test.test "a non-numeric -n exits 2 — before any file is opened" [
    Assert.equal 2 (Head.main ["-n" "x" fixture])
  ]
  Test.test "a negative -n exits 2 (all-but-last-N is not implemented)" [
    Assert.equal 2 (Head.main ["-n" "-5" fixture])
  ]
  Test.test "-n 0 over a real file exits 0 and prints nothing" [
    Assert.equal 0 (Head.main ["-n" "0" fixture])
  ]
  Test.test "-- makes a flag-looking operand a (missing) file, so 1 not 2" [
    Assert.equal 1 (Head.main ["--" "-Z"])
  ]
  Test.test "the fixture is left tidy" [
    (IO.remove (make Pathon fixture)) drop
    Assert.equal false ((IO.stat (make Pathon fixture) {missing: "none"}) is Map)
  ]
]
