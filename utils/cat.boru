# ============================================================================
# cat — concatenate files, or standard input, and write them to standard
# output.
#
#   cat [-n|--number] [-E|--show-ends] [FILE…]
#
# With no FILE, or when FILE is "-", the input is standard input. Input is
# STREAMED one line at a time with IO.read-line — never slurped — so cat works
# on a file larger than memory and on a pipe that is still open, and every
# line is written the moment it has been read.
#
# Exit codes:
#   0  every named input was opened and copied to EOF
#   1  at least one input could not be opened or read; the diagnostic goes to
#      stderr and the remaining operands are still copied
#   2  usage error — unknown flag, missing flag value (from Cli.dispatch)
#
# Structure: every decision is a PURE fn taking its input as parameters
# (cat-bool / cat-count / cat-worse / cat-pad-left / cat-inputs / cat-format /
# cat-next-chunk), and cat-main takes ARGV as a parameter and returns the exit
# code rather than exiting, so tests/cat_test.boru can drive the whole program
# — `boru test` cannot inject an argument vector. Only cat-chunk / cat-pump /
# cat-one / cat-walk / cat-run touch the world.
#
# Three engine defects shaped the code below; each is documented where it bites
# (cat-chunk's missing `break`, cat-main's hand-written shell, and the
# standalone guard at the bottom).
# ============================================================================

import "boru:cli"
import "boru:io"

# ----------------------------------------------------------------------------
# Pure helpers.
# ----------------------------------------------------------------------------

# Read a boolean flag defensively: an absent flag, or one holding something
# that is not a Boolean, reads as false.
def cat-bool fn [[fl:Map k:String] [Boolean] [
  def v (fl get k)
  if (v is Boolean) [v] [false]
]]

# The running line counter out of the stream state, defensively.
def cat-count fn [[st:Map] [Integer] [
  def v (st get "n")
  if (v is Integer) [v] [0]
]]

# The worse (higher) of two exit codes — the walk keeps the worst one seen.
def cat-worse fn [[a:Integer b:Integer] [Integer] [ if (a gt b) [a] [b] ]]

# Right-align to n runes with spaces. n is a fixed layout width (6), so the
# recursion is shallow and bounded.
def cat-pad-left fn [[s:String n:Integer] [String] [
  if ((size s) gte n) [s] [ def r (cat-pad-left (join "" [" " s]) n)  r ]
]]

# No operand at all means standard input, spelled "-", so there is exactly one
# code path downstream.
def cat-inputs fn [[ops:List] [List] [
  if ((size ops) eq 0) [(push "-" [])] [ops]
]]

# One output line, terminator included. -n prefixes the 6-wide right-aligned
# line number and a tab (the GNU layout); -E marks the end of the line with $
# BEFORE the newline, so the two compose as `     1<TAB>text$`.
def cat-format fn [[line:String k:Integer numbered:Boolean ends:Boolean] [String] [
  def body (if ends [(join "" [line "$"])] [line])
  def pre (if numbered [(join "" [(cat-pad-left (convert String k) 6) "\t"])] [""])
  join "" [pre body "\n"]
]]

# The read loop runs in chunks (see cat-chunk); the chunk doubles from 64 up
# to a ceiling of 8192. Ramping keeps the wasted post-EOF reads of the final
# chunk below the number of lines actually read — so a two-line file costs 64
# reads, not 8192 — while the ceiling keeps cat-pump's recursion depth at
# lines/8192 rather than lines.
def cat-next-chunk fn [[m:Integer] [Integer] [ if (m gte 8192) [8192] [(m mul 2)] ]]

# ----------------------------------------------------------------------------
# The streaming read loop. Reads one line, writes one line, repeats; nothing
# is retained, so memory is O(longest line).
#
# DEFECT 1 (see the report): `for` has no unbounded form and the obvious
# `for [0 1000000000] [ … if (line is None) [break] … ]` is wrong here — under
# the tree-walking interpreter (-no-compile) a `break` escapes not only its
# own loop but the rest of the enclosing fn body AND the return value of every
# fn up the call chain, so `def rc (cat-one …)` dies "cannot call `def` — no
# signature matches" and the second file is never read. Wrapping the loop in
# `do [ … ]` contains the break, but `do` in a hot body also refuses bytecode
# compilation, which costs ~30x and turns the read loop superlinear.
#
# So this loop has NO break: it runs a fixed count, ignores reads that come
# back none, and reports how many lines it actually consumed. cat-pump calls
# it until it returns 0. Identical in both run modes, and it compiles.
# ----------------------------------------------------------------------------
def cat-chunk fn [[h:Any st:Map numbered:Boolean ends:Boolean m:Integer] [Integer] [
  def before (cat-count st)
  for [0 m] [
    def line (IO.read-line h)
    if ((line is None) not) [
      def k ((cat-count st) add 1)
      def _n (st set (quote n) k)
      (IO.write (IO.stdout) (cat-format (convert String line) k numbered ends)) drop
    ] []
  ]
  def got ((cat-count st) sub before)
  got
]]

# Drain one open handle to EOF, a chunk at a time. Returns the total number of
# lines emitted so far across every input (the state is shared so that -n
# numbers continuously across files, as GNU cat does).
def cat-pump fn [[h:Any st:Map numbered:Boolean ends:Boolean m:Integer] [Integer] [
  def got (cat-chunk h st numbered ends m)
  if (got eq 0) [(cat-count st)] [
    def r (cat-pump h st numbered ends (cat-next-chunk m))
    r
  ]
]]

# One diagnostic on stderr — never stdout — and the failure exit code.
def cat-fail fn [[name:String msg:String] [Integer] [
  (IO.write (IO.stderr) (join "" ["cat: " name ": " msg "\n"])) drop
  1
]]

# ----------------------------------------------------------------------------
# One operand. "-" is standard input; anything else is opened, streamed and
# closed. An open or read failure (missing file, a directory, a permission
# error) is reported on stderr and yields 1 — cat keeps going with the
# remaining operands, which is the coreutils contract. `do … error` costs a
# bytecode refusal for THIS fn only, and it runs once per operand, not per
# line, so the read loop above stays compiled.
# ----------------------------------------------------------------------------
def cat-one fn [[name:String st:Map numbered:Boolean ends:Boolean] [Integer] [
  if (name eq "-") [
    def a (do [
      def _p (cat-pump (IO.stdin) st numbered ends 64)
      0
    ] error [
      def e end
      def c (cat-fail "-" (e.message))
      c
    ])
    a
  ] [
    def b (do [
      def h (IO.open (make Pathon name))
      def _p (cat-pump h st numbered ends 64)
      IO.close h
      0
    ] error [
      def e end
      def c (cat-fail name (e.message))
      c
    ])
    b
  ]
]]

# Walk the operands in order, carrying the stream state and the worst exit
# code seen.
def cat-walk fn [[names:List i:Integer st:Map numbered:Boolean ends:Boolean acc:Integer] [Integer] [
  if (i gte (size names)) [acc] [
    def rc (cat-one (convert String (names get i)) st numbered ends)
    def r (cat-walk names (i add 1) st numbered ends (cat-worse acc rc))
    r
  ]
]]

# ----------------------------------------------------------------------------
# The spec and the handler.
# ----------------------------------------------------------------------------
def spec {
  name:    "cat"
  version: "0.1.0"
  summary: "concatenate files to standard output"
  flags: [
    {name:"number"    short:"n" kind:"bool" help:"number every output line"}
    {name:"show-ends" short:"E" kind:"bool" help:"mark the end of each line with $"}
  ]
  args: {name:"file" min:0 help:"files to read; - or nothing means standard input"}
}

def cat-run fn [[ctx:Map] [Integer] [
  def fl ctx.flags
  def numbered (cat-bool fl "number")
  def ends (cat-bool fl "show-ends")
  def st (flex {n:0})
  def rc (cat-walk (cat-inputs (ctx.args)) 0 st numbered ends 0)
  rc
]]

# ----------------------------------------------------------------------------
# The whole program, minus the exit — `Cli.dispatch` plus the three lines
# `Cli.main` would have run (design/CLI-PROGRAMS.1.md §2 documents exactly
# this split): print `out`, print `err`, and take the exit code from dispatch
# unless the action is "run", in which case the handler's Integer is the
# status. --help and --version still print and exit 0, a usage error still
# prints to stderr and exits 2.
#
# It takes argv as a PARAMETER, which is what lets tests/cat_test.boru drive
# the whole program — `boru test` cannot inject an argument vector, and this
# fn never calls IO.exit.
#
# DEFECT 2 (see the report) is why the handler is called from here rather than
# handed to `Cli.main`. `Cli.main` invokes its handler from inside the boru:cli
# module, and that costs twice:
#   * under the tree-walking interpreter the handler body cannot see this
#     file's module-level defs at all — `Cli.main (spec) (cat-run/r)` dies
#     "undefined word: cat-bool" under -no-compile, though the bytecode
#     compiler resolves it;
#   * and it puts the whole program in interpreter mode, which for a program
#     whose hot path is a read loop costs ~12x (8000 lines: 8.6s through
#     Cli.main, 0.72s here — measured).
# ----------------------------------------------------------------------------
def cat-main fn [[argv:List] [Integer] [
  def d (Cli.dispatch (spec) argv)
  def _out (if ((d.out) neq "") [(IO.write (IO.stdout) (d.out))] [none])
  def _err (if ((d.err) neq "") [(IO.write (IO.stderr) (d.err))] [none])
  def code (if ((d.action) neq "run") [(d.code)] [(cat-run d)])
  code
]]

# The pure fns, plus the spec and the argv-taking entry point, for the suite:
# a module's private defs are NOT visible to an importer, so anything a test
# touches has to be exported.
export "Cat" {
  bool:       cat-bool/r
  count:      cat-count/r
  worse:      cat-worse/r
  padLeft:    cat-pad-left/r
  inputs:     cat-inputs/r
  format:     cat-format/r
  nextChunk:  cat-next-chunk/r
  fail:       cat-fail/r
  one:        cat-one/r
  main:       cat-main/r
  spec:       spec
}

# ----------------------------------------------------------------------------
# The standalone guard, and the only IO.exit.
#
# tests/cat_test.boru reaches the fns above with `import "./cat.boru"`, and an
# import RUNS the imported file's top level. Unguarded, that would make the
# suite run cat itself: with no operands cat reads standard input, and under
# `boru test` standard input is the runner's own — a real, open stream, so the
# import BLOCKS (verified); and the IO.exit that follows ends the suite file
# before a single case has run ("exited with code 0 before the suite
# finished").
#
# The discriminator is a host capability, not a heuristic: `boru run` installs
# the OS environment view (lang/go/boru.go, Options.Env) and `boru test` does
# not install one at all, so IO.env-all is structurally {} under `boru test`
# and the process environment under `boru run` and in a built binary. The
# argv disjunct closes all but one corner of the remaining gap — see the
# report for the one invocation this does not cover.
# ----------------------------------------------------------------------------
def cat-standalone ((((IO.env-all) size) gt 0) or (((IO.args) size) gt 0))

if cat-standalone [
  def cat-rc (cat-main (IO.args))
  IO.exit cat-rc;
] []
