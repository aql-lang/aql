# ============================================================================
# cut — select fields or characters from each line of the input.
#
#   cut -f LIST [-d DELIM] [-s] [FILE…]
#   cut -c LIST [FILE…]
#
# LIST is a comma-separated list of 1-based indices and ranges, exactly as in
# coreutils: `1`, `1,3-5`, `-3` (from the first), `4-` (to the last). The
# selected items are emitted in INPUT order, each at most once, no matter what
# order or how many times the list names them — `-f3,1` and `-f1,1,3` both
# print field 1 then field 3.
#
# Everything is counted in RUNES, never bytes: `size`, `slice` and
# `StringUtil.split ""` are all rune-indexed, so `-c2` of "日本語" is "本" and
# a multi-byte delimiter (`-d '、'`) is one character, not three.
#
# With no FILE, or when FILE is "-", the input is standard input. Input is
# STREAMED one line at a time with IO.read-line — never slurped — so cut works
# on a file larger than memory and on a pipe that is still open.
#
# -f on a line that does not contain the delimiter passes the line through
# unchanged (the coreutils rule); -s suppresses those lines instead.
#
# Exit codes:
#   0  every named input was opened and processed to EOF
#   1  at least one input could not be opened or read; the diagnostic goes to
#      stderr and the remaining operands are still processed
#   2  usage error — an unknown flag or a missing flag value (from
#      Cli.dispatch), neither or both of -f/-c, a malformed LIST, a delimiter
#      that is not exactly one character, or -d/-s without -f
#
# Structure: every decision is a PURE fn taking its input as parameters
# (cut-digits / cut-num / cut-part / cut-list / cut-in / cut-pick / cut-cat /
# cut-chars / cut-fields / cut-line / cut-opts), and cut-main takes ARGV as a
# parameter and returns the exit code rather than exiting, so
# tests/cut_test.boru can drive the whole program — `boru test` cannot inject an
# argument vector. Only cut-chunk / cut-pump / cut-one / cut-walk / cut-run /
# cut-fail / cut-usage-fail touch the world.
# ============================================================================

import "boru:cli"
import "boru:io"
import "boru:string-util"

# ----------------------------------------------------------------------------
# Small readers, all defensive: a flags map is user data.
# ----------------------------------------------------------------------------

# An absent flag, or one holding something that is not a Boolean, reads false.
def cut-bool fn [[fl:Map k:String] [Boolean] [
  def v (fl get k)
  if (v is Boolean) [v] [false]
]]

# The running line counter out of the stream state.
def cut-count fn [[st:Map] [Integer] [
  def v (st get "n")
  if (v is Integer) [v] [0]
]]

# The worse (higher) of two exit codes — the walk keeps the worst one seen.
def cut-worse fn [[a:Integer b:Integer] [Integer] [ if (a gt b) [a] [b] ]]

# No operand at all means standard input, spelled "-", so there is exactly one
# code path downstream.
def cut-inputs fn [[ops:List] [List] [
  if ((size ops) eq 0) [(push "-" [])] [ops]
]]

# The chunk ramp for the read loop (see cut-chunk): 64 → 128 → … → 8192.
def cut-next-chunk fn [[m:Integer] [Integer] [ if (m gte 8192) [8192] [(m mul 2)] ]]

# A repeated string flag collects into a List (boru:cli's contract), so
# `-f1 -f3` arrives as ["1" "3"]. Comma-joining it gives the union, which is
# what coreutils does with a repeated -f.
def cut-spec-str fn [[v:Any] [String] [
  if (v is List) [ def r (cut-cat v ",")  r ] [
    # An absent flag is None, and `convert String none` does not dispatch. The
    # callers below guard with hasf/hasc so None cannot reach here in the
    # program — but this is one of the small defensive readers, and a reader
    # that raises on the shape it is meant to defend against is not one.
    if (v is None) [""] [(convert String v)]
  ]
]]

# ----------------------------------------------------------------------------
# String building. `join` DROPS empty strings, so it cannot be used to join
# FIELDS with a separator — `join "," ["a" "" "b"]` is "a,b", which loses an
# empty field. cut-cat interleaves the separator itself and only ever calls
# `join ""`, where dropping an empty element is a no-op.
#
# The accumulator is a flex list: an immutable `push` accumulator is O(n²), and
# these run once per line of the input.
# ----------------------------------------------------------------------------
def cut-cat fn [[xs:List sep:String] [String] [
  def out (flex [])
  def n (size xs)
  for [0 n] [
    def _s (if (i gt 0) [(push sep out)] [none])
    def _v (push (convert String (xs get i)) out)
  ]
  def r (join "" out)
  r
]]

# ----------------------------------------------------------------------------
# LIST parsing. A range is the two-element LIST [lo hi], 1-based and inclusive.
# "to the end" is spelled with the sentinel 1000000000 rather than a negative
# marker, so a range is always a pair of ordinary ascending integers — which is
# what lets `sort` order the ranges (list compare is length-then-elementwise,
# so [lo hi] sorts by lo then hi) and lets cut-norm merge them with plain
# arithmetic. No line has 10^9 fields, so the sentinel is invisible.
#
# Errors are DATA — {ok:false err:"…"} — never a raise, so the whole parser is
# testable and a bad list becomes an exit code, not a stack trace.
# ----------------------------------------------------------------------------
def cut-rng fn [[lo:Integer hi:Integer] [List] [ push hi (push lo []) ]]

def cut-ok-rng fn [[lo:Integer hi:Integer] [Map] [
  {ok:true err:""} set (quote lo) lo set (quote hi) hi
]]

def cut-err-rng fn [[msg:String] [Map] [
  {ok:false lo:0 hi:0} set (quote err) msg
]]

def cut-bad-list fn [[msg:String] [Map] [
  {ok:false ranges:[]} set (quote err) msg
]]

# every rune of s is a decimal digit, and s is not empty.
def cut-digit-at fn [[s:String i:Integer] [Boolean] [
  if (i gte (size s)) [true] [
    def c (slice i (i add 1) s)
    if ((StringUtil.indexof c "0123456789") lt 0) [false] [
      def r (cut-digit-at s (i add 1))
      r
    ]
  ]
]]

def cut-digits fn [[s:String] [Boolean] [
  if ((size s) eq 0) [false] [ def r (cut-digit-at s 0)  r ]
]]

# drop leading zeros, keeping at least one rune, so "007" reads as 7 and the
# length test below is not fooled by padding.
def cut-strip0 fn [[s:String] [String] [
  if ((size s) lte 1) [s] [
    if ((slice 0 1 s) neq "0") [s] [ def r (cut-strip0 (slice 1 (size s) s))  r ]
  ]
]]

# a digit string as an Integer, clamped at the 10^9 sentinel so a 40-digit
# index cannot overflow the conversion.
def cut-num fn [[s:String] [Integer] [
  def t (cut-strip0 s)
  if ((size t) gt 9) [1000000000] [(convert Integer t)]
]]

# a single index: "3"
def cut-point fn [[p:String] [Map] [
  if ((cut-digits p) not) [(cut-err-rng (join "" ["invalid list value: " p]))] [
    def n (cut-num p)
    if (n lt 1) [(cut-err-rng "fields and characters are numbered from 1")]
                [(cut-ok-rng n n)]
  ]
]]

# a range: "3-5", "-5" (from the first), "3-" (to the last). p is the original
# text, for the diagnostic.
def cut-span fn [[a:String b:String p:String] [Map] [
  def ea ((size a) eq 0)
  def eb ((size b) eq 0)
  if (ea and eb) [(cut-err-rng "invalid range with no endpoint: -")] [
  if ((ea or (cut-digits a)) not) [(cut-err-rng (join "" ["invalid list value: " p]))] [
  if ((eb or (cut-digits b)) not) [(cut-err-rng (join "" ["invalid list value: " p]))] [
    def lo (if ea [1] [(cut-num a)])
    def hi (if eb [1000000000] [(cut-num b)])
    if (lo lt 1) [(cut-err-rng "fields and characters are numbered from 1")] [
      if (hi lt lo)
        [(cut-err-rng (join "" ["invalid decreasing range: " p]))]
        [(cut-ok-rng lo hi)]
    ]
  ]]]
]]

def cut-part fn [[p:String] [Map] [
  if ((size p) eq 0) [(cut-err-rng "empty item in the list")] [
    def dp (StringUtil.indexof "-" p)
    if (dp lt 0) [ def r (cut-point p)  r ] [
      def a (slice 0 dp p)
      def b (slice (dp add 1) (size p) p)
      def r (cut-span a b p)
      r
    ]
  ]
]]

# The list is a handful of items, so the immutable push accumulator is fine.
# The first bad item wins: the walk short-circuits on ok:false.
def cut-list-at fn [[parts:List i:Integer acc:Map] [Map] [
  if ((acc.ok) not) [acc] [
    if (i gte (size parts)) [acc] [
      def p (cut-part (convert String (parts get i)))
      def nx (if (p.ok)
        [(acc set (quote ranges) (push (cut-rng (p.lo) (p.hi)) (acc.ranges)))]
        [(cut-bad-list (p.err))])
      def r (cut-list-at parts (i add 1) nx)
      r
    ]
  ]
]]

# ----------------------------------------------------------------------------
# Normalization — the step that makes the output order and the de-duplication
# a PROPERTY of the range list rather than a per-item check. `sort` puts the
# ranges in ascending lo order (list compare is elementwise), and cut-merge-at
# fuses every pair that overlaps or merely touches. What comes out is a
# disjoint, ascending, non-adjacent cover, so `-f3,1`, `-f1,1,3` and
# `-f1-2,2-3` all reduce to the one canonical answer, and selection becomes a
# walk of at most a handful of ranges instead of a predicate per item.
# ----------------------------------------------------------------------------
def cut-merge-at fn [[rs:List i:Integer lo:Integer hi:Integer out:List] [List] [
  if (i gte (size rs)) [(push (cut-rng lo hi) out)] [
    def rg (rs get i)
    def a (rg get 0)
    def b (rg get 1)
    if (a lte (hi add 1)) [
      def nh (if (b gt hi) [b] [hi])
      def r (cut-merge-at rs (i add 1) lo nh out)
      r
    ] [
      def r (cut-merge-at rs (i add 1) a b (push (cut-rng lo hi) out))
      r
    ]
  ]
]]

def cut-norm fn [[rs:List] [List] [
  if ((size rs) eq 0) [rs] [
    def ss (sort rs)
    def f0 (ss get 0)
    def r (cut-merge-at ss 1 (f0 get 0) (f0 get 1) [])
    r
  ]
]]

def cut-list fn [[s:String] [Map] [
  if ((size s) eq 0) [(cut-bad-list "the list of fields or characters is empty")] [
    def parts (StringUtil.split "," s {keepEmpty:true})
    def acc (cut-list-at parts 0 {ok:true err:"" ranges:[]})
    if ((acc.ok) not) [acc] [ (acc set (quote ranges) (cut-norm (acc.ranges))) ]
  ]
]]

# ----------------------------------------------------------------------------
# Selection over a NORMALIZED range list. Because the ranges are ascending and
# disjoint, membership stops at the first range that starts past n, and the
# item walk is driven by the RANGES (a bounded loop per range) rather than by
# a predicate call per item — which is what keeps a 4000-character line from
# costing 4000 function calls.
# ----------------------------------------------------------------------------
def cut-in-at fn [[rs:List i:Integer n:Integer] [Boolean] [
  if (i gte (size rs)) [false] [
    def rg (rs get i)
    if (n lt (rg get 0)) [false] [
      if (n lte (rg get 1)) [true] [
        def r (cut-in-at rs (i add 1) n)
        r
      ]
    ]
  ]
]]

def cut-in fn [[rs:List n:Integer] [Boolean] [ def r (cut-in-at rs 0 n)  r ]]

# push xs[lo-1 … min(hi,size)-1] onto out, clamped at both ends.
def cut-pick-rng fn [[xs:List rg:List out:List] [List] [
  def n (size xs)
  def a ((rg get 0) sub 1)
  def hi (rg get 1)
  def b (if (hi gt n) [n] [hi])
  if (a gte b) [out] [
    for [a b] [ def _p (push (xs get i) out) ]
    out
  ]
]]

def cut-pick-at fn [[xs:List rs:List i:Integer out:List] [List] [
  if (i gte (size rs)) [out] [
    def o2 (cut-pick-rng xs (rs get i) out)
    def r (cut-pick-at xs rs (i add 1) o2)
    r
  ]
]]

# the selected elements of xs, 1-based, in input order.
def cut-pick fn [[xs:List rs:List] [List] [
  def out (flex [])
  def r (cut-pick-at xs rs 0 out)
  r
]]

# ----------------------------------------------------------------------------
# The two modes, and the per-line decision. cut-line answers {emit text}:
# `emit:false` is -s suppressing an undelimited line, and is the only way a
# line disappears — a line whose selection is empty still prints, empty, which
# is what coreutils does.
# ----------------------------------------------------------------------------
# NOTE the param names. `emit` is a BUILT-IN word (boru:emitlang's entry point),
# and a fn param that shadows a built-in passes `boru check` with 0 errors and
# runs correctly under the bytecode compiler, then dies at RUNTIME under
# -no-compile with "undef emit: 'emit' is a built-in word and cannot be
# redefined" — the interpreter tears the param binding down with `undef` and
# the built-in refuses. So the map KEYS are emit/text (they are quoted atoms,
# which is safe) and the PARAMS are keep/body.
def cut-out fn [[keep:Boolean body:String] [Map] [
  {} set (quote emit) keep set (quote text) body
]]

# -c never needs the characters as a LIST: a normalized range is a contiguous
# run, so one rune-indexed `slice` per range reproduces it exactly. `slice`
# clamps its end silently, but a NEGATIVE start makes it ignore the end
# entirely (NUR039), so this helper must never see one. It does NOT clamp the
# start itself — `a` is used as computed, and only the end is clamped below.
# The guard is upstream: cut-span and cut-point reject `lo < 1` before any
# range reaches here, so `a` is always >= 0.
def cut-chars-rng fn [[line:String rg:List out:List] [List] [
  def n (size line)
  def a ((rg get 0) sub 1)
  def hi (rg get 1)
  def b (if (hi gt n) [n] [hi])
  if (a gte b) [out] [ def r (push (slice a b line) out)  r ]
]]

def cut-chars-at fn [[line:String rs:List i:Integer out:List] [List] [
  if (i gte (size rs)) [out] [
    def o2 (cut-chars-rng line (rs get i) out)
    def r (cut-chars-at line rs (i add 1) o2)
    r
  ]
]]

def cut-chars fn [[line:String rs:List] [String] [
  def out (flex [])
  def parts (cut-chars-at line rs 0 out)
  def r (join "" parts)
  r
]]

def cut-fields fn [[line:String d:String rs:List only:Boolean] [Map] [
  if ((StringUtil.indexof d line) lt 0) [
    if only [(cut-out false "")] [(cut-out true line)]
  ] [
    def parts (StringUtil.split d line {keepEmpty:true})
    def r (cut-out true (cut-cat (cut-pick parts rs) d))
    r
  ]
]]

def cut-line fn [[line:String mode:String rs:List d:String only:Boolean] [Map] [
  if (mode eq "c") [ (cut-out true (cut-chars line rs)) ] [
    def r (cut-fields line d rs only)
    r
  ]
]]

# ----------------------------------------------------------------------------
# Option validation — pure, so every refusal below is pinned by the suite.
# Yields {ok:true mode ranges delim only err:""} or {ok:false err:"…"}.
# ----------------------------------------------------------------------------
def cut-bad fn [[msg:String] [Map] [
  {ok:false mode:"" ranges:[] delim:"" only:false} set (quote err) msg
]]

def cut-good fn [[mode:String rs:List d:String only:Boolean] [Map] [
  {ok:true err:""} set (quote mode) mode set (quote ranges) rs
                   set (quote delim) d set (quote only) only
]]

def cut-opts fn [[fl:Map] [Map] [
  def fv (fl get "fields")
  def cv (fl get "characters")
  def dv (fl get "delimiter")
  def only (cut-bool fl "only-delimited")
  def hasf ((fv is None) not)
  def hasc ((cv is None) not)
  def hasd ((dv is None) not)
  if (hasf and hasc) [(cut-bad "only one type of list may be specified")] [
  if ((hasf or hasc) not) [(cut-bad "you must specify a list of characters or fields")] [
  if (hasc and hasd) [(cut-bad "an input delimiter may be specified only when operating on fields")] [
  if (hasc and only) [(cut-bad "suppressing non-delimited lines makes sense only when operating on fields")] [
    def dm (if hasd [(cut-spec-str dv)] ["\t"])
    if ((size dm) neq 1) [(cut-bad "the delimiter must be exactly one character")] [
      def raw (if hasf [(cut-spec-str fv)] [(cut-spec-str cv)])
      def lst (cut-list raw)
      if ((lst.ok) not) [(cut-bad (lst.err))] [
        def r (cut-good (if hasf ["f"] ["c"]) (lst.ranges) dm only)
        r
      ]
    ]
  ]]]]
]]

# ----------------------------------------------------------------------------
# The streaming read loop. Reads one line, transforms it, writes it, repeats;
# nothing is retained, so memory is O(longest line).
#
# The loop has NO `break`: under the tree-walking interpreter a `break` escapes
# not only its own loop but the rest of the enclosing fn body and the return
# value of every fn up the call chain (documented in cat.boru), and `do [ … ]`
# — which would contain it — refuses bytecode compilation in a hot body. So
# the chunk runs a fixed count, ignores reads that come back none, and reports
# how many lines it actually consumed; cut-pump calls it until it returns 0.
# The chunk doubles from 64 to a ceiling of 8192, which keeps both the wasted
# post-EOF reads and the recursion depth small.
# ----------------------------------------------------------------------------
def cut-chunk fn [[h:Any st:Map op:Map m:Integer] [Integer] [
  def before (cut-count st)
  def mode op.mode
  def rs op.ranges
  def d op.delim
  def only op.only
  for [0 m] [
    def line (IO.read-line h)
    if ((line is None) not) [
      def _n (st set (quote n) ((cut-count st) add 1))
      def res (cut-line (convert String line) mode rs d only)
      if (res.emit) [ (IO.write (IO.stdout) (join "" [(res.text) "\n"])) drop ] []
    ] []
  ]
  def got ((cut-count st) sub before)
  got
]]

def cut-pump fn [[h:Any st:Map op:Map m:Integer] [Integer] [
  def got (cut-chunk h st op m)
  if (got eq 0) [(cut-count st)] [
    def r (cut-pump h st op (cut-next-chunk m))
    r
  ]
]]

# ----------------------------------------------------------------------------
# Diagnostics — stderr, never stdout — and the exit code that goes with them.
# ----------------------------------------------------------------------------
def cut-fail fn [[name:String msg:String] [Integer] [
  (IO.write (IO.stderr) (join "" ["cut: " name ": " msg "\n"])) drop
  1
]]

def cut-usage-fail fn [[msg:String] [Integer] [
  (IO.write (IO.stderr) (join "" ["cut: " msg "\n"])) drop
  2
]]

# ----------------------------------------------------------------------------
# One operand. "-" is standard input; anything else is opened, streamed and
# closed. An open or read failure is reported on stderr and yields 1 — cut
# keeps going with the remaining operands, which is the coreutils contract.
# `do … error` costs a bytecode refusal for THIS fn only, and it runs once per
# operand rather than once per line, so the read loop above stays compiled.
# ----------------------------------------------------------------------------
def cut-one fn [[name:String st:Map op:Map] [Integer] [
  if (name eq "-") [
    def a (do [
      def _p (cut-pump (IO.stdin) st op 64)
      0
    ] error [
      def e end
      def c (cut-fail "-" (e.message))
      c
    ])
    a
  ] [
    def b (do [
      def h (IO.open (make Pathon name))
      def _p (cut-pump h st op 64)
      IO.close h
      0
    ] error [
      def e end
      def c (cut-fail name (e.message))
      c
    ])
    b
  ]
]]

def cut-walk fn [[names:List i:Integer st:Map op:Map acc:Integer] [Integer] [
  if (i gte (size names)) [acc] [
    def rc (cut-one (convert String (names get i)) st op)
    def r (cut-walk names (i add 1) st op (cut-worse acc rc))
    r
  ]
]]

# ----------------------------------------------------------------------------
# The spec and the handler.
# ----------------------------------------------------------------------------
def spec {
  name:    "cut"
  version: "0.1.0"
  summary: "select fields or characters from each line"
  flags: [
    {name:"fields"         short:"f" kind:"string" value:"LIST"
     help:"select these fields (1-based, e.g. 1,3-5)"}
    {name:"characters"     short:"c" kind:"string" value:"LIST"
     help:"select these characters (1-based, counted in runes)"}
    {name:"delimiter"      short:"d" kind:"string" value:"DELIM"
     help:"the field delimiter, one character (default: TAB)"}
    {name:"only-delimited" short:"s" kind:"bool"
     help:"with -f, drop lines that contain no delimiter"}
  ]
  args: {name:"file" min:0 help:"files to read; - or nothing means standard input"}
}

def cut-run fn [[ctx:Map] [Integer] [
  def op (cut-opts (ctx.flags))
  if ((op.ok) not) [ def bad (cut-usage-fail (op.err))  bad ] [
    def st (flex {n:0})
    def rc (cut-walk (cut-inputs (ctx.args)) 0 st op 0)
    rc
  ]
]]

# ----------------------------------------------------------------------------
# The whole program, minus the exit — `Cli.dispatch` plus the three lines
# `Cli.main` would have run (design/CLI-PROGRAMS.1.md §2 documents exactly this
# split): print `out`, print `err`, and take the exit code from dispatch unless
# the action is "run", in which case the handler's Integer is the status.
# --help and --version still print and exit 0, a usage error still prints to
# stderr and exits 2.
#
# It takes argv as a PARAMETER, which is what lets tests/cut_test.boru drive the
# whole program — `boru test` cannot inject an argument vector — and it never
# calls IO.exit.
#
# The handler is called from HERE rather than handed to `Cli.main` because
# `Cli.main` invokes its handler from inside the boru:cli module, and under the
# tree-walking interpreter (-no-compile) the handler body cannot see this
# file's module-level defs at all: `Cli.main (spec) (cut-run/v)` dies
# "undefined word: cut-opts" under -no-compile even though the bytecode
# compiler resolves it. (The same defect is recorded in cat.boru, grep.boru and
# head.boru.)
# ----------------------------------------------------------------------------
def cut-main fn [[argv:List] [Integer] [
  def d (Cli.dispatch (spec) argv)
  def _out (if ((d.out) neq "") [(IO.write (IO.stdout) (d.out))] [none])
  def _err (if ((d.err) neq "") [(IO.write (IO.stderr) (d.err))] [none])
  def code (if ((d.action) neq "run") [(d.code)] [(cut-run d)])
  code
]]

# The pure fns, plus the spec and the argv-taking entry point, for the suite:
# a module's private defs are NOT visible to an importer, so anything a test
# touches has to be exported.
export "Cut" {
  bool:       cut-bool/v
  count:      cut-count/v
  worse:      cut-worse/v
  inputs:     cut-inputs/v
  nextChunk:  cut-next-chunk/v
  specStr:    cut-spec-str/v
  cat:        cut-cat/v
  digits:     cut-digits/v
  strip0:     cut-strip0/v
  num:        cut-num/v
  part:       cut-part/v
  list:       cut-list/v
  norm:       cut-norm/v
  inRanges:   cut-in/v
  pick:       cut-pick/v
  chars:      cut-chars/v
  fields:     cut-fields/v
  line:       cut-line/v
  opts:       cut-opts/v
  one:        cut-one/v
  main:       cut-main/v
  spec:       spec
}

# ----------------------------------------------------------------------------
# The standalone guard, and the only IO.exit.
#
# tests/cut_test.boru reaches the fns above with `import "./cut.boru"`, and an
# import RUNS the imported file's top level. Unguarded, that would make the
# suite run cut itself, and the IO.exit that follows would end the suite file
# before a single case had run.
#
# The discriminator is a host capability, not a heuristic: `boru run` installs
# the OS environment view (lang/go/boru.go, Options.Env) and `boru test` does
# not install one at all, so IO.env-all is structurally {} under `boru test`
# and the process environment under `boru run` and in a built binary.
# ----------------------------------------------------------------------------
def cut-standalone ((((IO.env-all) size) gt 0) or (((IO.args) size) gt 0))

if cut-standalone [
  def cut-rc (cut-main (IO.args))
  IO.exit cut-rc;
] []
