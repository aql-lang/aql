# ============================================================
# vault_tui.boru — the interactive vault TUI, written in boru on the
# boru:tui + boru:vault surfaces (design/VAULT-TUI-PORT.0.md §4).
#
# The boru port of `boru vault -i`: one Elm-style app — a single
# immutable state map folded by vt-update, rendered by the pure
# vt-view — over the host vault reached through the boru:vault bridge
# words. Screens are DATA on a stack in the state (§4.2): every stack
# entry is {kind …} plus identity fields, folded by per-kind fns
# dispatched with `case`. Navigation is plain list ops on the stack.
#
#   import "boru:vault-tui"
#   def final (VaultTui.run {dark: true})    # blocks until quit
#
# Launched by `boru vault -i --boru`, which registers the terminal and
# vault host backends before importing this module (the caps snapshot
# at import — RegisterHostTui/RegisterHostVault must come first).
#
# Secret hygiene (§5.2): masked inputs for passphrases and secret
# values, a revealed value lives only in the detail screen's map and
# dies on hide/pop, the passphrase field clears on a failed attempt,
# and the launcher drops the returned final state.
# ============================================================

import "boru:tui"
import "boru:vault"
import "boru:math-util"
import "boru:string-util"

# --- small helpers ------------------------------------------------------

def vt-clamp fn [[sel:Integer n:Integer] [Integer] [
  MathUtil.max 0 (MathUtil.min sel (n sub 1))
]]

def vt-last fn [[items:List] [Map] [ items get ((size items) sub 1) ]]

def vt-drop-last fn [[items:List] [List] [ take ((size items) sub 1) items ]]

def vt-replace-at fn [[items:List i:Integer t:Any] [List] [
  flatten [ (take i items) [t] (shed (i add 1) items) ]
]]

def vt-str fn [[v:Any] [String] [
  if (v eq None) [ "" ] [ convert String v ]
]]

# --- theme palette (§4.6) -----------------------------------------------

def vt-pal fn [[dark:Boolean] [Map] [
  if dark [
    { title: {fg: "bright-cyan"  bold: true}  dim: {fg: "grey"}
      crumb: {fg: "bright-blue"}  err: {fg: "bright-red"}  ok: {fg: "green"} }
  ] [
    { title: {fg: "blue"  bold: true}  dim: {fg: "grey"}
      crumb: {fg: "blue"}  err: {fg: "red"}  ok: {fg: "green"} }
  ]
]]

# --- navigation ----------------------------------------------------------

def vt-push fn [[state:Map scr:Map] [Map] [
  state set screens (push scr state.screens)
]]

def vt-pop fn [[state:Map] [Map] [
  if ((size state.screens) lte 1) [ state ] [
    state set screens (vt-drop-last state.screens)
  ]
]]

def vt-top fn [[state:Map] [Map] [ vt-last state.screens ]]

def vt-set-top fn [[state:Map scr:Map] [Map] [
  state set screens (push scr (vt-drop-last state.screens))
]]

def vt-status-line fn [[state:Map text:String bad:Boolean] [Map] [
  state set status {text: text  err: bad}
]]

def vt-fail fn [[state:Map why:String] [Map] [
  vt-status-line state why true
]]

# --- the vault header cache ---------------------------------------------

def vt-vault-fail fn [[state:Map why:String] [Map] [
  vt-status-line (state set vault {ok: false}) why true
]]

def vt-load-vault fn [[state:Map] [Map] [
  do [ state set vault (Vault.status) ]
  error [ dot message  vt-vault-fail state ]
]]

# --- screens as data (§4.2) ---------------------------------------------
# Builders fetch their rows via Vault.* so a reload is just re-running
# the builder. Backend failures fold into text/rows/status rather than
# aborting the app. Raise-capable expressions are def-bound BEFORE any
# map literal (engine gap G8, BORU-SHARP-EDGES.0.md).

def vt-err-text fn [[why:String] [String] [ join "" ["error: " why] ]]

# vt-info-text: the captured CLI panels, by pager name. The handler
# runs with the error on the stack: read its message UNPARENTHESIZED (a
# paren would start a fresh collection context and `dot` would see no
# receiver — gap G10), then feed it to the formatter.
def vt-info-text fn [[name:String] [String] [
  do [
    case name [
      "status"    [ drop Vault.status-text ]
      "audit"     [ drop Vault.audit {} ]
      "history"   [ drop Vault.history ]
      "providers" [ drop Vault.providers-text ]
      "config"    [ drop Vault.config-text ]
      ""
    ]
  ] error [ dot message  vt-err-text ]
]]

def vt-home fn [[] [Map] [
  { kind: "menu"  name: "home"  title: "Home"  sel: 0
    items: ["Secrets" "Access" "Passwords" "Maintenance" "Settings"] }
]]

def vt-maint-menu fn [[] [Map] [
  { kind: "menu"  name: "maintenance"  title: "Maintenance"  sel: 0
    items: ["Verify" "Scan" "History" "Audit"] }
]]

def vt-settings-menu fn [[] [Map] [
  { kind: "menu"  name: "settings"  title: "Settings"  sel: 0
    items: ["Config" "Providers" "Lock" "Unlock"] }
]]

def vt-info-pager fn [[name:String title:String] [Map] [
  def txt (vt-info-text name)
  { kind: "pager"  name: name  title: title
    text: txt  scroll: 0 }
]]

def vt-secrets fn [[] [Map] [
  def rows (do [ Vault.secrets ] error [ drop [] ])
  { kind: "table"  name: "secrets"  title: "Secrets"
    items: rows  cursor: 0  filtering: false  filter: ""
    finput: (Tui.input "" {placeholder: "filter aliases"}) }
]]

def vt-caps fn [[] [Map] [
  def res (do [ Vault.capabilities ] error [ drop {caps: []} ])
  { kind: "rtable"  name: "access"  title: "Access"  rows: res.caps  cursor: 0 }
]]

def vt-cap-cols fn [[] [List] [
  def cols [ {title: "id"  width: 14  key: "id"} {title: "alias"  width: 16  key: "alias"}
             {title: "agent"  width: 12  key: "agent"} {title: "expires"  width: 20  key: "expires-at"}
             {title: "active"  width: 6  key: "active"} ]
  cols
]]

def vt-passwords fn [[] [Map] [
  def rows (do [ Vault.passwords ] error [ drop [] ])
  { kind: "rtable"  name: "passwords"  title: "Passwords"  rows: rows  cursor: 0 }
]]

def vt-pw-cols fn [[] [List] [
  def cols [ {title: "name"  width: 18  key: "name"} {title: "scope"  width: 10  key: "scope"}
             {title: "namespaces"  width: 16  key: "namespaces"} {title: "expires"  width: 20  key: "expires-at"} ]
  cols
]]

def vt-rtable-cols fn [[name:String] [List] [
  if (name eq "access") [ vt-cap-cols ] [ vt-pw-cols ]
]]

def vt-picker fn [[] [Map] [
  def rows (do [ Vault.vaults ] error [ drop [] ])
  { kind: "picker"  name: "vaults"  title: "Vaults"  rows: rows  cursor: 0 }
]]

def vt-picker-cols fn [[] [List] [
  def cols [ {title: "folder"  width: 34  key: "folder"} {title: "suffix"  width: 10  key: "suffix"}
             {title: "backend"  width: 12  key: "backend"} {title: "default"  width: 8  key: "default"}
             {title: "active"  width: 7  key: "active"} ]
  cols
]]

def vt-rrow fn [[cols:List rec:Map] [List] [
  def row (each [ c:Map => [ vt-str (rec get c.key) ] ] cols)
  row
]]

def vt-detail fn [[alias:String] [Map] [
  def found (do [ Vault.secret alias ] error [ drop None ])
  def meta (if (found eq None) [ {} ] [ found ])
  def recs (do [ Vault.recipes alias ] error [ drop [] ])
  # `revealed` is the none VALUE (not the None type literal): a
  # type-literal map value refuses to bytecode-compile even when the map
  # is def-bound (gap G13b, BORU-SHARP-EDGES.0.md §2). none/None compare
  # equal, so the `eq none` reveal toggle below is unaffected.
  { kind: "detail"  name: alias  title: alias  meta: meta
    recipes: recs  rsel: 0  revealed: none }
]]

# --- the form framework (§4.5, the huh replacement) ----------------------
# A form is data: fields carry their own input widgets (focus rides on
# the input), submit is an inert Function [[state] [state']] that reads
# its values from the top screen, arg carries the acted-on alias.

def vt-field fn [[name:String label:String mask:Boolean value:String] [Map] [
  def inp (Tui.input value {mask: mask})
  { name: name  label: label  input: inp }
]]

def vt-focus-field fn [[scr:Map i:Integer on:Boolean] [Map] [
  def f (scr.fields get i)
  def f2 (f set input ((f.input) set focus on))
  scr set fields (vt-replace-at scr.fields i f2)
]]

def vt-form fn [[name:String title:String fields:List submit:Map arg:String] [Map] [
  def scr { kind: "form"  name: name  title: title  fields: fields
            focus: 0  error: ""  submit: submit  arg: arg }
  vt-focus-field scr 0 true
]]

def vt-fval fn [[scr:Map i:Integer] [String] [
  ((scr.fields get i).input).value
]]

def vt-form-fail fn [[state:Map why:String] [Map] [
  def scr (vt-top state)
  vt-set-top state (scr set error why)
]]

def vt-form-move fn [[state:Map delta:Integer] [Map] [
  def scr (vt-top state)
  def next (vt-clamp (scr.focus add delta) (size scr.fields))
  if (next eq scr.focus) [ state ] [
    def s2 (vt-focus-field scr scr.focus false)
    def s3 (vt-focus-field s2 next true)
    vt-set-top state (s3 set focus next)
  ]
]]

def vt-form-edit fn [[state:Map ev:Map] [Map] [
  def scr (vt-top state)
  def f (scr.fields get scr.focus)
  def f2 (f set input (Tui.edit f.input ev))
  vt-set-top state (scr set fields (vt-replace-at scr.fields scr.focus f2))
]]

def vt-form-key fn [[state:Map ev:Map] [Map] [
  def scr (vt-top state)
  def last ((size scr.fields) sub 1)
  case ev.key [
    "esc"   [ drop vt-pop state ]
    "tab"   [ drop vt-form-move state 1 ]
    "down"  [ drop vt-form-move state 1 ]
    "up"    [ drop vt-form-move state -1 ]
    "enter" [ drop
      if (scr.focus lt last) [ vt-form-move state 1 ] [ scr.submit.run state ] ]
    (vt-form-edit state ev)
  ]
]]

# --- passphrase gating (§4.5): with-auth wraps every secret action ------

def vt-pass-fail fn [[state:Map why:String] [Map] [
  # hygiene: the failed passphrase clears in the same update
  def scr (vt-top state)
  def f ((scr.fields get 0) set input (Tui.input "" {mask: true}))
  def s2 (scr set fields (vt-replace-at scr.fields 0 f))
  vt-set-top state ((vt-focus-field s2 0 true) set error why)
]]

def vt-with-auth fn [[state:Map act:Map] [Map] [
  # act is a continuation MAP {run: <fn/r>}: an /r-parked fn does not
  # match a Function-typed param (gap G12, BORU-SHARP-EDGES.0.md),
  # so continuations travel inside maps and dispatch via dot-access
  def gate (do [ (Vault.needs-passphrase) and ((Vault.authed) not) ]
            error [ drop false ])
  if gate [
    def fields [ (vt-field "pass" "vault passphrase" true "") ]
    def scr ((vt-form "passphrase" "Passphrase" fields {run: vt-pass-run/r} "") set then act)
    vt-push state scr
  ] [ act.run state ]
]]

def vt-pass-run fn [[state:Map] [Map] [
  def scr (vt-top state)
  def pass (vt-fval scr 0)
  def act scr.then
  do [ (Vault.authenticate pass) drop
       act.run (vt-pop state) ]
  error [ dot message  vt-pass-fail state ]
]]

# --- op plumbing ---------------------------------------------------------

def vt-reload-top fn [[state:Map] [Map] [
  def scr (vt-top state)
  case scr.kind [
    "table"  [ drop
      def fresh (vt-secrets)
      def kept ((fresh set filter (scr.filter)) set finput (scr.finput))
      vt-set-top state (kept set cursor
        (vt-clamp scr.cursor (size (vt-visible kept.items scr.filter)))) ]
    "detail" [ drop vt-set-top state (vt-detail scr.name) ]
    "rtable" [ drop
      def fresh (if (scr.name eq "access") [ vt-caps ] [ vt-passwords ])
      vt-set-top state (fresh set cursor (vt-clamp scr.cursor (size fresh.rows))) ]
    "picker" [ drop
      def fresh (vt-picker)
      vt-set-top state (fresh set cursor (vt-clamp scr.cursor (size fresh.rows))) ]
    "pager"  [ drop
      if (scr.name eq "granted") [ state ]
        [ vt-set-top state (vt-info-pager scr.name scr.title) ] ]
    state
  ]
]]

# vt-after-op: pop the form, refresh the vault header + the revealed
# screen, report. Every mutation lands here.
def vt-after-op fn [[state:Map msg:String] [Map] [
  vt-status-line (vt-reload-top (vt-load-vault (vt-pop state))) msg false
]]

# --- the secrets table ---------------------------------------------------

def vt-visible fn [[items:List flt:String] [List] [
  if (flt eq "") [ items ] [
    filter [ dot name  StringUtil.lower  StringUtil.contains (StringUtil.lower flt) ] items
  ]
]]

def vt-secret-cols fn [[] [List] [
  def cols [ {title: "alias"  width: 24} {title: "provider"  width: 14}
             {title: "namespace"  width: 14} {title: "expires"  width: 20} ]
  cols
]]

def vt-alias-row fn [[a:Map] [List] [
  # def-bind the row: a bare list literal returned from a fn evaluates
  # LAZILY, after body teardown, when `a` is gone (gap G11,
  # BORU-SHARP-EDGES.0.md) — def snapshots it eagerly
  def row [ (vt-str a.name) (vt-str a.provider) (vt-str a.namespace) (vt-str a.expires-at) ]
  row
]]

def vt-open-add fn [[state:Map] [Map] [
  def d state.add-defaults
  def fields [ (vt-field "alias" "alias" false "")
               (vt-field "value" "secret value" true "")
               (vt-field "provider" "provider" false (vt-str d.provider))
               (vt-field "namespace" "namespace" false (vt-str d.namespace))
               (vt-field "expiry" "expiry (optional)" false (vt-str d.expiry)) ]
  vt-push state (vt-form "add" "Add secret" fields {run: vt-add-submit/r} "")
]]

def vt-add-submit fn [[state:Map] [Map] [
  def scr (vt-top state)
  def alias (vt-fval scr 0)
  def value (vt-fval scr 1)
  def provider (vt-fval scr 2)
  def namespace (vt-fval scr 3)
  def expiry (vt-fval scr 4)
  if (alias eq "") [ vt-form-fail state "alias is required" ] [
    if (value eq "") [ vt-form-fail state "value is required" ] [
      do [ Vault.add { alias: alias  value: value  provider: provider
                       namespace: namespace  expiry: expiry }
           def st2 (state set add-defaults
             {provider: provider  namespace: namespace  expiry: expiry})
           vt-after-op st2 (join "" ["added " alias]) ]
      error [ dot message  vt-form-fail state ]
    ]
  ]
]]

def vt-table-key fn [[state:Map ev:Map] [Map] [
  def scr (vt-top state)
  if scr.filtering [
    case ev.key [
      "esc"   [ drop vt-set-top state ((scr set filtering false)
                  set finput (Tui.input scr.filter {placeholder: "filter aliases"})) ]
      "enter" [ drop vt-set-top state (((scr set filtering false)
                  set filter ((scr.finput).value)) set cursor 0) ]
      (vt-set-top state (scr set finput (Tui.edit scr.finput ev)))
    ]
  ] [
    def n (size (vt-visible scr.items scr.filter))
    case ev.key [
      "up"    [ drop vt-set-top state (scr set cursor (vt-clamp (scr.cursor sub 1) n)) ]
      "down"  [ drop vt-set-top state (scr set cursor (vt-clamp (scr.cursor add 1) n)) ]
      "/"     [ drop vt-set-top state (scr set filtering true) ]
      "a"     [ drop vt-with-auth state {run: vt-open-add/r} ]
      "enter" [ drop
        if (n eq 0) [ state ] [
          vt-push state (vt-detail ((vt-visible scr.items scr.filter) get scr.cursor).name) ] ]
      state
    ]
  ]
]]

# --- the secret detail page ----------------------------------------------

def vt-do-reveal fn [[state:Map] [Map] [
  def scr (vt-top state)
  do [ def v (Vault.reveal scr.name)
       vt-set-top state (scr set revealed v) ]
  error [ dot message  vt-fail state ]
]]

def vt-copy-recipe fn [[state:Map] [Map] [
  def scr (vt-top state)
  if ((size scr.recipes) eq 0) [ state ] [
    def rec (scr.recipes get scr.rsel)
    do [ def label (Vault.copy rec.cmd)
         vt-status-line state (join "" ["copied via " label]) false ]
    error [ dot message  vt-fail state ]
  ]
]]

def vt-open-rotate fn [[state:Map] [Map] [
  def alias (vt-top state).name
  def fields [ (vt-field "value" "new secret value" true "") ]
  vt-push state (vt-form "rotate" (join "" ["Rotate " alias]) fields {run: vt-rotate-submit/r} alias)
]]

def vt-rotate-submit fn [[state:Map] [Map] [
  def scr (vt-top state)
  def value (vt-fval scr 0)
  if (value eq "") [ vt-form-fail state "value is required" ] [
    do [ Vault.rotate {alias: (scr.arg)  value: value}
         vt-after-op state (join "" ["rotated " scr.arg]) ]
    error [ dot message  vt-form-fail state ]
  ]
]]

def vt-open-rename fn [[state:Map] [Map] [
  def alias (vt-top state).name
  def fields [ (vt-field "to" "new alias" false "") ]
  vt-push state (vt-form "rename" (join "" ["Rename " alias]) fields {run: vt-rename-submit/r} alias)
]]

def vt-rename-submit fn [[state:Map] [Map] [
  def scr (vt-top state)
  def to (vt-fval scr 0)
  if (to eq "") [ vt-form-fail state "new alias is required" ] [
    do [ Vault.rename {from: (scr.arg)  to: to}
         # the detail beneath names the OLD alias — retarget it
         def popped (vt-pop state)
         def st2 (vt-set-top popped (vt-detail to))
         vt-status-line (vt-load-vault st2) (join "" ["renamed to " to]) false ]
    error [ dot message  vt-form-fail state ]
  ]
]]

def vt-open-expiry fn [[state:Map] [Map] [
  def alias (vt-top state).name
  def fields [ (vt-field "when" "expiry (empty clears)" false "") ]
  vt-push state (vt-form "expiry" (join "" ["Expiry for " alias]) fields {run: vt-expiry-submit/r} alias)
]]

def vt-expiry-submit fn [[state:Map] [Map] [
  def scr (vt-top state)
  def when (vt-fval scr 0)
  do [ (if (when eq "")
        [ Vault.clear-expiry scr.arg ]
        [ Vault.set-expiry scr.arg when ])
       vt-after-op state "expiry updated" ]
  error [ dot message  vt-form-fail state ]
]]

def vt-open-delete fn [[state:Map] [Map] [
  def alias (vt-top state).name
  def fields [ (vt-field "confirm" (join "" ["type " alias " to confirm"]) false "") ]
  vt-push state (vt-form "delete" (join "" ["Delete " alias]) fields {run: vt-delete-submit/r} alias)
]]

def vt-delete-submit fn [[state:Map] [Map] [
  def scr (vt-top state)
  if ((vt-fval scr 0) eq scr.arg) [
    do [ Vault.remove scr.arg
         # pop the detail as well — its alias is gone
         vt-after-op (vt-pop state) (join "" ["removed " scr.arg]) ]
    error [ dot message  vt-form-fail state ]
  ] [ vt-form-fail state "confirmation does not match" ]
]]

def vt-open-grant fn [[state:Map] [Map] [
  def alias (vt-top state).name
  def fields [ (vt-field "agent" "agent (optional)" false "")
               (vt-field "ttl" "ttl (e.g. 2h, optional)" false "") ]
  vt-push state (vt-form "grant" (join "" ["Grant for " alias]) fields {run: vt-grant-submit/r} alias)
]]

def vt-grant-submit fn [[state:Map] [Map] [
  def scr (vt-top state)
  def agent (vt-fval scr 0)
  def ttl (vt-fval scr 1)
  do [ def out (Vault.grant {alias: (scr.arg)  agent: agent  ttl: ttl})
       def st2 (vt-reload-top (vt-load-vault (vt-pop state)))
       vt-push (vt-status-line st2 "capability granted — token shown once" false)
               {kind: "pager"  name: "granted"  title: "Granted"  text: out  scroll: 0} ]
  error [ dot message  vt-form-fail state ]
]]

# --- maintenance operations ----------------------------------------------

def vt-verify-pager fn [[state:Map prune:Boolean] [Map] [
  do [ def res (Vault.verify {prune: prune})
       def txt (if res.ok [res.text] [join "\n" [res.text "" "(verify reported problems)"]])
       vt-push state {kind: "pager"  name: "verify"  title: "Verify"  text: txt  scroll: 0} ]
  error [ dot message  vt-fail state ]
]]

def vt-open-scan fn [[state:Map] [Map] [
  def fields [ (vt-field "paths" "paths to scan (space-separated, . default)" false ".") ]
  vt-push state (vt-form "scan" "Scan for leaks" fields {run: vt-scan-submit/r} "")
]]

def vt-scan-submit fn [[state:Map] [Map] [
  def scr (vt-top state)
  def raw (vt-fval scr 0)
  def paths (filter [ x:String => [(x eq "") not] ] (StringUtil.split " " raw))
  do [ def txt (Vault.scan (if ((size paths) eq 0) [["."]] [paths]))
       vt-push (vt-pop state) {kind: "pager"  name: "scan"  title: "Scan"  text: txt  scroll: 0} ]
  error [ dot message  vt-form-fail state ]
]]

# --- settings operations -------------------------------------------------

def vt-open-config-set fn [[state:Map] [Map] [
  def fields [ (vt-field "key" "config key (e.g. namespace.default)" false "")
               (vt-field "value" "value" false "") ]
  vt-push state (vt-form "config-set" "Set config" fields {run: vt-config-set-submit/r} "")
]]

def vt-config-set-submit fn [[state:Map] [Map] [
  def scr (vt-top state)
  def k (vt-fval scr 0)
  def v (vt-fval scr 1)
  if (k eq "") [ vt-form-fail state "key is required" ] [
    do [ Vault.config-set k v
         def st2 (vt-reload-top (vt-load-vault (vt-pop state)))
         vt-status-line st2 (join "" ["set " k]) false ]
    error [ dot message  vt-form-fail state ]
  ]
]]

def vt-open-config-unset fn [[state:Map] [Map] [
  def fields [ (vt-field "key" "config key to unset" false "") ]
  vt-push state (vt-form "config-unset" "Unset config" fields {run: vt-config-unset-submit/r} "")
]]

def vt-config-unset-submit fn [[state:Map] [Map] [
  def scr (vt-top state)
  def k (vt-fval scr 0)
  if (k eq "") [ vt-form-fail state "key is required" ] [
    do [ Vault.config-unset k
         def st2 (vt-reload-top (vt-load-vault (vt-pop state)))
         vt-status-line st2 (join "" ["unset " k]) false ]
    error [ dot message  vt-form-fail state ]
  ]
]]

def vt-config-key fn [[state:Map ev:Map] [Map] [
  # the config pager gains set/unset action keys
  case ev.key [
    "s" [ drop vt-with-auth state {run: vt-open-config-set/r} ]
    "x" [ drop vt-with-auth state {run: vt-open-config-unset/r} ]
    (vt-pager-key state ev)
  ]
]]

# --- access: grant (from the table) + revoke -----------------------------

def vt-open-access-grant fn [[state:Map] [Map] [
  def fields [ (vt-field "alias" "secret alias" false "")
               (vt-field "agent" "agent (optional)" false "")
               (vt-field "ttl" "ttl (e.g. 2h, optional)" false "") ]
  vt-push state (vt-form "grant" "Grant capability" fields {run: vt-access-grant-submit/r} "")
]]

def vt-access-grant-submit fn [[state:Map] [Map] [
  def scr (vt-top state)
  def alias (vt-fval scr 0)
  def agent (vt-fval scr 1)
  def ttl (vt-fval scr 2)
  if (alias eq "") [ vt-form-fail state "alias is required" ] [
    do [ def out (Vault.grant {alias: alias  agent: agent  ttl: ttl})
         def st2 (vt-reload-top (vt-load-vault (vt-pop state)))
         vt-push (vt-status-line st2 "capability granted — token shown once" false)
                 {kind: "pager"  name: "granted"  title: "Granted"  text: out  scroll: 0} ]
    error [ dot message  vt-form-fail state ]
  ]
]]

def vt-open-revoke fn [[state:Map] [Map] [
  def scr (vt-top state)
  if ((size scr.rows) eq 0) [ vt-fail state "no capabilities to revoke" ] [
    def id ((scr.rows get scr.cursor).id)
    def fields [ (vt-field "confirm" (join "" ["type " id " to revoke"]) false "") ]
    vt-push state (vt-form "revoke" (join "" ["Revoke " id]) fields {run: vt-revoke-submit/r} id)
  ]
]]

def vt-revoke-submit fn [[state:Map] [Map] [
  def scr (vt-top state)
  if ((vt-fval scr 0) eq scr.arg) [
    do [ Vault.revoke scr.arg
         vt-after-op state (join "" ["revoked " scr.arg]) ]
    error [ dot message  vt-form-fail state ]
  ] [ vt-form-fail state "confirmation does not match" ]
]]

# --- passwords: add · remove · revoke-temp -------------------------------

def vt-open-pw-add fn [[state:Map] [Map] [
  def fields [ (vt-field "name" "slot name" false "")
               (vt-field "pass" "password" true "")
               (vt-field "scope" "scope (admin/read/write/move)" false "read")
               (vt-field "ttl" "ttl (optional, e.g. 8h)" false "") ]
  vt-push state (vt-form "pw-add" "Add password slot" fields {run: vt-pw-add-submit/r} "")
]]

def vt-pw-add-submit fn [[state:Map] [Map] [
  def scr (vt-top state)
  def name (vt-fval scr 0)
  def pass (vt-fval scr 1)
  def scope (vt-fval scr 2)
  def ttl (vt-fval scr 3)
  if (name eq "") [ vt-form-fail state "name is required" ] [
    if (pass eq "") [ vt-form-fail state "password is required" ] [
      do [ Vault.password-add {name: name  pass: pass  scope: scope  ttl: ttl}
           vt-after-op state (join "" ["added slot " name]) ]
      error [ dot message  vt-form-fail state ]
    ]
  ]
]]

def vt-open-pw-remove fn [[state:Map] [Map] [
  def scr (vt-top state)
  if ((size scr.rows) eq 0) [ vt-fail state "no slots to remove" ] [
    def name ((scr.rows get scr.cursor).name)
    def fields [ (vt-field "confirm" (join "" ["type " name " to remove"]) false "") ]
    vt-push state (vt-form "pw-remove" (join "" ["Remove " name]) fields {run: vt-pw-remove-submit/r} name)
  ]
]]

def vt-pw-remove-submit fn [[state:Map] [Map] [
  def scr (vt-top state)
  if ((vt-fval scr 0) eq scr.arg) [
    do [ Vault.password-remove scr.arg
         vt-after-op state (join "" ["removed slot " scr.arg]) ]
    error [ dot message  vt-form-fail state ]
  ] [ vt-form-fail state "confirmation does not match" ]
]]

def vt-pw-revoke-temp fn [[state:Map] [Map] [
  # a DIRECT table action (no form was pushed) — reload in place, never
  # pop (vt-after-op pops, which is only right after a form submit)
  do [ def n (Vault.temp-password-count)
       if (n eq 0) [ vt-fail state "no temporary passwords" ] [
         (Vault.password-revoke-temp)
         vt-status-line (vt-reload-top (vt-load-vault state))
                        (join "" ["revoked " (vt-str n) " temporary password(s)"]) false ] ]
  error [ dot message  vt-fail state ]
]]

# --- vault picker actions ------------------------------------------------

def vt-picker-switch fn [[state:Map] [Map] [
  def scr (vt-top state)
  if ((size scr.rows) eq 0) [ vt-fail state "no vaults" ] [
    def row (scr.rows get scr.cursor)
    do [ Vault.switch {folder: (row.folder)  suffix: (row.suffix)}
         # a switched vault gets a FRESH home stack (auth is per-vault)
         def home-state (state set screens [ (vt-home) ])
         vt-status-line (vt-load-vault home-state)
                        (join "" ["switched to " row.folder]) false ]
    error [ dot message  vt-fail state ]
  ]
]]

def vt-picker-default fn [[state:Map] [Map] [
  def scr (vt-top state)
  if ((size scr.rows) eq 0) [ vt-fail state "no vaults" ] [
    def row (scr.rows get scr.cursor)
    do [ Vault.switch {folder: (row.folder)  suffix: (row.suffix)}
         (Vault.set-default)
         vt-status-line (vt-reload-top (vt-load-vault state))
                        (join "" ["default set to " row.folder]) false ]
    error [ dot message  vt-fail state ]
  ]
]]

def vt-open-new-vault fn [[state:Map] [Map] [
  def fields [ (vt-field "folder" "new vault folder" false "")
               (vt-field "backend" "backend (file/keychain/…)" false "file")
               (vt-field "pass" "passphrase (optional)" true "") ]
  vt-push state (vt-form "new-vault" "New vault" fields {run: vt-new-vault-submit/r} "")
]]

def vt-new-vault-submit fn [[state:Map] [Map] [
  def scr (vt-top state)
  def folder (vt-fval scr 0)
  def backend (vt-fval scr 1)
  def pass (vt-fval scr 2)
  if (folder eq "") [ vt-form-fail state "folder is required" ] [
    do [ Vault.create {folder: folder  backend: backend  pass: pass}
         # create switches the active vault: fresh home stack
         def home-state ((vt-pop state) set screens [ (vt-home) ])
         vt-status-line (vt-load-vault home-state) (join "" ["created " folder]) false ]
    error [ dot message  vt-form-fail state ]
  ]
]]

def vt-open-prune fn [[state:Map] [Map] [
  def scr (vt-top state)
  if ((size scr.rows) eq 0) [ vt-fail state "no vaults" ] [
    def row (scr.rows get scr.cursor)
    def fields [ (vt-field "confirm" (join "" ["type " row.folder " to prune"]) false "") ]
    def sc2 (vt-form "prune" (join "" ["Prune " row.folder]) fields {run: vt-prune-submit/r} row.folder)
    vt-push state (sc2 set psuffix row.suffix)
  ]
]]

def vt-prune-submit fn [[state:Map] [Map] [
  def scr (vt-top state)
  if ((vt-fval scr 0) eq scr.arg) [
    do [ Vault.prune-index {folder: (scr.arg)  suffix: (scr.psuffix)}
         vt-after-op state (join "" ["pruned " scr.arg]) ]
    error [ dot message  vt-form-fail state ]
  ] [ vt-form-fail state "confirmation does not match" ]
]]

def vt-picker-key fn [[state:Map ev:Map] [Map] [
  def scr (vt-top state)
  def n (size scr.rows)
  case ev.key [
    "up"    [ drop vt-set-top state (scr set cursor (vt-clamp (scr.cursor sub 1) n)) ]
    "down"  [ drop vt-set-top state (scr set cursor (vt-clamp (scr.cursor add 1) n)) ]
    "enter" [ drop vt-picker-switch state ]
    "n"     [ drop vt-open-new-vault state ]
    "d"     [ drop vt-picker-default state ]
    "D"     [ drop vt-open-prune state ]
    state
  ]
]]

# --- rtable key routing --------------------------------------------------

def vt-access-key fn [[state:Map ev:Map] [Map] [
  case ev.key [
    "g" [ drop vt-with-auth state {run: vt-open-access-grant/r} ]
    "D" [ drop vt-with-auth state {run: vt-open-revoke/r} ]
    state
  ]
]]

def vt-password-key fn [[state:Map ev:Map] [Map] [
  case ev.key [
    "a" [ drop vt-with-auth state {run: vt-open-pw-add/r} ]
    "D" [ drop vt-with-auth state {run: vt-open-pw-remove/r} ]
    "t" [ drop vt-with-auth state {run: vt-pw-revoke-temp/r} ]
    state
  ]
]]

def vt-rtable-key fn [[state:Map ev:Map] [Map] [
  def scr (vt-top state)
  def n (size scr.rows)
  case ev.key [
    "up"   [ drop vt-set-top state (scr set cursor (vt-clamp (scr.cursor sub 1) n)) ]
    "down" [ drop vt-set-top state (scr set cursor (vt-clamp (scr.cursor add 1) n)) ]
    (if (scr.name eq "access") [ vt-access-key state ev ] [ vt-password-key state ev ])
  ]
]]

def vt-detail-key fn [[state:Map ev:Map] [Map] [
  def scr (vt-top state)
  def n (size scr.recipes)
  case ev.key [
    "up"   [ drop vt-set-top state (scr set rsel (vt-clamp (scr.rsel sub 1) n)) ]
    "down" [ drop vt-set-top state (scr set rsel (vt-clamp (scr.rsel add 1) n)) ]
    "c"    [ drop vt-copy-recipe state ]
    "r"    [ drop
      if ((scr.revealed) eq none)
        [ vt-with-auth state {run: vt-do-reveal/r} ]
        [ vt-set-top state (scr set revealed none) ] ]
    "R"    [ drop vt-with-auth state {run: vt-open-rotate/r} ]
    "m"    [ drop vt-with-auth state {run: vt-open-rename/r} ]
    "e"    [ drop vt-with-auth state {run: vt-open-expiry/r} ]
    "D"    [ drop vt-with-auth state {run: vt-open-delete/r} ]
    "g"    [ drop vt-with-auth state {run: vt-open-grant/r} ]
    state
  ]
]]

# --- update: routing (§4.3) ----------------------------------------------

def vt-home-open fn [[state:Map item:String] [Map] [
  case item [
    "Secrets"     [ drop vt-push state (vt-secrets) ]
    "Access"      [ drop vt-push state (vt-caps) ]
    "Passwords"   [ drop vt-push state (vt-passwords) ]
    "Maintenance" [ drop vt-push state (vt-maint-menu) ]
    "Settings"    [ drop vt-push state (vt-settings-menu) ]
    state
  ]
]]

def vt-maint-open fn [[state:Map item:String] [Map] [
  case item [
    "Verify"  [ drop vt-verify-pager state false ]
    "Scan"    [ drop vt-open-scan state ]
    "History" [ drop vt-push state (vt-info-pager "history" "History") ]
    "Audit"   [ drop vt-push state (vt-info-pager "audit" "Audit") ]
    state
  ]
]]

def vt-settings-open fn [[state:Map item:String] [Map] [
  case item [
    "Config"    [ drop vt-push state (vt-info-pager "config" "Config") ]
    "Providers" [ drop vt-push state (vt-info-pager "providers" "Providers") ]
    "Lock"      [ drop vt-lock-op state true ]
    "Unlock"    [ drop vt-lock-op state false ]
    state
  ]
]]

def vt-menu-key fn [[state:Map ev:Map] [Map] [
  def scr (vt-top state)
  case ev.key [
    "up"    [ drop vt-set-top state (scr set sel (vt-clamp (scr.sel sub 1) (size scr.items))) ]
    "down"  [ drop vt-set-top state (scr set sel (vt-clamp (scr.sel add 1) (size scr.items))) ]
    "enter" [ drop
      def item (scr.items get scr.sel)
      case scr.name [
        "home"        [ drop vt-home-open state item ]
        "maintenance" [ drop vt-maint-open state item ]
        "settings"    [ drop vt-settings-open state item ]
        state
      ] ]
    state
  ]
]]

def vt-pager-key fn [[state:Map ev:Map] [Map] [
  def scr (vt-top state)
  case ev.key [
    "up"   [ drop vt-set-top state (scr set scroll (MathUtil.max 0 (scr.scroll sub 1))) ]
    "down" [ drop vt-set-top state (scr set scroll (scr.scroll add 1)) ]
    state
  ]
]]

def vt-screen-key fn [[state:Map ev:Map] [Map] [
  case (vt-top state).kind [
    "menu"   [ drop vt-menu-key state ev ]
    "pager"  [ drop
      if ((vt-top state).name eq "config") [ vt-config-key state ev ] [ vt-pager-key state ev ] ]
    "table"  [ drop vt-table-key state ev ]
    "rtable" [ drop vt-rtable-key state ev ]
    "picker" [ drop vt-picker-key state ev ]
    "detail" [ drop vt-detail-key state ev ]
    "form"   [ drop vt-form-key state ev ]
    state
  ]
]]

# --- the `:` command palette (the runPalette table) ----------------------

def vt-pop-to-root fn [[state:Map] [Map] [
  state set screens (take 1 state.screens)
]]

def vt-palette-closed fn [[] [Map] [
  # def-bind before returning: a bare computed-map TAIL is a deferred
  # residual the bytecode compiler refuses ("unknown provenance"); a map
  # CONSUMED in-frame (bound + returned) records an OpMakeMap and
  # compiles (BORU-SHARP-EDGES.0.md, the same G8/G11 idiom)
  def m { open: false  input: (Tui.input "" {placeholder: ":command"}) }
  m
]]

def vt-nav-pager fn [[state:Map name:String title:String] [Map] [
  vt-push (vt-pop-to-root state) (vt-info-pager name title)
]]

def vt-lock-op fn [[state:Map lockit:Boolean] [Map] [
  do [ (if lockit [ Vault.lock ] [ Vault.unlock ])
       vt-status-line (vt-reload-top (vt-load-vault state))
                      (if lockit ["locked"] ["unlocked"]) false ]
  error [ dot message  vt-fail state ]
]]

def vt-run-palette fn [[state:Map cmd:String] [Map] [
  case cmd [
    ""             [ drop state ]
    "secrets"      [ drop vt-push (vt-pop-to-root state) (vt-secrets) ]
    "secret"       [ drop vt-push (vt-pop-to-root state) (vt-secrets) ]
    "s"            [ drop vt-push (vt-pop-to-root state) (vt-secrets) ]
    "access"       [ drop vt-push (vt-pop-to-root state) (vt-caps) ]
    "caps"         [ drop vt-push (vt-pop-to-root state) (vt-caps) ]
    "capabilities" [ drop vt-push (vt-pop-to-root state) (vt-caps) ]
    "passwords"    [ drop vt-push (vt-pop-to-root state) (vt-passwords) ]
    "password"     [ drop vt-push (vt-pop-to-root state) (vt-passwords) ]
    "pw"           [ drop vt-push (vt-pop-to-root state) (vt-passwords) ]
    "maintenance"  [ drop vt-push (vt-pop-to-root state) (vt-maint-menu) ]
    "maint"        [ drop vt-push (vt-pop-to-root state) (vt-maint-menu) ]
    "settings"     [ drop vt-push (vt-pop-to-root state) (vt-settings-menu) ]
    "set"          [ drop vt-push (vt-pop-to-root state) (vt-settings-menu) ]
    "vaults"       [ drop vt-push (vt-pop-to-root state) (vt-picker) ]
    "vault"        [ drop vt-push (vt-pop-to-root state) (vt-picker) ]
    "folder"       [ drop vt-push (vt-pop-to-root state) (vt-picker) ]
    "folders"      [ drop vt-push (vt-pop-to-root state) (vt-picker) ]
    "switch"       [ drop vt-push (vt-pop-to-root state) (vt-picker) ]
    "status"       [ drop vt-push state (vt-info-pager "status" "Status") ]
    "audit"        [ drop vt-push state (vt-info-pager "audit" "Audit") ]
    "history"      [ drop vt-push state (vt-info-pager "history" "History") ]
    "providers"    [ drop vt-push state (vt-info-pager "providers" "Providers") ]
    "config"       [ drop vt-push state (vt-info-pager "config" "Config") ]
    "add"          [ drop vt-with-auth state {run: vt-open-add/r} ]
    "grant"        [ drop vt-with-auth state {run: vt-open-access-grant/r} ]
    "lock"         [ drop vt-lock-op state true ]
    "unlock"       [ drop vt-lock-op state false ]
    "home"         [ drop vt-pop-to-root state ]
    "quit"         [ drop Tui.quit state ]
    "exit"         [ drop Tui.quit state ]
    "q"            [ drop Tui.quit state ]
    (vt-fail state (join "" ["unknown command: " cmd]))
  ]
]]

def vt-palette-key fn [[state:Map ev:Map] [Map] [
  case ev.key [
    "esc"   [ drop state set palette (vt-palette-closed) ]
    "enter" [ drop
      def cmd (StringUtil.lower ((state.palette.input).value))
      vt-run-palette (state set palette (vt-palette-closed)) cmd ]
    (state set palette {open: true  input: (Tui.edit state.palette.input ev)})
  ]
]]

# --- the `?` help overlay ------------------------------------------------

def vt-help-text fn [[state:Map] [String] [
  join "\n" [
    "this screen"
    "-----------"
    (vt-footer state)
    ""
    "everywhere"
    "----------"
    ": command palette   ? this help   o switch vault   T theme   esc back   q quit"
    ""
    "palette words"
    "-------------"
    "secrets · access · passwords · maintenance · settings · vaults ·"
    "status · audit · history · providers · config · add · grant ·"
    "lock · unlock · home · quit"
  ]
]]

def vt-help-key fn [[state:Map ev:Map] [Map] [
  case ev.key [
    "up"   [ drop state set help {open: true  scroll: (MathUtil.max 0 (state.help.scroll sub 1))} ]
    "down" [ drop state set help {open: true  scroll: (state.help.scroll add 1)} ]
    (state set help {open: false  scroll: 0})
  ]
]]

# --- theme (T cycles auto → dark → light, persisted best-effort) --------

def vt-effective-dark fn [[state:Map] [Boolean] [
  case state.theme [
    "dark"  [ drop true ]
    "light" [ drop false ]
    state.dark
  ]
]]

def vt-theme-next fn [[t:String] [String] [
  case t [
    "auto" [ drop "dark" ]
    "dark" [ drop "light" ]
    "auto"
  ]
]]

def vt-theme-cycle fn [[state:Map] [Map] [
  def next (vt-theme-next state.theme)
  def st2 (state set theme next)
  def st3 (st2 set pal (vt-pal (vt-effective-dark st2)))
  def st4 (do [ (Vault.set-prefs {theme: next})  st3 ] error [ drop st3 ])
  vt-status-line st4 (join "" ["theme: " next]) false
]]

def vt-apply-prefs fn [[state:Map] [Map] [
  def saved (do [ (Vault.prefs).theme ] error [ drop None ])
  if (if (saved eq None) [true] [saved eq ""]) [ state ] [
    def st2 (state set theme saved)
    st2 set pal (vt-pal (vt-effective-dark st2))
  ]
]]

# vt-captures: a form (always) and a filtering table own the keyboard
def vt-captures fn [[state:Map] [Boolean] [
  def scr (vt-top state)
  if (scr.kind eq "form") [ true ] [
    if (scr.kind eq "table") [ scr.filtering ] [ false ]
  ]
]]

def vt-global-key fn [[state:Map ev:Map] [Map] [
  # multi-arg calls in a case DEFAULT slot must be parenthesized — the
  # case machinery's own values sit on the stack and an open call would
  # collect them as arguments (gap G9, BORU-SHARP-EDGES.0.md)
  if state.help.open [ vt-help-key state ev ] [
  if state.palette.open [ vt-palette-key state ev ] [
  if (vt-captures state) [ vt-screen-key state ev ] [
    case ev.key [
      "q"   [ drop if ((size state.screens) lte 1) [ Tui.quit state ] [ vt-pop state ] ]
      "esc" [ drop
        def scr (vt-top state)
        if (if (scr.kind eq "table") [(scr.filter eq "") not] [false])
          [ vt-set-top state ((scr set filter "")
              set finput (Tui.input "" {placeholder: "filter aliases"})) ]
          [ vt-pop state ] ]
      ":"   [ drop state set palette {open: true
                input: (Tui.input "" {placeholder: ":command"})} ]
      "?"   [ drop state set help {open: true  scroll: 0} ]
      "T"   [ drop vt-theme-cycle state ]
      "o"      [ drop vt-push (vt-pop-to-root state) (vt-picker) ]
      "ctrl+o" [ drop vt-push (vt-pop-to-root state) (vt-picker) ]
      (vt-screen-key state ev)
    ]
  ]]]
]]

def vt-update fn [[state:Map ev:Map] [Map] [
  case ev.tag [
    "init"   [ drop
      def st1 (vt-apply-prefs (vt-load-vault
        (((state set ui (ev.ui)) set cols (ev.cols)) set rows (ev.rows))))
      # no vault to open → land on the picker so a vault can be created
      if st1.vault.ok [ st1 ] [ vt-push st1 (vt-picker) ] ]
    "resize" [ drop (state set cols (ev.cols)) set rows (ev.rows) ]
    "key"    [ drop vt-global-key state ev ]
    state
  ]
]]

# --- view: fixed chrome + per-kind body (§4.6) ---------------------------

def vt-vault-line fn [[state:Map] [String] [
  if state.vault.ok [
    join "" ["vault: " state.vault.path "  ·  " state.vault.backend
             (if state.vault.locked ["  ·  LOCKED"] [""])]
  ] [ "no vault open" ]
]]

def vt-crumb fn [[state:Map] [String] [
  join " › " (each [ dot title ] state.screens)
]]

def vt-detail-lines fn [[scr:Map] [String] [
  def m scr.meta
  def val (if ((scr.revealed) eq none) [ "●●●●●●  (r reveals)" ] [ scr.revealed ])
  join "\n" [
    (join "" ["alias:      " (vt-str m.name)])
    (join "" ["provider:   " (vt-str m.provider)])
    (join "" ["namespace:  " (vt-str m.namespace)])
    (join "" ["created:    " (vt-str m.created-at)])
    (join "" ["updated:    " (vt-str m.updated-at)])
    (join "" ["expires:    " (vt-str m.expires-at)])
    (join "" ["value:      " val])
  ]
]]

def vt-field-view fn [[f:Map] [Map] [
  Tui.rows [ (Tui.text f.label {style: {fg: "grey"}  size: 1})
             ((f.input) set size 1) ]
    {size: 2}
]]

def vt-body fn [[state:Map] [Map] [
  def scr (vt-top state)
  case scr.kind [
    "menu"  [ drop Tui.list-view scr.items {cursor: scr.sel} ]
    "pager" [ drop Tui.viewport (Tui.text scr.text {wrap: "wrap"}) {offset: [0 scr.scroll]} ]
    "table" [ drop
      def items (vt-visible scr.items scr.filter)
      def tbl (Tui.table (vt-secret-cols) (each [ vt-alias-row ] items) {cursor: scr.cursor})
      if scr.filtering [
        Tui.rows [ ((scr.finput set focus true) set size 1)
                   (tbl set size {flex: 1}) ]
      ] [ tbl ] ]
    "rtable" [ drop
      def cols (vt-rtable-cols scr.name)
      Tui.table cols (each [ rec:Map => [ vt-rrow cols rec ] ] scr.rows) {cursor: scr.cursor} ]
    "picker" [ drop
      def cols (vt-picker-cols)
      Tui.table cols (each [ rec:Map => [ vt-rrow cols rec ] ] scr.rows) {cursor: scr.cursor} ]
    "detail" [ drop
      def hdr (Tui.text (vt-detail-lines scr) {wrap: "wrap"  size: 7})
      def recs (Tui.box (Tui.list-view (each [ dot cmd ] scr.recipes) {cursor: scr.rsel})
                        {title: "exec recipes (c copies)"  border: "round"  size: {flex: 1}})
      Tui.rows [ hdr recs ] ]
    "form"  [ drop
      def body (Tui.rows (flatten [
        (each [ vt-field-view ] scr.fields)
        [ (Tui.text scr.error {style: {fg: "red"}  size: 1}) ]
      ]))
      Tui.box body {title: scr.title  border: "round"} ]
    (Tui.text "" {})
  ]
]]

def vt-footer fn [[state:Map] [String] [
  def scr (vt-top state)
  case scr.kind [
    "menu"   [ drop "↑/↓ move · enter open · q quit" ]
    "pager"  [ drop
      if (scr.name eq "config") [ "↑/↓ scroll · s set · x unset · esc back" ]
        [ "↑/↓ scroll · esc back · q back" ] ]
    "table"  [ drop
      if scr.filtering [ "type to filter · enter apply · esc cancel" ]
        [ "↑/↓ move · enter detail · a add · / filter · esc back" ] ]
    "rtable" [ drop
      if (scr.name eq "access") [ "↑/↓ move · g grant · D revoke · esc back" ]
        [ "↑/↓ move · a add · D remove · t revoke-temp · esc back" ] ]
    "picker" [ drop "↑/↓ move · enter switch · n new · d default · D prune · esc back" ]
    "detail" [ drop "r reveal/hide · c copy · R rotate · m rename · e expiry · g grant · D delete · esc back" ]
    "form"   [ drop "tab/↑/↓ fields · enter submit · esc cancel" ]
    ""
  ]
]]

def vt-body-or-help fn [[state:Map] [Map] [
  if state.help.open [
    Tui.viewport (Tui.text (vt-help-text state) {wrap: "wrap"})
                 {offset: [0 state.help.scroll]}
  ] [ vt-body state ]
]]

def vt-footer-widget fn [[state:Map] [Map] [
  if state.palette.open [
    ((state.palette.input) set focus true) set size 1
  ] [
    Tui.text (vt-footer state) {style: state.pal.dim  size: 1}
  ]
]]

def vt-view fn [[state:Map] [Map] [
  def pal state.pal
  Tui.rows [
    (Tui.text "boru vault" {style: pal.title  size: 1})
    (Tui.text (vt-vault-line state) {style: pal.dim  size: 1})
    (Tui.text (vt-crumb state) {style: pal.crumb  size: 1})
    ((vt-body-or-help state) set size {flex: 1})
    (vt-footer-widget state)
    (Tui.text state.status.text
              {style: (if state.status.err [pal.err] [pal.ok])  size: 1})
  ]
]]

# --- the app map + entry points (§4.1) -----------------------------------

def vault-app fn [[opts:Map] [Map] [
  def dark (if ((opts.dark) eq None) [true] [opts.dark])
  def out { init: { ui: none  cols: 0  rows: 0  dark: dark
                    theme: "auto"  pal: (vt-pal dark)
                    vault: {ok: false}
                    screens: [ (vt-home) ]
                    status: {text: ""  err: false}
                    palette: (vt-palette-closed)
                    help: {open: false  scroll: 0}
                    add-defaults: {provider: ""  namespace: ""  expiry: ""} }
            update: vt-update/r
            view: vt-view/r }
  out
]]

def vault-run fn [[opts:Map] [Map] [
  Tui.run (vault-app opts)
]]

export "VaultTui" {
  app: vault-app/r
  run: vault-run/r
}
