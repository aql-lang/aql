{
  version: 1
  name:    "client"
  extends: "sandbox"

  scopes: {
    global: {
      words: {
        default: "deny"
        rules: [
          { allow: ["disk.read", "clock", "mutate", "network"] }
          { deny:  ["disk.write", "process", "env", "system-info"] }
        ]
      }
    }

    network: {
      install: true
      words: {
        default: "deny"
        rules: []
      }
    }

    // client promises "read disk, no writes" (HOWTO): allow the
    // read-like fileops alongside the disk.read global — the two are
    // independent gates (the same gap as read-only's NUR041).
    fileops: {
      words: {
        rules: [
          { allow: ["read", "stat", "list"] }
        ]
      }
    }
  }
}
