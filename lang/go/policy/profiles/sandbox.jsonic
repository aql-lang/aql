{
  version: 1
  name:    "sandbox"

  limits: {
    timeoutMs:      5000
    maxStepBudget:  1000000
    maxStackDepth:  256
    maxOutputBytes: 65536
  }

  scopes: {
    global: {
      words: {
        default: "deny"
        rules: [
          { allow: ["disk.read", "clock", "mutate"] }
          { deny:  ["disk.write", "network", "process",
                    "env", "system-info"] }
        ]
      }
    }

    engine: {
      words: { default: "allow" }
    }

    modules: {
      words: {
        default: "deny"
        rules: [
          { allow: ["import"], where: { module: ["boru:math-util", "boru:time-util", "boru:io", "boru:cli"] } }
        ]
      }
      scopes: {
        "boru:math-util": { words: { default: "allow" } }
        "boru:time-util": {
          words: {
            default: "allow"
            rules: [{ deny: ["sleep"] }]
          }
        }
        // I/O words live here now; importing the module is allowed so
        // disk.read works, but the actual disk.read / disk.write capability
        // is still gated by the global scope above (write stays denied).
        "boru:io": { words: { default: "allow" } }
        // boru:cli is PURE — a spec map and an argument vector in, a decision
        // map out — so a sandboxed program may parse its own command line.
        // Without it a sandboxed tool can read IO.args and not interpret them.
        "boru:cli": { words: { default: "allow" } }
      }
    }

    fileops: {
      words: {
        default: "deny"
        rules: []
      }
    }

    network: { install: false }
    sqlite:  { install: false }
    process: { install: false }
    terminal: { install: false }
    vault:   { install: false }

    formats: { words: { default: "allow" } }
    env:     { words: { default: "deny" } }
    clock:   { words: { default: "allow" } }
  }
}
