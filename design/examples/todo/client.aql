# client.aql — a consumer, showing the "assume remote" failure contract.
#
# DX probe: the whole point of the uniform surface (§8) is that this code would
# read IDENTICALLY against an in-process service and a remote one — only the
# firing-rate of failures changes. `connect` returns a local proxy whose
# `call`/`send` forward over the wire; from here it is just a `Service`.
#
# What this exercises:
#   * the closed delivery-error set — timeout / down / overload / transport —
#     handled distinctly from application errors, which propagate UNCHANGED;
#   * idempotent reads auto-retry; non-idempotent writes never blind-retry and
#     reconcile instead (§8.2);
#   * a correlated push subscription bridging the service and process layers.

import "aql:net"
import "aql:serve"
import "aql:time-util"

# Two remote handles — same surface as the local services they front.
def sessions ( connect {http: "http://localhost:8080/sessions"} )
def todos    ( connect {http: "http://localhost:8080/todo"} )

# --- log in -----------------------------------------------------------------
def session ( call {op: "login"  user: "alice"} sessions )
def token   ( session dot token )

# --- WRITE path: create a todo ----------------------------------------------
# A write is NOT idempotent: a blind retry could double-create. So no `retries`;
# on an ambiguous failure (timeout/down — the request MAY have run) we reconcile
# rather than guess. `overload` definitely never ran, so it is safe to resubmit.
def created (
  do [ call {op: "create"  token: token  user: "alice"  text: "write the RFC"} todos
         {timeout: (TimeUtil.seconds 5)} ]
  error [ case [
      [dot code eq timeout/q]  [ reconcile-create "alice" "write the RFC" ]  # unknown
      [dot code eq down/q]     [ reconcile-create "alice" "write the RFC" ]  # unknown
      [dot code eq overload/q] [ retry-later "alice" ]                        # never ran
      [ raise ] ] ] )                                                         # app error -> up
)

# --- READ path: list todos --------------------------------------------------
# Reads ARE idempotent, so auto-retry is safe; degrade to a stale/empty view on
# persistent failure rather than erroring the UI.
def items (
  do [ call {op: "list"  token: token  user: "alice"} todos
         {timeout: (TimeUtil.seconds 2)  retries: 3  idempotent: true} ]
  error [ case [
      [dot code eq timeout/q]   [ [] ]                       # show empty, try later
      [dot code eq down/q]      [ [] ]
      [dot code eq transport/q] [ raise unavailable "todo service offline" ]
      [ raise ] ] ] )                                        # app errors propagate
)

# --- live push: subscribe this client's sink to alice's events --------------
# Bridges to the PROCESS layer. We pass `self` as the sink; the presence proc
# (via notify's deferred-reply `subscribe`) will `send` pushes here, which we
# drain with a correlated `receive`. The reply to `subscribe` is itself a
# tagged map so we match it specifically, not with a stray-catching `{}` (§10).
send {op: "subscribe"  token: token  user: "alice"  sink: self} todos
receive [ {ok: Boolean user: String} [ "subscribed" ] ]   # the deferred reply

# Drain one push event, or give up after 60s. `push`/`user` are typed binding
# slots (Strings — push tags are scalar strings); `after` bounds the wait so we
# never block forever (PROCESSES.0 §3).
receive [
  {push: String user: String} [ `event ${push} for ${user}` ]
  (after 60000)               [ "no events" ]
]

# --- reconciliation stubs (illustrative) ------------------------------------
def reconcile-create fn [[user:String text:String] [Map] [
  # A real impl would `list` and create-if-absent (idempotent by content).
  {reconciled: true  user: user}
]]
def retry-later fn [[user:String] [None] [ None ]]
