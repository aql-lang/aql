# todo.aql — the per-user todo state, as a SERVICES.0 `service`.
#
# DX probe: this is the smallest unit of the architecture — a value that owns
# private state and answers pattern-matched requests (`SERVICES.0.md` §1). One
# `TodoStore` worker holds MANY users' lists, keyed by `user`, so the whole
# store can later be sharded across a `pool {strategy: ('hash 'user)}` for
# state affinity (see app.aql / README §"scaling"). Nothing here knows or cares
# whether it runs in-process or as a served process — that is the point of the
# "assume remote" uniform surface (§8): the same code earns isolation just by
# being placed in a `server` and `serve`d.
#
# NOTE (illustrative): the SERVICES/PROCESSES words (`service`/`add`/`call`/
# `state`/…) are design-only and do NOT exist yet. Collection-word spellings
# (`get`/`set`/`del`/`vals`) are likewise illustrative; the real ones would be
# confirmed against `aql describe`. This file exists to FEEL the DX, not to run.

"aql:serve" import end          # send (fire-and-forget) into the notify sink

# ---------------------------------------------------------------------------
# Constructor — a reusable service is just a module that exports a function
# returning a `Service` (§2). `import` is the only loader; no plugin mechanism.
# ---------------------------------------------------------------------------
export "TodoStore" {
  New: New/r
}

# `New {notify: <Service>}` -> Service
#   `notify` is the event sink this store emits to on every mutation. Passing it
#   in (rather than importing a singleton) keeps the store testable and lets the
#   server wire the graph explicitly in app.aql.
def New fn [[opts:Map] [Service] [
  # Private state: a map of  user -> {todos: {id -> todo}  next: Integer}.
  # `state` is a mutable `Store`, safe to mutate in place because a service
  # handles ONE request at a time (§1 — the gen_server guarantee, no locks).
  def svc ( service {users: {}  notify: (opts get 'notify ? None)} )

  # --- create ------------------------------------------------------------
  # Scalar-tag routing on `op:'create` (patrun, §3); the payload fields
  # `user`/`text` are read off `req` — destructuring is the handler's job in a
  # service (gap A: services route on scalar tags only, no `name:Type` slots).
  add {op:'create} [ [req state] => [
      def bucket ( user-bucket state req.user )      # {todos next}
      def id     ( bucket get 'next )
      def todo   {id: id  text: req.text  done: false}
      put-bucket state req.user
        { todos: (set id todo (bucket get 'todos))
          next:  (inc id) }
      emit state req.user {tag: 'created  id: id}     # fire-and-forget event
      todo                                            # reply: the created todo
  ] ] svc

  # --- list (read path — idempotent; safe for the caller to auto-retry) ---
  add {op:'list} [ [req state] => [
      vals ((user-bucket state req.user) get 'todos)
  ] ] svc

  # --- toggle done -------------------------------------------------------
  add {op:'toggle} [ [req state] => [
      def bucket ( user-bucket state req.user )
      def todo   ( (bucket get 'todos) get req.id )
      if (none? todo)
        [ raise no_such_todo `no todo ${req.id} for ${req.user}` ]
        [ def flipped ( set 'done (not (todo get 'done)) todo )
          put-bucket state req.user
            { todos: (set req.id flipped (bucket get 'todos))
              next:  (bucket get 'next) }
          emit state req.user {tag: 'toggled  id: req.id}
          flipped ]
  ] ] svc

  # --- remove ------------------------------------------------------------
  add {op:'remove} [ [req state] => [
      def bucket ( user-bucket state req.user )
      put-bucket state req.user
        { todos: (del req.id (bucket get 'todos))
          next:  (bucket get 'next) }
      emit state req.user {tag: 'removed  id: req.id}
      None
  ] ] svc

  # --- clear -------------------------------------------------------------
  add {op:'clear} [ [req state] => [
      put-bucket state req.user {todos: {}  next: 1}
      emit state req.user {tag: 'cleared}
      None
  ] ] svc

  svc
]]

# ---------------------------------------------------------------------------
# Private helpers — module-local `def`s are pure scaffolding and never leak
# (only the exported `New` is reachable from outside, §2).
# ---------------------------------------------------------------------------

# Fetch (or lazily create) a user's bucket from the service Store.
def user-bucket fn [[state:Store user:String] [Map] [
  (state get 'users) get user ? {todos: {}  next: 1}
]]

# Write a user's bucket back into the Store.
def put-bucket fn [[state:Store user:String bucket:Map] [None] [
  state set 'users (set user bucket (state get 'users))
  None
]]

# Emit a mutation event to the notify sink, if one was wired in. `send` is
# fire-and-forget (§1): the store never blocks on the sink, and the sink's
# `overflow: 'drop` mailbox (notify.aql) means a slow consumer can never stall
# the hot path. Note the event is an immutable Map — sendable by the §6 rule.
def emit fn [[state:Store user:String ev:Map] [None] [
  def sink ( state get 'notify )
  if (none? sink) [ None ]
    [ send (set 'user user ev) sink ]   # {tag:… user:… …} -> Notify
]]
