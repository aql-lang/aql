# dynamo-store.aql — a DynamoDB store SKETCH (the seneca-dynamo-store analog).
#
# DX probe (illustrative, NOT executable). Shows where real DB I/O lives: a store
# is a `Service` that maps the five entity ops onto DynamoDB's JSON/HTTP API via
# `Net.fetch`. This is PHASE-3 work and has REAL prerequisites — see the `# GAP:`
# notes. The structure is identical to mem-store.aql; only the bodies do network
# I/O instead of touching a local Store.

"aql:serve" import end
"aql:net"   import end          # Net.fetch (HTTP client; the only transport AQL has)
"aql:rand"  import end

export "DynamoStore" { New: New/r }

# `New {table region}` -> Service
def New fn [[opts:Map] [Service] [
  def svc ( service { table:  (opts get table)
                      region: (opts get region ? "us-east-1") } )

  add {role: "entity"  cmd: "save"} [ [req state] => [
      def id  ( req.ent get id ? (Rand.uuid) )
      def row ( set id (id) req.ent )
      dynamo state "DynamoDB_20120810.PutItem"
        { TableName: (state get table)  Item: (to-attr row) }
      row
  ] ] svc

  add {role: "entity"  cmd: "load"} [ [req state] => [
      def out ( dynamo state "DynamoDB_20120810.GetItem"
                  { TableName: (state get table)  Key: (to-attr {id: req.q.id}) } )
      from-attr (out get Item)
  ] ] svc

  add {role: "entity"  cmd: "list"} [ [req state] => [
      # Real impl builds a FilterExpression from q and paginates the Scan.
      def out ( dynamo state "DynamoDB_20120810.Scan" { TableName: (state get table) } )
      map ([it:Map] => [ from-attr it ]) (out get Items)
  ] ] svc

  add {role: "entity"  cmd: "remove"} [ [req state] => [
      dynamo state "DynamoDB_20120810.DeleteItem"
        { TableName: (state get table)  Key: (to-attr {id: req.q.id}) }
      None
  ] ] svc

  svc
]]

# Build and POST a DynamoDB request. `Net.fetch` reaches the host network policy.
#
# GAP: real DynamoDB requires AWS SigV4 signing (HMAC-SHA256 over a canonical
#      request) on every call. AQL has no HMAC/crypto or signer today — a hard
#      prerequisite, NOT hand-wavable. The Authorization/X-Amz-Date headers below
#      are therefore MISSING; this call would be rejected by AWS as-is.
# GAP: network access is gated by the `network` capability scope (PERMISSIONS.10);
#      sandbox/read-only profiles hard-deny it.
# GAP: the real seneca-dynamo-store has a documented upsert race on unique fields.
def dynamo fn [[state:Store target:String body:Map] [Map] [
  def url ( `https://dynamodb.${state get region}.amazonaws.com/` )
  Net.fetch { url: url  method: "POST"
              headers: { "X-Amz-Target": target
                         "Content-Type": "application/x-amz-json-1.0" }
              body: body }
]]

# DynamoDB attribute-value codec ({id:"x"} <-> {id:{S:"x"}}) — sketched as
# identity. GAP: real type tagging ({S}/{N}/{BOOL}/{M}/{L}) is omitted.
def to-attr   fn [[m:Map] [Map] [ m ]]
def from-attr fn [[m:Map] [Map] [ m ]]
