# ============================================================
# todo-tui-served.aql — the todo TUI, served to a remote viewer.
# The TUI.0.md §6 remote tier over the SAME app map as todo-tui.aql:
# the server runs update/view headless (no TTY, no backend needed);
# widget trees go down the wire, key events come up (§6.1); the thin
# client is `aql attach` (§6.4).
# SPECULATIVE: written against the aql:tui RFC surface. See README.0.md.
#
#   # on the host (needs `terminal.serve` + `network.listen` scopes, §6.3):
#   aql run todo-tui-served.aql
#
#   # from any machine with the aql binary (no engine runs client-side):
#   $ aql attach 10.0.0.5:9700 --token s3cret
#
# v1 semantics to note (§6.3): one viewer at a time (second attach →
# deny busy); the viewer disconnecting quits the app; Tui.serve returns
# the final state exactly as Tui.run does — the picked/edited todos are
# in the server process's hands when the session ends.
# ============================================================

import "aql:tui"
import "./todo-tui.aql"

# The run/serve reuse idiom (TUI.0.md §5): TodoTui exports its app MAP,
# so serving it is a one-word change from running it locally.
def final (Tui.serve {tcp: 9700  token: "s3cret"} (TodoTui.app {}))

# `final.todos` is the list as the remote viewer left it.
print (join "" ["session ended with " (convert String (size final.todos)) " todos"])
