# ============================================================
# todo-tui-client.aql — the same todo TUI, backed by the REAL REST
# server (../apps/todo-api.aql, the NETWORK-SERVERS.0.md §6.4
# verification app). The literal "TUI version of the todo API server":
# the UI's todo list is a cache of the server's; every mutation is a
# spawned worker doing the HTTP round trip, exactly the pragmatic-BEAM
# idiom of TUI.0.md §2.3 — update never blocks, the screen never
# freezes, results come back as ordinary mailbox messages.
# SPECULATIVE: written against the aql:tui RFC surface. See README.0.md.
#
#   import "../apps/todo-api.aql"
#   import "./todo-tui-client.aql"
#   def ln (TodoApi.serve {port: 0})                     # in-process server
#   def addr (join "" ["127.0.0.1:" (convert String (Net.addr ln).port)])
#   def final (TodoTuiClient.run {tcp: addr})            # …or a remote host
#
# Keys are identical to todo-tui.aql. The status line shows "syncing…"
# while a worker round-trip is in flight, and the last sync error if any.
# ============================================================

import "aql:net"
import "aql:tui"

# --- HTTP workers -------------------------------------------------------
# Each worker runs in its own process: do the verb, re-fetch the list,
# send it home. The UI's pid and the endpoint handle are captured into
# the spawned body (handles travel by identity, like Pid/Socket —
# NETWORK-SERVERS.0.md §4.1; see README finding F5). Failures become
# {tag:"sync-error"} messages — the uniform failure contract, on screen.

def fetch-todos fn [[ep:Any] [List] [
  def r (call {method: "GET"  path: "/todos"} ep {timeout: 5000})
  # the endpoint returns the reply body as JSON text — decode to values
  # (client-side decode spelling illustrative; see README finding F6)
  parse "json" (convert String r.body)
]]

def sync fn [[ep:Any ui:Any] [Any] [
  spawn [ do [
      send {tag: "loaded"  todos: (fetch-todos ep)} ui
    ]
    error [ send {tag: "sync-error"  why: (get message)} ui ] ]
]]

def create-remote fn [[state:Map text:String] [Any] [
  spawn [ do [
      call { method: "POST"  path: "/todos"
             headers: {content-type: "application/json"}
             body: (emit "json" {text: text}) } state.ep {timeout: 5000}
      send {tag: "loaded"  todos: (fetch-todos state.ep)} state.ui
    ]
    error [ send {tag: "sync-error"  why: (get message)} state.ui ] ]
]]

def toggle-remote fn [[state:Map t:Map] [Any] [
  spawn [ do [
      call { method: "PUT"  path: (join "" ["/todos/" t.id])
             headers: {content-type: "application/json"}
             body: (emit "json" {done: (t.done not)}) } state.ep {timeout: 5000}
      send {tag: "loaded"  todos: (fetch-todos state.ep)} state.ui
    ]
    error [ send {tag: "sync-error"  why: (get message)} state.ui ] ]
]]

def delete-remote fn [[state:Map t:Map] [Any] [
  spawn [ do [
      call {method: "DELETE"  path: (join "" ["/todos/" t.id])} state.ep {timeout: 5000}
      send {tag: "loaded"  todos: (fetch-todos state.ep)} state.ui
    ]
    error [ send {tag: "sync-error"  why: (get message)} state.ui ] ]
]]

# --- update -------------------------------------------------------------

def clamp-sel fn [[sel:Integer n:Integer] [Integer] [
  max 0 (min sel (sub n 1))
]]

def client-update fn [[state:Map ev:Map] [Map] [
  case [
    # first event: learn our own pid, kick off the initial load (§2.4)
    [(ev has "tag") and (ev.tag eq "init")] [
      def st2 (state set ui ev.ui)
      sync st2.ep st2.ui
      st2 set syncing true ]

    # worker results — just more mailbox messages
    [(ev has "tag") and (ev.tag eq "loaded")] [
      def st2 ((state set todos ev.todos) set syncing false)
      (st2 set err "") set sel (clamp-sel st2.sel (size ev.todos)) ]
    [(ev has "tag") and (ev.tag eq "sync-error")] [
      (state set syncing false) set err ev.why ]

    [(ev has "key") not] [ state ]

    [ev.key eq "tab"] [
      state set focus (if (state.focus eq "entry") ["list"] ["entry"]) ]

    # --- entry zone: submit = POST to the server
    [(state.focus eq "entry") and (ev.key eq "enter")] [
      def text state.entry.value
      if (text eq "") [ state ] [
        create-remote state text
        def st2 (state set entry (Tui.input "" {placeholder: "what needs doing?"}))
        st2 set syncing true
      ] ]
    [state.focus eq "entry"] [
      state set entry (Tui.edit state.entry ev) ]

    # --- list zone: mutate = PUT/DELETE to the server
    [ev.key eq "up"]    [ state set sel (clamp-sel (sub state.sel 1) (size state.todos)) ]
    [ev.key eq "down"]  [ state set sel (clamp-sel (add state.sel 1) (size state.todos)) ]
    [(ev.key eq "space") and ((size state.todos) gt 0)] [
      toggle-remote state (state.todos get state.sel)
      state set syncing true ]
    [(ev.key eq "d") and ((size state.todos) gt 0)] [
      delete-remote state (state.todos get state.sel)
      state set syncing true ]
    [ev.key eq "q"] [
      # update may do I/O directly (§2.3): release the endpoint, then quit
      Net.close state.ep
      Tui.quit state ]

    [ state ]
  ]
]]

# --- view (same shape as todo-tui.aql, plus sync status) ------------------

def client-view fn [[state:Map] [Map] [
  def n (size state.todos)
  def done-n (size (filter ([t:Map] => [ t.done ]) state.todos))
  def status (case [
    [(state.err eq "") not] [ join "" ["sync error: " state.err] ]
    [state.syncing]         [ "syncing…" ]
    [ "in sync" ])
  Tui.rows [
    (Tui.box (state.entry set focus (state.focus eq "entry"))
             {title: "new todo"  border: "round"  size: 3})
    (Tui.box (Tui.list-view
               (each ([t:Map] => [ join "" [(if t.done ["[x] "] ["[ ] "]) t.text] ]) state.todos)
               {cursor: state.sel})
             {title: (join "" ["todos " (convert String done-n) "/" (convert String n)])
              border: "round"  size: {flex: 1}})
    (Tui.text (join "  ·  " [status "tab focus" "space toggle" "d delete" "q quit"])
              {style: {fg: "grey"}  size: 1})
  ]
]]

# --- app map + entry points ----------------------------------------------

def client-app fn [[opts:Map] [Map] [
  def ep (Net.connect {tcp: opts.tcp  codec: Net.http})
  { init: { todos: []  sel: 0  focus: "entry"  syncing: true  err: ""
            ui: None  ep: ep
            entry: (Tui.input "" {placeholder: "what needs doing?"}) }
    update: client-update/r
    view: client-view/r }
]]

def client-run fn [[opts:Map] [Map] [
  Tui.run (client-app opts)
]]

export "TodoTuiClient" {
  app: client-app/r
  run: client-run/r
}
