{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "AQL",
  "scopeName": "source.aql",
  "fileTypes": ["aql"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#constants" },
    { "include": "#definition" },
    { "include": "#keywords" },
    { "include": "#builtins" },
    { "include": "#types" },
    { "include": "#modifiers" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.aql",
          "begin": "/\\*",
          "end": "\\*/",
          "captures": {
            "0": { "name": "punctuation.definition.comment.aql" }
          }
        },
        {
          "name": "comment.line.number-sign.aql",
          "begin": "#",
          "end": "$",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.comment.aql" }
          }
        },
        {
          "name": "comment.line.double-slash.aql",
          "begin": "//",
          "end": "$",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.comment.aql" }
          }
        }
      ]
    },

    "strings": {
      "patterns": [
        { "include": "#string-single" },
        { "include": "#string-double" },
        { "include": "#string-template" }
      ]
    },

    "string-single": {
      "name": "string.quoted.single.aql",
      "begin": "'",
      "end": "'",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.begin.aql" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.aql" }
      },
      "patterns": [
        { "include": "#string-escape" }
      ]
    },

    "string-double": {
      "name": "string.quoted.double.aql",
      "begin": "\"",
      "end": "\"",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.begin.aql" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.aql" }
      },
      "patterns": [
        { "include": "#string-escape" }
      ]
    },

    "string-template": {
      "name": "string.template.aql",
      "begin": "`",
      "end": "`",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.begin.aql" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.aql" }
      },
      "patterns": [
        { "include": "#string-escape" },
        { "include": "#template-expression" }
      ]
    },

    "template-expression": {
      "name": "meta.template.expression.aql",
      "begin": "\\$\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.template-expression.begin.aql" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.template-expression.end.aql" }
      },
      "patterns": [
        { "include": "#template-brace" },
        { "include": "#comments" },
        { "include": "#strings" },
        { "include": "#numbers" },
        { "include": "#constants" },
        { "include": "#keywords" },
        { "include": "#builtins" },
        { "include": "#types" },
        { "include": "#modifiers" },
        { "include": "#operators" }
      ]
    },

    "template-brace": {
      "name": "meta.template.expression.brace.aql",
      "begin": "\\{",
      "end": "\\}",
      "patterns": [
        { "include": "#template-brace" },
        { "include": "#comments" },
        { "include": "#strings" },
        { "include": "#numbers" },
        { "include": "#constants" },
        { "include": "#keywords" },
        { "include": "#builtins" },
        { "include": "#types" },
        { "include": "#modifiers" },
        { "include": "#operators" }
      ]
    },

    "string-escape": {
      "name": "constant.character.escape.aql",
      "match": "\\\\(?:u[0-9A-Fa-f]{4}|[nt\\\\'\"`])"
    },

    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.aql",
          "match": "-?\\b0x[0-9a-fA-F_]+\\b"
        },
        {
          "name": "constant.numeric.binary.aql",
          "match": "-?\\b0b[01_]+\\b"
        },
        {
          "name": "constant.numeric.big.aql",
          "match": "-?\\b0d[0-9]+\\b"
        },
        {
          "name": "constant.numeric.float.aql",
          "match": "-?\\b[0-9][0-9_]*(?:\\.[0-9_]+(?:[eE][+-]?[0-9]+)?|[eE][+-]?[0-9]+)"
        },
        {
          "name": "constant.numeric.integer.aql",
          "match": "-?\\b[0-9][0-9_]*\\b"
        }
      ]
    },

    "constants": {
      "name": "constant.language.aql",
      "match": "(?<![A-Za-z0-9_-])-?(?:true|false|none|inf|nan)(?![A-Za-z0-9_-])"
    },

    "definition": {
      "patterns": [
        {
          "match": "(?<![A-Za-z0-9_-])(def)\\s+([A-Z][A-Za-z0-9_-]*)",
          "captures": {
            "1": { "name": "keyword.control.aql" },
            "2": { "name": "entity.name.type.aql" }
          }
        },
        {
          "match": "(?<![A-Za-z0-9_-])(def|undef|var|fn|afn)\\s+([a-z_][A-Za-z0-9_-]*)",
          "captures": {
            "1": { "name": "keyword.control.aql" },
            "2": { "name": "entity.name.function.aql" }
          }
        }
      ]
    },

    "keywords": {
      "name": "keyword.control.aql",
      "match": "(?<![A-Za-z0-9_-])(?:def|undef|var|fn|afn|class|surface|refine|gen|exposes|make|import|export|module|load|create|update|remove|do|if|case|for-each|for|each|fold|scan|outer|inner|filter|walk|break|continue|guard|raise|return|otherwise|quote|unquote|splice|word|macroexpand|macro|codequote|unpack-prefix|unpack|call|apply|from|where|select|order|group|having|join|limit|offset|distinct|union|between|in|with-decimal|with|convert|typeof|inspect|istype|is|of|extends|default|const|base|behave|pathof)(?![A-Za-z0-9_-])"
    },

    "builtins": {
      "name": "support.function.aql",
      "match": "(?<![A-Za-z0-9_-])(?:add|sub|mul|div|mod|pow|abs|negate|min|max|sign|ceil|floor|round-even|round|trunc|logb|scalb|fma|sqrt|cbrt|exp|log2|log10|log|sin|cos|tan|asin|acos|atan2|atan|hypot|is-nan|is-inf|is-finite|signbit|remainder|copysign|nextafter|math-pi|math-e|lte|lt|gte|gt|cmp|tcmp|eq|neq|deq|and|or|not|xor|nand|implies|nor|iff|xnor|any|all|band|bor|bxor|bnot|bsl|bsr|busr|upper|lower|concat|split|trim|contains|indexof|replace|changecase|normalize|repeat|pad|match|escape|dup2|dup|swap2|swap|drop2|drop|over2|over|rot|nip|tuck|depth|pick|roll|stack|iota|range|reverse|sort|flatten|slice|take|shed|append|push|pop|shift|unshift|size|enum|node|flex|xml-elem|xml-text|xml-attr|set|getr|get|dotr|dot|has|context|keys|vals|reach|rebind|referent|ref|patrun|find|patterns|tor|tand|tany|tall|teq|tpartial|tis|tnot|fnsig|unify|gensym|canon|mini|parse|emit|printstr|print|read|write|trace|stdin|stdout|stderr|args|error|force-arity|usurp|forward-args|stack-args|spawn|self|send|receive|register|whereis|unregister|service|state-of|wrap|help|describe)(?![A-Za-z0-9_-])"
    },

    "types": {
      "patterns": [
        {
          "name": "entity.name.type.aql",
          "match": "\\b[A-Z][A-Za-z0-9]*\\b"
        }
      ]
    },

    "modifiers": {
      "name": "keyword.operator.modifier.aql",
      "match": "/(?:[qsfrtu]+|[0-9]+)(?![A-Za-z0-9_-])"
    },

    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.lambda.aql",
          "match": "=>"
        },
        {
          "name": "keyword.operator.access.strict.aql",
          "match": "!\\."
        },
        {
          "name": "keyword.operator.access.aql",
          "match": "\\."
        },
        {
          "name": "keyword.operator.barrier.aql",
          "match": "\\|"
        },
        {
          "name": "punctuation.separator.type.aql",
          "match": ":"
        },
        {
          "name": "punctuation.terminator.statement.aql",
          "match": ";"
        }
      ]
    }
  }
}
