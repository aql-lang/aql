// boru Language Server for Zed.
//
// Zed binds language servers per-language. Merge the snippet below
// into ~/.config/zed/settings.json. Until a dedicated boru extension
// ships on the Zed extension marketplace, you also need to register
// the "boru" file association under languages.
//
// Note: cmd.zed.dev/docs/configuring-languages describes the schema
// — keys here follow it.

{
  "lsp": {
    "boru-lsp": {
      "binary": {
        "path": "boru",
        "arguments": ["lsp"]
      }
    }
  },
  "languages": {
    "boru": {
      "language_servers": ["boru-lsp"],
      "tab_size": 2,
      "hard_tabs": false,
      "format_on_save": "off"
    }
  },
  "file_types": {
    "boru": ["boru"]
  }
}
