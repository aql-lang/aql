// BORU Language Server for Kate / KWrite via the built-in LSP Client.
//
// Settings > Configure Kate > LSP Client > User Server Settings
// Paste / merge the snippet below into the text area. Kate will
// spawn `boru lsp` for buffers whose highlighting mode matches the
// "boru" key. Add a "boru" highlighting definition under
// Settings > Configure Kate > Open/Save > Modes & Filetypes if
// none is registered for *.boru.

{
  "servers": {
    "boru": {
      "command": ["boru", "lsp"],
      "rootIndicationFileNames": ["boru.jsonic", ".git"],
      "url": "https://github.com/boru-lang/boru",
      "highlightingModeRegex": "^BORU$"
    }
  }
}
