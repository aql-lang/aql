{
  "name": "boru",
  "displayName": "boru Language",
  "description": "boru language support backed by the boru lsp server.",
  "version": "0.1.0",
  "publisher": "boru-lang",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/boru-lang/boru.git"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:boru"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "boru",
        "aliases": ["boru", "Boru"],
        "extensions": [".boru"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "boru",
        "scopeName": "source.boru",
        "path": "./syntaxes/boru.tmLanguage.json"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "boru",
      "properties": {
        "boru.serverPath": {
          "type": "string",
          "default": "boru",
          "description": "Path to the boru binary. Leave as 'boru' if it is on PATH."
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
