// boru Language Server for coc.nvim (Vim 8+ / Neovim).
//
// Open with :CocConfig and merge the "languageserver.boru" block into
// your existing coc-settings.json. coc.nvim will spawn `boru lsp`
// over stdio for any *.boru buffer.

{
  "languageserver": {
    "boru": {
      "command": "boru",
      "args": ["lsp"],
      "filetypes": ["boru"],
      "rootPatterns": ["boru.jsonic", ".git"],
      "trace.server": "off"
    }
  }
}
