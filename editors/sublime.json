// BORU Language Server for Sublime Text via the LSP package.
//
// Prerequisites: install the "LSP" package via Package Control.
//
// Open: Preferences > Package Settings > LSP > Settings
// Merge the "clients.boru" block below into the user settings on the
// right-hand pane. Sublime will then spawn `boru lsp` for any file
// whose syntax / scope matches source.boru or extension matches *.boru.
//
// For syntax highlighting you can install a BORU syntax package
// separately or fall back to "Packages/Text/Plain text.tmLanguage"
// — diagnostics work either way.

{
  "clients": {
    "boru": {
      "enabled": true,
      "command": ["boru", "lsp"],
      "selector": "source.boru",
      "schemes": ["file"],
      "languageId": "boru",
      "settings": {}
    }
  },
  "file_types": {
    "boru": ["*.boru"]
  }
}
