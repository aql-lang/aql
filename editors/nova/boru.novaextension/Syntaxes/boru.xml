        <!-- ================= Types / module namespaces ================= -->
        <!-- Any capitalised identifier is a type or module namespace. -->
        <scope name="boru.identifier.type">
            <expression>\b[A-Z][A-Za-z0-9]*\b</expression>
        </scope>

        <!-- ================= Operators / modifiers ================= -->
        <!-- /modifier dispatch suffix: /q /s /f /r /t /u, combos, /<digit>. -->
        <scope name="boru.operator.modifier">
            <expression>/(?:[qsfrtu]+|[0-9]+)\b</expression>
        </scope>
        <!-- Lambda arrow. -->
        <scope name="boru.operator.arrow">
            <expression>=&gt;</expression>
        </scope>
        <!-- Strict access. -->
        <scope name="boru.operator.strict">
            <expression>!\.</expression>
        </scope>
        <!-- Barrier marker, dotted access, separators, typed-name colon. -->
        <scope name="boru.operator">
            <expression>[.;:|]</expression>
        </scope>
    </scopes>
</syntax>
