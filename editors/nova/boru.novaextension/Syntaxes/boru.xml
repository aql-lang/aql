<?xml version="1.0" encoding="UTF-8"?>
<syntax name="boru">
    <meta>
        <name>BORU</name>
        <type>compiled</type>
        <preferred-file-extension>boru</preferred-file-extension>
    </meta>

    <detectors>
        <extension priority="1.0">boru</extension>
    </detectors>

    <indentation>
        <increase>
            <expression>(\{|\[|\()[^}\])]*$</expression>
        </increase>
        <decrease>
            <expression>^\s*(\}|\]|\))</expression>
        </decrease>
    </indentation>

    <comments>
        <single>
            <expression>#</expression>
        </single>
        <single>
            <expression>//</expression>
        </single>
        <multiline>
            <starts-with>
                <expression>/\*</expression>
            </starts-with>
            <ends-with>
                <expression>\*/</expression>
            </ends-with>
        </multiline>
    </comments>

    <brackets>
        <pair open="{" close="}" />
        <pair open="[" close="]" />
        <pair open="(" close=")" />
    </brackets>

    <surrounding-pairs>
        <pair open="{" close="}" />
        <pair open="[" close="]" />
        <pair open="(" close=")" />
        <pair open="&apos;" close="&apos;" />
        <pair open="&quot;" close="&quot;" />
        <pair open="`" close="`" />
    </surrounding-pairs>

    <scopes>
        <!-- ================= Comments ================= -->
        <scope name="boru.comment.line.number-sign" spell-check="true">
            <expression>#.*$</expression>
        </scope>
        <scope name="boru.comment.line.double-slash" spell-check="true">
            <expression>//.*$</expression>
        </scope>
        <scope name="boru.comment.block" spell-check="true">
            <starts-with>
                <expression>/\*</expression>
            </starts-with>
            <ends-with>
                <expression>\*/</expression>
            </ends-with>
        </scope>

        <!-- ================= Strings ================= -->
        <!-- Backtick template string with ${ ... } interpolation. -->
        <scope name="boru.string.template">
            <starts-with>
                <expression>`</expression>
            </starts-with>
            <ends-with>
                <expression>`</expression>
            </ends-with>
            <subscopes>
                <scope name="boru.string.escape">
                    <expression>\\(?:[nt\\'"`]|u[0-9A-Fa-f]{4})</expression>
                </scope>
                <!-- Interpolation: ${ embedded BORU expression } -->
                <scope name="boru.string.interpolation">
                    <starts-with>
                        <expression>\$\{</expression>
                        <capture number="0" name="boru.operator.interpolation" />
                    </starts-with>
                    <ends-with>
                        <expression>\}</expression>
                        <capture number="0" name="boru.operator.interpolation" />
                    </ends-with>
                    <subscopes include="self" />
                </scope>
            </subscopes>
        </scope>

        <!-- Double-quoted string. -->
        <scope name="boru.string.quoted.double">
            <starts-with>
                <expression>"</expression>
            </starts-with>
            <ends-with>
                <expression>"</expression>
            </ends-with>
            <subscopes>
                <scope name="boru.string.escape">
                    <expression>\\(?:[nt\\'"`]|u[0-9A-Fa-f]{4})</expression>
                </scope>
            </subscopes>
        </scope>

        <!-- Single-quoted string. -->
        <scope name="boru.string.quoted.single">
            <starts-with>
                <expression>'</expression>
            </starts-with>
            <ends-with>
                <expression>'</expression>
            </ends-with>
            <subscopes>
                <scope name="boru.string.escape">
                    <expression>\\(?:[nt\\'"`]|u[0-9A-Fa-f]{4})</expression>
                </scope>
            </subscopes>
        </scope>

        <!-- ================= Numbers ================= -->
        <!-- Hexadecimal -->
        <scope name="boru.value.number.hex">
            <expression>-?\b0x[0-9A-Fa-f_]+\b</expression>
        </scope>
        <!-- Binary -->
        <scope name="boru.value.number.binary">
            <expression>-?\b0b[01_]+\b</expression>
        </scope>
        <!-- Big integer literal -->
        <scope name="boru.value.number.big">
            <expression>-?\b0d[0-9]+\b</expression>
        </scope>
        <!-- Float: decimal point form and exponent-only form -->
        <scope name="boru.value.number.float">
            <expression>-?\b[0-9][0-9_]*(?:\.[0-9_]+(?:[eE][+-]?[0-9]+)?|[eE][+-]?[0-9]+)\b</expression>
        </scope>
        <!-- Decimal integer -->
        <scope name="boru.value.number.integer">
            <expression>-?\b[0-9][0-9_]*\b</expression>
        </scope>

        <!-- ================= Constants ================= -->
        <scope name="boru.value.language">
            <strings>
                <string>true</string>
                <string>false</string>
                <string>none</string>
                <string>inf</string>
                <string>nan</string>
                <string>-inf</string>
                <string>-nan</string>
            </strings>
        </scope>

        <!-- ================= def target binding ================= -->
        <!-- `def Foo …` names a type (capitalised). -->
        <scope name="boru.definition.type">
            <expression>(\bdef\b)\s+([A-Z][A-Za-z0-9_-]*)</expression>
            <capture number="1" name="boru.keyword.declaration" />
            <capture number="2" name="boru.identifier.type" />
        </scope>
        <!-- `def foo …` / `var foo` / `fn foo` names a value/function. -->
        <scope name="boru.definition.function">
            <expression>(\b(?:def|undef|var|fn|afn)\b)\s+([a-z_][A-Za-z0-9_-]*)</expression>
            <capture number="1" name="boru.keyword.declaration" />
            <capture number="2" name="boru.identifier.function.definition" />
        </scope>

        <!-- ================= Keywords ================= -->
        <scope name="boru.keyword">
            <strings prefix="\b" suffix="\b">
                <string>def</string>
                <string>undef</string>
                <string>var</string>
