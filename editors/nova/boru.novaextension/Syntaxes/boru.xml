                <string>select</string>
                <string>order</string>
                <string>group</string>
                <string>having</string>
                <string>join</string>
                <string>limit</string>
                <string>offset</string>
                <string>distinct</string>
                <string>union</string>
                <string>between</string>
                <string>in</string>
                <string>with-decimal</string>
                <string>with</string>
                <string>convert</string>
                <string>typeof</string>
                <string>inspect</string>
                <string>istype</string>
                <string>is</string>
                <string>of</string>
                <string>extends</string>
                <string>default</string>
                <string>const</string>
                <string>base</string>
                <string>behave</string>
                <string>pathof</string>
            </strings>
        </scope>

        <!-- ================= Builtins ================= -->
        <scope name="boru.identifier.function.builtin">
            <strings prefix="\b" suffix="\b">
                <string>add</string>
                <string>sub</string>
                <string>mul</string>
                <string>div</string>
                <string>mod</string>
                <string>pow</string>
