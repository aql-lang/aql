<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
    boru.plist — a BBEdit Codeless Language Module (CLM) for boru.

    boru (https://github.com/boru-lang/boru) is a concatenative, strongly-typed
    query language. Source files use the .boru extension.

    This CLM gives BBEdit syntax colouring, comment awareness, string/number
    recognition, and a function-navigation menu for .boru files WITHOUT any
    compiled plug-in. For richer features (diagnostics, hover, completion,
    whole-buffer formatting) enable BBEdit's built-in Language Server support
    and point it at `boru lsp` — see README.md in this directory.

    A CLM supports exactly ONE line-comment prefix and ONE block-comment
    pair. boru accepts both `#` and `//` for line comments; we register `#`
    here (the canonical prefix, per the lexical spec and the reference Emacs
    mode) and `/* ... */` for block comments. `//` line comments are still
    coloured as comments because they begin with the `/*`-family lead-in only
    when followed by `*`; a bare `//` line is left uncoloured by the CLM but
    remains valid boru — use the LSP for exhaustive comment handling.

    Install: drop this file into
      ~/Library/Application Support/BBEdit/Language Modules/
    then restart BBEdit (or use "Reload Language Modules" from the menu).

    Validate: plutil -lint boru.plist
-->
<plist version="1.0">
<dict>
	<!-- Display name shown in BBEdit's language pop-up. -->
	<key>BBLMLanguageDisplayName</key>
	<string>boru</string>

	<!-- Unique 4-character language code (OSType-style). -->
	<key>BBLMLanguageCode</key>
	<string>Boru</string>

	<!-- Colour .boru source using this module. -->
	<key>BBLMColorsSyntax</key>
	<true/>

	<!-- boru keywords are case-sensitive. -->
	<key>BBLMIsCaseSensitive</key>
	<true/>

	<!-- Map the .boru extension (and the plain name) to this language. -->
	<key>BBLMSuffixMap</key>
	<array>
		<dict>
			<key>BBLMLanguageSuffix</key>
			<string>.boru</string>
		</dict>
	</array>

	<!-- ============================================================= -->
	<!-- Comments                                                       -->
	<!-- ============================================================= -->

	<!-- Line comment prefix (used by Comment/Uncomment and colouring).
	     Both the modern and legacy keys are supplied so the CLM works
	     across BBEdit versions. -->
	<key>BBLMCommentLineDefault</key>
	<string>#</string>
	<key>BBLMLineComment</key>
	<string>#</string>

	<!-- Block comment delimiters: /* ... */ (not nestable). -->
	<key>BBLMCommentPrefixDefault</key>
	<string>/*</string>
	<key>BBLMCommentSuffixDefault</key>
	<string>*/</string>
	<key>BBLMCommentPrefix</key>
	<string>/*</string>
	<key>BBLMCommentSuffix</key>
	<string>*/</string>

	<!-- ============================================================= -->
	<!-- Strings                                                        -->
	<!-- ============================================================= -->
	<!-- boru has three string kinds: '...', "...", and `...` template   -->
	<!-- strings. All support backslash escapes, so declare the escape  -->
	<!-- character for each delimiter.                                  -->

	<key>BBLMStringStartChars</key>
	<string>&apos;&quot;`</string>

	<key>BBLMCanSpanLines</key>
	<true/>

	<key>Language Features</key>
	<dict>
		<!-- Line-comment lead-ins recognised while scanning. -->
		<key>Comment Line Prefix</key>
		<string>#</string>

		<!-- Block-comment delimiters (not nestable). -->
		<key>Comment Block Start</key>
		<string>/*</string>
		<key>Comment Block End</key>
		<string>*/</string>

		<!-- Nested-comment support off (boru block comments do not nest). -->
		<key>Comments Can Be Nested</key>
		<false/>

		<!-- String delimiters and their escape characters. -->
		<key>Open Line Comment</key>
		<string>#</string>

		<key>Skip Pattern</key>
		<string>(?x:
			# Whitespace
			\s+
		)</string>

		<!-- Single-quoted string. -->
		<key>String Delimiter</key>
		<string>&apos;</string>
		<key>String Delimiter2</key>
		<string>&quot;</string>
		<key>String Delimiter3</key>
		<string>`</string>

		<key>Escape Char</key>
		<string>\</string>
		<key>Escape Char in Strings</key>
		<true/>

		<!-- Identifier character set: boru words are
		     [A-Za-z][A-Za-z0-9_-]* — hyphens are internal. -->
		<key>Identifier and Keyword Characters</key>
		<string>abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-</string>
	</dict>

	<!-- ============================================================= -->
	<!-- Function / "def" navigation (the function pop-up menu).        -->
	<!-- ============================================================= -->
	<!-- Match `def name ...` and `fn name ...`-style declarations so    -->
	<!-- they appear in BBEdit's function menu. The capture named        -->
	<!-- `function_name` becomes the menu label; `leadspace`/`function`  -->
	<!-- delimit the selectable range.                                   -->

	<key>BBLMScansFunctions</key>
	<true/>

	<key>Function Pattern</key>
	<string>(?x:
		(?P&lt;function&gt;
			(?P&lt;leadspace&gt;^[ \t]*)
			\b(?:def|fn|afn|class|surface|gen|module|export|macro|word|var)\b
			[ \t]+
			(?P&lt;function_name&gt;[A-Za-z][A-Za-z0-9_-]*)
		)
	)</string>

