# App-level throughput probe: todo-api (HTTP GET round-trips over the service +
# boru:net http codec). Run compiled vs -no-compile to compare. See ../README.md.
# Run from the repo root: cmd/go/bin/boru run -no-check -install network bench/networking/apps/echo_todo.boru
import "./design/examples/apps/todo-api.boru"
import "boru:net"
import "boru:time-util"
def ln (TodoApi.serve {port:0})
def port (Net.addr ln).port
def ep
(Net.connect
      {tcp:(join "" ["127.0.0.1:" (convert String port)])
        codec:Net.http
      }
  )
call
{method:"POST"
    path:"/todos"
    headers:{content-type:"application/json"}
    body:"{\"text\": \"x\"}"
  }
ep {timeout:5000} drop
def start (TimeUtil.now)
for 5000 [call {method:"GET" path:"/todos"} ep {timeout:5000} drop]
def dur (TimeUtil.total-ms (TimeUtil.elapsed start))
print
(join ""
      ["todo-api 5000 GET  " (convert String dur) " ms  "
          (convert String (div dur 5000000.0)) " req/s"
      ]
  )
