# Control: same per-iteration work (Bytes build + convert) but NO network,
# to isolate interpreter/loop overhead from socket round-trip cost.
import "boru:time-util"
def msg (convert Bytes "hello world\n")
def start (TimeUtil.now)
for 20000 [def line (convert Bytes (join "" [(convert String msg) ""]))]
def dur (TimeUtil.total-ms (TimeUtil.elapsed start))
print
(join "" ["boru loop-only 20000 iters  " (convert String dur) " ms"])
