# schema.boru — the approved boru-kg/1 graph schema.
#
# One module owns the vocabulary and the typed shapes. Everything
# downstream builds graph values ONLY through the mk-* constructors here,
# so a structurally malformed object fails loudly at construction (make
# enforces every field name and type), never at serialization time.
# Business rules that depend on the WHOLE bundle (dangling references,
# unsupported assertions, …) live in validate.boru and are reported as
# issue records rather than raised.
#
# The vocabulary is CLOSED: new entity types, predicates, or datatypes
# are never added silently — propose them with mk-proposal and ship the
# proposal in the bundle's schema_proposals list (status requires_approval).

import "boru:struct-util"

# ---- approved vocabularies ---------------------------------------------

# SoftwareModule was approved on 2026-08-07, discharging the standing
# proposal in main.boru ("Repository modules are currently typed Product,
# which blurs shipped artifacts and source-tree modules"). It names a
# buildable code unit — a Go module or one of its packages — and is
# reserved for units the CODE bundle can evidence from go.work / go.mod
# (kg/gomod.boru). Shipped artifacts (the boru binary), plain source
# directories (lang/spec) and boru-level modules stay Product.
def entity-types [
  "Person" "Organization" "Place" "Event" "Document" "Product"
    "Concept" "Role" "Identifier" "SoftwareModule" "Other"
]

# depends_on is DIRECTED: subject depends on object. It replaced
# related_to for module edges, which could not distinguish "eng builds on
# core" from "core builds on eng" — the single most-asked fact about this
# repository was the one the graph could not answer.
def predicates [
  "type" "same_as" "part_of" "located_in" "member_of" "works_for"
    "owns" "created_by" "participated_in" "has_role" "occurred_at"
    "mentions" "supports" "contradicts" "supersedes" "related_to"
    "depends_on" "has_attribute"
]

# Predicates treated as single-valued per subject: two accepted
# assertions on one subject with different objects CONFLICT (they are
# preserved and marked disputed — see assertions.boru, never discarded).
def single-valued-predicates [
  "type" "located_in" "works_for" "occurred_at"
]

def datatypes [
  "String" "Integer" "Float" "Boolean" "Date" "DateTime" "URI" "JSON"
]

def source-kinds ["json" "jsonic" "csv" "tsv" "text" "api"]

def authorities ["primary" "official" "secondary" "unknown"]

def entity-statuses ["accepted" "candidate" "merged" "rejected"]

def assertion-statuses [
  "asserted" "inferred" "estimated" "disputed" "superseded" "unresolved"
]

def identity-decisions [
  "same_entity" "possible_match" "different_entity"
    "insufficient_evidence"
]

def issue-severities ["error" "warning" "info"]

def extraction-methods ["direct_record" "rule" "model" "manual"]

def proposal-term-kinds ["entity_type" "predicate" "datatype"]

# Membership in a closed vocabulary.
def term-approved fn [[v:Any allowed:List] [Boolean] [
  ((filter [eq v] allowed) size) gt 0
]]

# ---- typed records ------------------------------------------------------

def KgSource refine Record [
  id:String kind:String locator:String title:String retrieved_at:(String tor none)
    content_hash:String authority:String metadata:Map
]

def KgEntity refine Record [
  id:String type:String label:String normalized_label:String aliases:[:String]
    external_ids:Map attributes:Map status:String
]

def KgEvidence refine Record [
  source_id:String locator:String quote:(String tor none)
    extraction_method:String extractor:String
]

# An assertion object is exactly one of two forms; each form has its own
# record so the shapes cannot blur. kind is the discriminator.
def KgEntityRef refine Record [kind:String entity_id:String]

def KgLiteral refine Record [
  kind:String value:(String tor Number tor Boolean tor Map tor List)
    datatype:String unit:(String tor none) language:(String tor none)
]

def KgAssertion refine Record [
  id:String subject_id:String predicate:String object:Map evidence:[:Map]
    confidence:Number status:String valid_from:(String tor none)
    valid_to:(String tor none) recorded_at:String rule:(String tor none)
]

def KgIdentity refine Record [
  id:String left_entity_id:String right_entity_id:String decision:String
    supporting_evidence:[:Map] conflicting_evidence:[:Map] confidence:Number
    review_required:Boolean
]

def KgIssue refine Record [
  id:String severity:String rule:String target_kind:String target_id:String
    message:String suggested_correction:(String tor none)
    automatic_correction_safe:Boolean
]

def KgProposal refine Record [
  id:String term_kind:String term:String definition:String domain:[:String]
    range:[:String] examples:List reason:String possible_equivalents:[:String]
    status:String
]

# ---- checked constructors ----------------------------------------------
# Each constructor takes a spec Map and returns the record instance; make
# raises on a missing field, an unknown field, or a type mismatch.

def mk-source fn spec:Map Map [make KgSource spec]
def mk-entity fn spec:Map Map [make KgEntity spec]
def mk-evidence fn spec:Map Map [make KgEvidence spec]
def mk-assertion fn spec:Map Map [make KgAssertion spec]
def mk-identity fn spec:Map Map [make KgIdentity spec]
def mk-issue fn spec:Map Map [make KgIssue spec]

def mk-proposal fn spec:Map Map [
  make KgProposal (spec set status "requires_approval")
]

# Object constructors — the only two legal object forms.
def mk-entity-ref fn entity_id:String Map [
  make KgEntityRef {kind:"entity" entity_id:entity_id}
]

def mk-literal fn spec:Map Map [
  make KgLiteral
    (StructUtil.merge {kind:"literal" unit:none language:none} spec)
]

# Object-shape predicates used across resolve/validate/queries.
def is-entity-ref fn object:Map Boolean [
  (object.kind eq "entity") and
    ((object has entity_id) and (not (object has value)))
]

def is-literal fn object:Map Boolean [
  (object.kind eq "literal") and
    ((object has value) and (not (object has entity_id)))
]

export "KgSchema" {
  entity-types:entity-types
  predicates:predicates
  single-valued-predicates:single-valued-predicates
  datatypes:datatypes
  source-kinds:source-kinds
  authorities:authorities
  entity-statuses:entity-statuses
  assertion-statuses:assertion-statuses
  identity-decisions:identity-decisions
  issue-severities:issue-severities
  extraction-methods:extraction-methods
  proposal-term-kinds:proposal-term-kinds
  term-approved:term-approved/r
  KgSource:KgSource
  KgEntity:KgEntity
  KgEvidence:KgEvidence
  KgEntityRef:KgEntityRef
  KgLiteral:KgLiteral
  KgAssertion:KgAssertion
  KgIdentity:KgIdentity
  KgIssue:KgIssue
  KgProposal:KgProposal
  mk-source:mk-source/r
  mk-entity:mk-entity/r
  mk-evidence:mk-evidence/r
  mk-assertion:mk-assertion/r
  mk-identity:mk-identity/r
  mk-issue:mk-issue/r
  mk-proposal:mk-proposal/r
  mk-entity-ref:mk-entity-ref/r
  mk-literal:mk-literal/r
  is-entity-ref:is-entity-ref/r
  is-literal:is-literal/r
}
